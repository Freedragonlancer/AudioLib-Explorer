{
  "schema_version": 1,
  "name": "windows-local",
  "host": "windows",
  "require_tag": false,
  "environment_tools": ["rustc", "cargo"],
  "variables": {"WithoutAsio": false, "InstallDestination": "${Root}/local_release", "VersionManifest": "${Root}/Cargo.toml"},
  "stages": [
    {"id": "license-preflight", "reuse": "never", "script": "tools/check-release-licenses.ps1", "parameters": {"Profile": "WindowsClient", "WithoutAsio": "${WithoutAsio}"}},
    {"id": "build", "needs": ["license-preflight"], "script": "tools/build-release.ps1", "parameters": {"WithoutAsio": "${WithoutAsio}"}, "outputs": ["${TargetDirectory}/x86_64-pc-windows-msvc/release/AudioLibExplorer.exe", "${TargetDirectory}/x86_64-pc-windows-msvc/release/AudioLibCli.exe"]},
    {"id": "package", "needs": ["build"], "script": "tools/package-portable.ps1", "parameters": {"Tag": "${Tag}", "SkipBuild": true, "SkipArchive": true, "WithoutAsio": "${WithoutAsio}"}, "outputs": ["dist/latest/portable"]},
    {"id": "accept", "needs": ["package"], "script": "tools/validate-portable.ps1", "parameters": {"BinaryDirectory": "dist/latest/portable", "WithoutAsio": "${WithoutAsio}"}},
    {"id": "install", "needs": ["accept", "package"], "script": "tools/install-local-release.ps1", "parameters": {"Source": "dist/latest/portable", "Destination": "${InstallDestination}", "VersionManifest": "${VersionManifest}"}, "input_files": ["${VersionManifest}"], "outputs": ["${InstallDestination}"]}
  ]
}

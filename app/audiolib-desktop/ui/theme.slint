// app/audiolib-desktop/ui/theme.slint
import { Slider, CheckBox, LineEdit } from "std-widgets.slint";

// Smoke-grey surfaces, teal interaction accents and restrained warm playback tones.
export global Theme {
    // GUI scale factor (PR1: stays 1.0; nothing reads or writes it from Rust yet).
    // Literal lengths are written as `Npx * Theme.ui-scale`. 0px and 1px hairlines
    // (borders, separators, `/ 1px` unit conversions) stay unscaled.
    in-out property <float> ui-scale: 1.0;
    // Font size settings in whole pixels (10-24, set from Rust). 13 is the reference size
    // at which every design size below is used unchanged, so the defaults keep the look.
    in-out property <int> ui-font-px: 13;
    // Result list rows only (Appearance > List font size).
    in-out property <int> list-font-px: 13;
    // Interface text: design size `n` px adjusted by the interface font setting and the
    // UI scale, rounded to whole pixels.
    public pure function font(n: float) -> length {
        return round(n * Theme.ui-scale * Theme.ui-font-px / 13) * 1px;
    }
    // Result list row text: design size `n` px adjusted by the list font setting.
    public pure function list-font(n: float) -> length {
        return round(n * Theme.ui-scale * Theme.list-font-px / 13) * 1px;
    }
    // List rows grow with a larger list font and never shrink below the design height.
    out property <float> list-row-factor: max(1.0, Theme.list-font-px / 13);
    // Window default text size (was `default-font-size: 12px`).
    out property <length> ui-font-size: Theme.font(12);
    // Result list file-name cell (was `font-size: 12px`).
    out property <length> list-font-size: Theme.list-font(14);
    // Palette tokens. The values here are the default theme; Rust (src/theme.rs) sets
    // them from the selected theme at startup and when the Theme setting changes.
    in-out property <color> bg: #202226;
    in-out property <color> panel: #24272b;
    in-out property <color> raised: #393c43;
    in-out property <color> hover: #34383e;
    in-out property <color> border: #383c43;
    in-out property <color> strong-border: #626873;
    in-out property <color> ink: #ecebe7;
    in-out property <color> dim: #adb0b7;
    in-out property <color> muted: #858b94;
    in-out property <color> accent: #2bbfbd;
    in-out property <color> accent-hover: #66d2c9;
    in-out property <color> mint: #79d5bc;
    in-out property <color> apricot: #efc4a5;
    in-out property <color> coral: #ea8b75;
    in-out property <color> on-accent: #102a2a;
    in-out property <color> selected: #293e40;
    in-out property <color> checked: #303c3e;
    in-out property <color> alternate: #272a2f;
    in-out property <color> warning: #d6ba98;
    // Segmented switches (page tabs, panel toggles): a recessed track below `panel` and
    // a raised surface for the selected segment, so switches never read as buttons.
    in-out property <color> trough: #1e2024;
    in-out property <color> segment: #3b4148;
    // Exclusion marks (excluded filter tags): restrained like `accent`, readable on `panel`.
    in-out property <color> danger: #df9e98;
    in-out property <color> danger-surface: #403033;
    in-out property <color> player: #292c31;
    in-out property <color> player-border: #41454c;
    in-out property <color> tooltip: #191b1f;
    in-out property <color> overlay: #000000a8;
    // Localised warm-grey shading follows the reference's dark, nearly flat
    // surfaces. Small vector gradients scale with each pane without lighting text.
    out property <image> toolbar-backdrop: @image-url("surfaces/toolbar.svg");
    out property <image> rail-backdrop: @image-url("surfaces/rail.svg");
    out property <image> library-backdrop: @image-url("surfaces/library.svg");
    out property <image> inspector-backdrop: @image-url("surfaces/inspector.svg");
    out property <image> player-backdrop: @image-url("surfaces/player.svg");
    out property <image> transport-backdrop: @image-url("surfaces/transport.svg");
    out property <image> tab-indicator: @image-url("surfaces/tab-indicator.svg");
    out property <color> toolbar-surface: #28282a;
    out property <color> rail-surface: #2a2b2e;
    out property <color> library-surface: #202224;
    out property <color> inspector-surface: #202224;
    out property <color> player-surface: #202225;
    out property <color> table-surface: #1d1f21;
    out property <color> table-alternate: #1f2123;
    out property <brush> control-surface: @linear-gradient(180deg, #2e3033 0%, #25272a 100%);
    out property <brush> control-hover-surface: @linear-gradient(180deg, #373a3d 0%, #2c3033 100%);
    out property <brush> table-header-surface: @linear-gradient(180deg, #26282a 0%, #212325 100%);
    out property <brush> table-toolbar-surface: @linear-gradient(180deg, #26282a 0%, #202224 100%);
    out property <brush> table-footer-surface: @linear-gradient(180deg, #202224 0%, #202224 100%);
    out property <brush> tab-surface: @linear-gradient(180deg, #343537 0%, #272a2c 100%);
    // The spectral canvas and frequency colours are audio data. The neutral mask uses the panel surface.
    out property <color> spectral-canvas: #849094;
    out property <color> normal-canvas: transparent;
    // Motion. Transitions stay short and ease out; nothing bounces or travels far.
    // `motion` scales every duration below: 1 keeps the designed timing, 0 turns
    // transitions off (state changes then apply immediately).
    in-out property <float> motion: 1.0;
    // Hover, press and small color changes.
    out property <duration> motion-fast: 90ms * Theme.motion;
    // Icon swaps, fades and most state changes.
    out property <duration> motion-base: 150ms * Theme.motion;
    // Larger fades (waveform arrival, end of playback).
    out property <duration> motion-slow: 240ms * Theme.motion;
    // Tooltips appear after the pointer rests for this long; not scaled by `motion`.
    out property <duration> tooltip-delay: 450ms;
}

// Keep the standard input, keyboard and accessibility behavior; paint its accent
// locally so Windows' system accent cannot compete with frequency colors.
export component ThemedSlider inherits Rectangle {
    in property <float> minimum <=> native.minimum;
    in property <float> maximum <=> native.maximum;
    in property <float> step <=> native.step;
    in property <bool> enabled <=> native.enabled;
    in-out property <float> value <=> native.value;
    out property <bool> has-focus: native.has-focus;
    callback changed <=> native.changed;
    callback released <=> native.released;
    forward-focus: native;
    min-height: 20px * Theme.ui-scale; min-width: 20px * Theme.ui-scale;
    horizontal-stretch: 1; vertical-stretch: 0;
    in property <color> surface: Theme.player;
    native := Slider { width: parent.width; height: parent.height; }
    Rectangle { background: root.surface; }
    property <float> fraction: clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
    Rectangle {
        x: 10px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        width: parent.width - 20px * Theme.ui-scale; height: 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale;
        background: Theme.strong-border;
        opacity: root.enabled ? 0.65 : 0.3;
        Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.fraction; background: Theme.accent; border-radius: 2px * Theme.ui-scale; }
    }
    Rectangle {
        x: (parent.width - 20px * Theme.ui-scale) * root.fraction; y: (parent.height - self.height) / 2;
        width: 20px * Theme.ui-scale; height: 20px * Theme.ui-scale; border-radius: 10px * Theme.ui-scale;
        background: Theme.raised; border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.strong-border;
        opacity: root.enabled ? 1 : 0.45;
        Rectangle { x: 4px * Theme.ui-scale; y: 4px * Theme.ui-scale; width: 12px * Theme.ui-scale; height: 12px * Theme.ui-scale; border-radius: 6px * Theme.ui-scale; background: Theme.accent; }
    }
    // Paint-only rectangles do not intercept the standard pointer/key/accessibility owner.
}

export component ThemedCheckBox inherits Rectangle {
    in property <string> text <=> native.text;
    in property <bool> enabled <=> native.enabled;
    in-out property <bool> checked <=> native.checked;
    out property <bool> has-focus: native.has-focus;
    callback toggled <=> native.toggled;
    forward-focus: native;
    in property <color> surface: Theme.panel;
    HorizontalLayout { padding: 0px; native := CheckBox { } }
    Rectangle { background: root.surface; }
    if root.text != "": Text {
        x: 30px * Theme.ui-scale; width: parent.width - self.x; height: parent.height;
        text: root.text; color: Theme.ink; vertical-alignment: center;
        opacity: root.enabled ? 1 : 0.45;
    }
    Rectangle {
        x: 0px; width: 18px * Theme.ui-scale; height: 18px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        border-radius: 3px * Theme.ui-scale; border-width: 1px;
        background: root.checked ? Theme.accent : Theme.panel;
        border-color: root.has-focus ? Theme.ink : (root.checked ? Theme.accent : Theme.strong-border);
        opacity: root.enabled ? 1 : 0.45;
        // Use explicit vector geometry: a font-dependent glyph may be absent
        // from the selected UI font and leave checked items as blank squares.
        if root.checked: Image {
            source: @image-url("icons/check.svg"); colorize: Theme.on-accent;
            x: 3px * Theme.ui-scale; y: 3px * Theme.ui-scale; width: 12px * Theme.ui-scale; height: 12px * Theme.ui-scale;
            image-fit: contain; accessible-role: none;
        }
    }
}

export component ThemedLineEdit inherits Rectangle {
    in property <string> input-label;
    in property <bool> enabled <=> native.enabled;
    in property <string> placeholder-text <=> native.placeholder-text;
    in property <InputType> input-type <=> native.input-type;
    in-out property <string> text <=> native.text;
    out property <bool> has-focus: native.has-focus;
    callback accepted <=> native.accepted;
    callback edited <=> native.edited;
    forward-focus: native;
    horizontal-stretch: 1; vertical-stretch: 0; min-width: 160px * Theme.ui-scale;
    HorizontalLayout { padding: 0px; native := LineEdit { min-width: 0px; accessible-label: root.input-label; } }
    if root.has-focus && root.enabled: Rectangle {
        x: 4px * Theme.ui-scale; y: parent.height - 2px * Theme.ui-scale; height: 2px * Theme.ui-scale; width: parent.width - 8px * Theme.ui-scale;
        background: Theme.accent;
    }
}

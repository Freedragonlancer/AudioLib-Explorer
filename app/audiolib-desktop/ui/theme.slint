// app/audiolib-desktop/ui/theme.slint
import { Slider, CheckBox, LineEdit } from "std-widgets.slint";

// Soft charcoal surfaces and restrained gray-teal actions keep spectral peaks readable.
export global Theme {
    in-out property <string> font-family;
    // Transparent slots inherit the matching General role, then the original theme color.
    in-out property <[color]> text-colors;
    public pure function text(module: int, state: int, fallback: color) -> color {
        let index = module * 15 + state;
        if state >= 0 && state < 15 && index >= 0 && index < Theme.text-colors.length && Theme.text-colors[index].alpha > 0 { return Theme.text-colors[index]; }
        if state >= 0 && state < Theme.text-colors.length && Theme.text-colors[state].alpha > 0 { return Theme.text-colors[state]; }
        return fallback;
    }
    public pure function role-default(state: int) -> color {
        if state == 1 { return Theme.dim; }
        if state == 2 || state == 3 { return Theme.muted; }
        if state == 4 || state == 14 { return Theme.accent-hover; }
        if state == 5 || state == 6 || state == 11 { return Theme.accent; }
        if state == 7 { return Theme.mint; }
        if state == 8 || state == 12 || state == 13 { return Theme.warning; }
        if state == 9 { return Theme.danger; }
        if state == 10 { return Theme.on-accent; }
        return Theme.ink;
    }
    // Workbench and player can be selected independently: Default v2 uses the
    // Studio workbench with the original beta player.
    in-out property <bool> modern-style: false;
    in-out property <bool> modern-player: false;
    // Studio keeps its warm surface artwork; Default v2 blends it into graphite.
    out property <float> workbench-backdrop-opacity: Theme.modern-player ? 1.0 : 0.22;
    // GUI scale factor selected by the interface Appearance setting.
    // Literal lengths are written as `Npx * Theme.ui-scale`. 0px and 1px hairlines
    // (borders, separators, `/ 1px` unit conversions) stay unscaled.
    in-out property <float> ui-scale: 1.0;
    // Font size settings in whole pixels (10-24, set from Rust). 13 is the reference size
    // at which every design size below is used unchanged, so the defaults keep the look.
    in-out property <int> ui-font-px: 13;
    // Result list rows only (Appearance > List font size).
    in-out property <int> list-font-px: 13;
    // Interface text: design size `n` px adjusted by the interface font setting and the
    // UI scale, rounded to whole pixels.
    public pure function font(n: float) -> length {
        return round(n * Theme.ui-scale * Theme.ui-font-px / 13) * 1px;
    }
    // Result list row text: design size `n` px adjusted by the list font setting.
    public pure function list-font(n: float) -> length {
        return round(n * Theme.ui-scale * Theme.list-font-px / 13) * 1px;
    }
    // List rows grow with a larger list font and never shrink below the design height.
    out property <float> list-row-factor: max(1.0, Theme.list-font-px / 13);
    // Window default text size (was `default-font-size: 12px`).
    out property <length> ui-font-size: Theme.font(12);
    // Result list file-name cell (was `font-size: 12px`).
    out property <length> list-font-size: Theme.list-font(Theme.modern-style ? 14 : 12);
    // Palette tokens. The values here are the default theme; Rust (src/theme.rs) sets
    // them from the selected theme at startup and when the Theme setting changes.
    in-out property <color> bg: #181b20;
    in-out property <color> panel: #20242a;
    in-out property <color> raised: #2a3037;
    in-out property <color> hover: #353d45;
    in-out property <color> border: #353d45;
    in-out property <color> strong-border: #697581;
    in-out property <color> ink: #d9dee3;
    in-out property <color> dim: #aab2bd;
    in-out property <color> muted: #95a0ac;
    in-out property <color> accent: #8faea6;
    in-out property <color> accent-hover: #a8c3bb;
    // Additional Studio accents; the classic defaults alias existing palette tones.
    in-out property <color> mint: #8faea6;
    in-out property <color> apricot: #c3b48e;
    in-out property <color> coral: #cf9696;
    in-out property <color> on-accent: #202b28;
    in-out property <color> selected: #2b3a38;
    in-out property <color> checked: #354744;
    in-out property <color> alternate: #22282e;
    in-out property <color> warning: #c3b48e;
    // Segmented switches (page tabs, panel toggles): a recessed track below `panel` and
    // a raised surface for the selected segment, so switches never read as buttons.
    in-out property <color> trough: #15181c;
    in-out property <color> segment: #3a434c;
    // Exclusion marks (excluded filter tags): restrained like `accent`, readable on `panel`.
    in-out property <color> danger: #cf9696;
    in-out property <color> danger-surface: #3a2a2d;
    in-out property <color> player: #232a30;
    in-out property <color> player-border: #465059;
    in-out property <color> tooltip: #14171c;
    in-out property <color> overlay: #000000a8;
    // Studio's PR #185 surface resources are inert for the default theme.
    // Keeping a default image value avoids painting any backdrop in classic views.
    out property <image> empty-backdrop;
    // The surfaces (ui/surfaces/*.svg) as bitmaps, rasterized once by theme.rs.
    // Given as SVG, the software renderer rasterizes a whole surface again on
    // every repaint that touches it, e.g. each playback frame under the player.
    in-out property <image> studio-toolbar;
    in-out property <image> studio-rail;
    in-out property <image> studio-library;
    in-out property <image> studio-inspector;
    in-out property <image> studio-player;
    in-out property <image> studio-transport;
    in-out property <image> studio-tab-indicator;
    out property <image> toolbar-backdrop: Theme.modern-style ? Theme.studio-toolbar : Theme.empty-backdrop;
    out property <image> rail-backdrop: Theme.modern-style ? Theme.studio-rail : Theme.empty-backdrop;
    out property <image> library-backdrop: Theme.modern-style ? Theme.studio-library : Theme.empty-backdrop;
    out property <image> inspector-backdrop: Theme.modern-style ? Theme.studio-inspector : Theme.empty-backdrop;
    out property <image> player-backdrop: Theme.modern-player ? Theme.studio-player : Theme.empty-backdrop;
    out property <image> transport-backdrop: Theme.modern-player ? Theme.studio-transport : Theme.empty-backdrop;
    out property <image> tab-indicator: Theme.modern-style ? Theme.studio-tab-indicator : Theme.empty-backdrop;
    out property <color> toolbar-surface: Theme.modern-player ? #28282a : Theme.bg;
    out property <color> rail-surface: Theme.modern-player ? #2a2b2e : Theme.panel;
    out property <color> library-surface: Theme.modern-player ? #202224 : Theme.panel;
    out property <color> inspector-surface: Theme.modern-player ? #202224 : Theme.panel;
    out property <color> player-surface: Theme.modern-player ? #202225 : Theme.player;
    out property <color> table-surface: Theme.modern-player ? #1d1f21 : Theme.panel;
    out property <color> table-alternate: Theme.modern-player ? #1f2123 : Theme.alternate;
    out property <brush> control-surface: Theme.modern-player ? @linear-gradient(180deg, #2e3033 0%, #25272a 100%) : Theme.raised;
    out property <brush> control-hover-surface: Theme.modern-player ? @linear-gradient(180deg, #373a3d 0%, #2c3033 100%) : Theme.hover;
    out property <brush> table-header-surface: Theme.modern-player ? @linear-gradient(180deg, #26282a 0%, #212325 100%) : Theme.raised;
    out property <brush> table-toolbar-surface: Theme.modern-player ? @linear-gradient(180deg, #26282a 0%, #202224 100%) : Theme.panel;
    out property <brush> table-footer-surface: Theme.modern-player ? @linear-gradient(180deg, #202224 0%, #202224 100%) : Theme.panel;
    out property <brush> tab-surface: Theme.modern-player ? @linear-gradient(180deg, #343537 0%, #272a2c 100%) : Theme.panel;
    // Not themeable. Matches the pixel renderer. Frequency hues and noise-to-black are audio data.
    out property <color> spectral-canvas: #849094;
    out property <color> normal-canvas: Theme.modern-player ? transparent : #1d2328;
    // Motion. Transitions stay short and ease out; nothing bounces or travels far.
    // `motion` scales every duration below: 1 keeps the designed timing, 0 turns
    // transitions off (state changes then apply immediately).
    in-out property <float> motion: 1.0;
    // Hover, press and small color changes.
    out property <duration> motion-fast: 90ms * Theme.motion;
    // Icon swaps, fades and most state changes.
    out property <duration> motion-base: 150ms * Theme.motion;
    // Larger fades (waveform arrival, end of playback).
    out property <duration> motion-slow: 240ms * Theme.motion;
    // Tooltips appear after the pointer rests for this long; not scaled by `motion`.
    out property <duration> tooltip-delay: 450ms;
}

// Keep the standard input, keyboard and accessibility behavior; paint its accent
// locally so Windows' system accent cannot compete with frequency colors.
export component ThemedSlider inherits Rectangle {
    in property <string> input-label;
    in property <float> minimum <=> native.minimum;
    in property <float> maximum <=> native.maximum;
    in property <float> step <=> native.step;
    in property <bool> enabled <=> native.enabled;
    in-out property <float> value <=> native.value;
    out property <bool> has-focus: native.has-focus;
    callback changed <=> native.changed;
    callback released <=> native.released;
    forward-focus: native;
    min-height: 20px * Theme.ui-scale; min-width: 20px * Theme.ui-scale;
    horizontal-stretch: 1; vertical-stretch: 0;
    in property <color> surface: Theme.player;
    // Fluent's standard Slider owns input with a fixed 20px thumb. Keep the
    // painted thumb and its travel identical: a larger painted thumb would make
    // its edges act as track clicks and jump the value before a drag begins.
    private property <length> thumb-size: 20px;
    // Slint's native accessibility actions call SliderBase setters directly,
    // bypassing its pointer/key enabled checks. Guard before mutating bound state.
    function accessible-set-value(value: float) {
        if !root.enabled { return; }
        let next = clamp(value, root.minimum, root.maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }
    native := Slider {
        width: parent.width; height: parent.height; accessible-label: root.input-label;
        accessible-action-set-value(v) => { if v.is-float() { root.accessible-set-value(v.to-float()); } }
        accessible-action-increment => { root.accessible-set-value(root.value + root.step); }
        accessible-action-decrement => { root.accessible-set-value(root.value - root.step); }
    }
    Rectangle { background: root.surface; }
    property <float> fraction: clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
    Rectangle {
        x: root.thumb-size / 2; y: (parent.height - self.height) / 2;
        width: parent.width - root.thumb-size; height: 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale;
        background: Theme.strong-border;
        opacity: root.enabled ? 0.65 : 0.3;
        Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.fraction; background: Theme.accent; border-radius: 2px * Theme.ui-scale; }
    }
    thumb := Rectangle {
        x: (parent.width - root.thumb-size) * root.fraction; y: (parent.height - self.height) / 2;
        width: root.thumb-size; height: root.thumb-size; border-radius: root.thumb-size / 2;
        background: Theme.raised; border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.strong-border;
        opacity: root.enabled ? 1 : 0.45;
        Rectangle { x: 4px; y: 4px; width: 12px; height: 12px; border-radius: 6px; background: Theme.accent; }
    }
    // Paint-only rectangles do not intercept the standard pointer/key/accessibility owner.
}

export component ThemedCheckBox inherits Rectangle {
    in property <int> text-module: 0;
    in property <string> text <=> native.text;
    in property <bool> enabled <=> native.enabled;
    in-out property <bool> checked <=> native.checked;
    out property <bool> has-focus: native.has-focus;
    callback toggled <=> native.toggled;
    forward-focus: native;
    in property <color> surface: Theme.panel;
    // The painted layout owns the scaled geometry. Fluent's native checkbox uses
    // an unscaled 18px indicator and 12px gap, so using its implicit layout here
    // would under-allocate both dimensions when the interface is enlarged.
    native := CheckBox { width: parent.width; height: parent.height; }
    Rectangle { background: root.surface; }
    HorizontalLayout {
        padding: 0px; spacing: 12px * Theme.ui-scale;
        Rectangle {
            width: 18px * Theme.ui-scale; height: 18px * Theme.ui-scale; y: (parent.height - self.height) / 2;
            border-radius: 3px * Theme.ui-scale; border-width: 1px;
            background: root.checked ? Theme.accent : Theme.panel;
            border-color: root.has-focus ? Theme.ink : (root.checked ? Theme.accent : Theme.strong-border);
            opacity: root.enabled ? 1 : 0.45;
            // Use explicit vector geometry: a font-dependent glyph may be absent
            // from the selected UI font and leave checked items as blank squares.
            if root.checked: Image {
                source: @image-url("icons/check.svg"); colorize: Theme.on-accent;
                x: 3px * Theme.ui-scale; y: 3px * Theme.ui-scale; width: 12px * Theme.ui-scale; height: 12px * Theme.ui-scale;
                image-fit: contain; accessible-role: none;
            }
        }
        if root.text != "": Text {
            text: root.text; color: Theme.text(root.text-module, root.enabled ? 0 : 3, Theme.ink); vertical-alignment: center;
            opacity: root.enabled ? 1 : 0.45;
        }
    }
}

export component ThemedLineEdit inherits Rectangle {
    in property <int> text-module: 0;
    in property <string> input-label;
    in property <bool> enabled <=> native.enabled;
    in property <string> placeholder-text <=> native.placeholder-text;
    in property <InputType> input-type <=> native.input-type;
    in-out property <string> text <=> native.text;
    out property <bool> has-focus: native.has-focus;
    callback accepted <=> native.accepted;
    callback edited <=> native.edited;
    forward-focus: native;
    horizontal-stretch: 1; vertical-stretch: 0; min-width: 160px * Theme.ui-scale;
    HorizontalLayout { padding: 0px; native := LineEdit { min-width: 0px; accessible-label: root.input-label; } }
    if root.has-focus && root.enabled: Rectangle {
        x: 4px * Theme.ui-scale; y: parent.height - 2px * Theme.ui-scale; height: 2px * Theme.ui-scale; width: parent.width - 8px * Theme.ui-scale;
        background: Theme.accent;
    }
}

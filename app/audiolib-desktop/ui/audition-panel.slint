// app/audiolib-desktop/ui/audition-panel.slint
import { ComboBox } from "std-widgets.slint";
import { Theme, ThemedSlider as Slider, ThemedLineEdit as LineEdit } from "theme.slint";

/// One time-ruler tick: its position as a fraction of the visible range and, on
/// major ticks, the time label drawn beside it.
export struct RulerTick { fraction: float, label: string, major: bool }

// Text formats shared by the hover, scrub and remaining-time readouts.
global Clock {
    public pure function pad2(value: int) -> string { return value < 10 ? "0" + value : "" + value; }
    public pure function pad3(value: int) -> string { return value < 10 ? "00" + value : (value < 100 ? "0" + value : "" + value); }
    // mm:ss.mmm, the transport clock format published by the controller.
    public pure function format(seconds: float) -> string {
        let ms = floor(max(0, seconds) * 1000);
        return Clock.pad2(floor(ms / 60000)) + ":" + Clock.pad2(Math.mod(floor(ms / 1000), 60)) + "." + Clock.pad3(Math.mod(ms, 1000));
    }
    // Two fixed decimals, the Pitch / Rate field format published by the controller.
    public pure function fixed2(value: float) -> string {
        let hundredths = Math.round(abs(value) * 100);
        let part = Math.mod(hundredths, 100);
        return (value < 0 && hundredths > 0 ? "-" : "") + floor(hundredths / 100) + "." + (part < 10 ? "0" : "") + part;
    }
}

// A delayed hint beside its anchor. Paint-only: it never takes pointer input.
component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> show;
    in property <length> anchor-width;
    in property <length> anchor-height;
    // -1 aligns with the anchor's left edge, 0 centers, 1 aligns with its right edge.
    in property <int> align: 0;
    in property <bool> below: false;
    property <float> shown: root.show && root.text != "" ? 1 : 0;
    animate shown { duration: Theme.motion-fast; easing: ease-out; }
    visible: self.shown > 0.01;
    opacity: self.shown;
    height: 24px * Theme.ui-scale;
    width: max(40px * Theme.ui-scale, tip-text.preferred-width + 16px * Theme.ui-scale);
    x: root.align < 0 ? 0px : (root.align > 0 ? root.anchor-width - self.width : (root.anchor-width - self.width) / 2);
    y: root.below
        ? root.anchor-height + 6px * Theme.ui-scale - (1 - self.shown) * 3px * Theme.ui-scale
        : -self.height - 6px * Theme.ui-scale + (1 - self.shown) * 3px * Theme.ui-scale;
    background: Theme.tooltip; border-width: 1px; border-color: Theme.strong-border; border-radius: 3px * Theme.ui-scale;
    tip-text := Text { text: root.text; color: Theme.ink; font-size: Theme.font(10); horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
}

component Tool inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    // Shown instead of `icon` while `alt` is true; the two icons cross-fade.
    in property <image> alt-icon;
    in property <bool> alt: false;
    in property <string> label;
    // Appended to the tooltip: a shortcut, or why the button is unavailable.
    in property <string> hint;
    in property <bool> show-tip: true;
    in property <int> tip-align: 0;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> icon-size: 20px * Theme.ui-scale;
    in property <length> symbol-size: Theme.font(16);
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    width: 32px * Theme.ui-scale; height: 30px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale;
    property <bool> hovered: hit.has-hover && root.enabled;
    property <bool> pressed: hit.pressed && root.enabled;
    property <bool> tip-ready: false;
    property <bool> show-alt: root.alt && root.alt-icon.width > 0;
    property <color> ink: root.primary ? Theme.on-accent : (root.active ? Theme.accent-hover : Theme.ink);
    background: root.primary
        ? (root.pressed ? Theme.accent.darker(0.18) : (root.hovered ? Theme.accent-hover : Theme.accent))
        : root.active
            ? (root.pressed ? Theme.selected : (root.hovered ? Theme.checked.brighter(0.12) : Theme.checked))
            : (root.pressed ? Theme.trough : (root.hovered ? Theme.hover : Theme.raised));
    border-width: 1px;
    border-color: focus.has-focus || root.active || root.primary ? Theme.accent : (root.hovered ? Theme.strong-border : Theme.border);
    opacity: root.enabled ? 1 : 0.4;
    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    animate opacity { duration: Theme.motion-base; easing: ease-out; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    // The face sinks slightly while pressed; the frame stays put.
    face := Rectangle {
        transform-scale: root.pressed ? 0.9 : 1;
        animate transform-scale { duration: Theme.motion-fast; easing: ease-out; }
        if root.icon.width > 0: Image {
            source: root.icon; colorize: root.ink; width: root.icon-size; height: root.icon-size;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            opacity: root.show-alt ? 0 : 1; transform-scale: root.show-alt ? 0.6 : 1;
            animate opacity, transform-scale { duration: Theme.motion-base; easing: ease-out; }
            animate colorize { duration: Theme.motion-fast; }
        }
        if root.alt-icon.width > 0: Image {
            source: root.alt-icon; colorize: root.ink; width: root.icon-size; height: root.icon-size;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            opacity: root.show-alt ? 1 : 0; transform-scale: root.show-alt ? 1 : 0.6;
            animate opacity, transform-scale { duration: Theme.motion-base; easing: ease-out; }
            animate colorize { duration: Theme.motion-fast; }
        }
        if root.icon.width == 0: Text { text: root.symbol; color: root.ink; font-size: root.symbol-size; horizontal-alignment: center; vertical-alignment: center; animate color { duration: Theme.motion-fast; } }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; } reject } }
    // Hover is tracked while disabled too, so the tooltip can say why.
    hit := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: root.show-tip && hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: root.tip-align;
        text: root.label + (root.hint != "" ? "  ·  " + root.hint : "");
        show: root.tip-ready && !hit.pressed;
    }
}
component Caption inherits Text { color: Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }

// A Pitch / Rate entry: type a value and press Enter, or step it with the mouse
// wheel or Up / Down (Shift for fine steps). The controller rejects out-of-range
// input and asks the field to shake and show the accepted range.
component NumberField inherits Rectangle {
    in property <string> input-label;
    in property <bool> enabled: true;
    in-out property <string> text;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> default-value;
    in property <float> step;
    in property <float> fine-step;
    in property <string> range-hint;
    out property <bool> modified: root.text.is-float() && abs(root.text.to-float() - root.default-value) > 0.0001;
    out property <bool> has-focus: edit.has-focus;
    callback submit(string);
    property <bool> invalid: false;
    property <bool> shaking: false;
    property <duration> shake-start: 0ms;
    property <length> wheel-travel: 0px;
    public function refuse() {
        root.invalid = true;
        root.shaking = true;
        root.shake-start = animation-tick();
    }
    function step-by(direction: int, fine: bool) {
        if !root.enabled { return; }
        let base = root.text.is-float() ? root.text.to-float() : root.default-value;
        let next = clamp(Math.round((base + direction * (fine ? root.fine-step : root.step)) / root.fine-step) * root.fine-step, root.minimum, root.maximum);
        root.text = Clock.fixed2(next);
        root.submit(root.text);
    }
    // Decaying side-to-side offset after rejected input; reads the frame clock only while shaking.
    property <float> shake-elapsed: root.shaking ? (animation-tick() - root.shake-start) / 1ms : 0;
    property <length> shake-offset: root.shaking ? 4px * Theme.ui-scale * max(0, 1 - root.shake-elapsed / 300) * sin(root.shake-elapsed / 75 * 360deg) : 0px;
    Timer { interval: 320ms; running: root.shaking; triggered => { root.shaking = false; } }
    Timer { interval: 1800ms; running: root.invalid; triggered => { root.invalid = false; } }
    // Up / Down are observed before the text input sees them.
    keys := FocusScope {
        x: root.shake-offset; width: root.width; height: root.height;
        focus-on-click: false; focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.enabled && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.step-by(event.text == Key.UpArrow ? 1 : -1, event.modifiers.shift);
                return accept;
            }
            reject
        }
        // The wheel reaches this area because the text input ignores scrolling.
        TouchArea {
            scroll-event(event) => {
                let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
                if !root.enabled || delta == 0px { return reject; }
                root.wheel-travel += delta;
                // One detent (120px) is one step; precision touchpads accumulate.
                if abs(root.wheel-travel) >= 40px {
                    root.step-by(root.wheel-travel > 0px ? 1 : -1, event.modifiers.shift);
                    root.wheel-travel = 0px;
                }
                return accept;
            }
            edit := LineEdit {
                width: parent.width; height: parent.height;
                text <=> root.text; enabled: root.enabled; input-label: root.input-label;
                changed has-focus => { if !self.has-focus && root.enabled { root.submit(self.text); } }
                accepted => { root.submit(self.text); }
            }
        }
        // A non-default value carries an accent mark.
        Rectangle {
            x: parent.width - 8px * Theme.ui-scale; y: 4px * Theme.ui-scale; width: 4px * Theme.ui-scale; height: self.width; border-radius: self.width / 2;
            background: Theme.accent; opacity: root.modified && root.enabled ? 1 : 0;
            animate opacity { duration: Theme.motion-base; }
        }
        Rectangle {
            border-width: 1px; border-radius: 4px * Theme.ui-scale; border-color: Theme.danger;
            opacity: root.invalid ? 1 : 0;
            animate opacity { duration: Theme.motion-base; }
        }
    }
    Tip { z: 10; anchor-width: root.width; anchor-height: root.height; align: -1; text: root.range-hint; show: root.invalid; }
}

// Monitoring level in dB. Drag or click to set, wheel for 1 dB steps, double-click
// for 0 dB; arrow keys step 1 dB (Shift 0.1 dB).
component VolumeSlider inherits Rectangle {
    in property <float> minimum: -60;
    in property <float> maximum: 0;
    in property <float> reset-value: 0;
    in property <bool> enabled: true;
    in property <string> label;
    in-out property <float> value;
    out property <bool> has-focus: focus.has-focus;
    out property <bool> dragging: touch.pressed;
    callback changed(float);
    min-height: 20px * Theme.ui-scale; min-width: 60px * Theme.ui-scale;
    horizontal-stretch: 1; vertical-stretch: 0;
    accessible-role: slider; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum; accessible-value-step: 0.1;
    accessible-action-set-value(v) => { if v.is-float() { root.set(v.to-float()); } }
    accessible-action-increment => { root.set(root.value + 0.1); }
    accessible-action-decrement => { root.set(root.value - 0.1); }
    forward-focus: focus;
    property <length> inset: 8px * Theme.ui-scale;
    property <length> span: max(1px, root.width - 2 * root.inset);
    property <float> fraction: clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
    property <bool> emphasized: root.enabled && (touch.has-hover || touch.pressed || focus.has-focus);
    function set(v: float) {
        let next = clamp(Math.round(v * 10) / 10, root.minimum, root.maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }
    function set-from(x: length) { root.set(root.minimum + clamp((x - root.inset) / root.span, 0, 1) * (root.maximum - root.minimum)); }
    Rectangle {
        x: root.inset; width: root.span; y: (parent.height - self.height) / 2;
        height: (root.emphasized ? 5px : 4px) * Theme.ui-scale; border-radius: self.height / 2;
        background: Theme.strong-border.with-alpha(root.enabled ? 0.55 : 0.25);
        animate height { duration: Theme.motion-fast; }
        Rectangle { x: 0px; height: parent.height; width: parent.width * root.fraction; border-radius: parent.border-radius; background: Theme.accent; }
    }
    Rectangle {
        width: (root.emphasized ? 14px : 10px) * Theme.ui-scale; height: self.width; border-radius: self.width / 2;
        x: root.inset + root.span * root.fraction - self.width / 2; y: (parent.height - self.height) / 2;
        background: touch.pressed ? Theme.accent : Theme.ink; border-width: 2px * Theme.ui-scale; border-color: Theme.accent;
        opacity: root.enabled ? 1 : 0.45;
        animate width, background { duration: Theme.motion-fast; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.set-from(self.mouse-x);
            }
        }
        moved => { if self.pressed { root.set-from(self.mouse-x); } }
        double-clicked => { root.set(root.reset-value); }
        scroll-event(event) => {
            let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
            if delta == 0px { return reject; }
            root.set(root.value + (delta > 0px ? 1 : -1));
            return accept;
        }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => {
            // Arrows keep the 0.1 dB fine step; Shift moves 1 dB, Page keys 6 dB.
            let stepv = event.modifiers.shift ? 1 : 0.1;
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.set(root.value - stepv); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.set(root.value + stepv); return accept; }
            if event.text == Key.PageDown { root.set(root.value - 6); return accept; }
            if event.text == Key.PageUp { root.set(root.value + 6); return accept; }
            if event.text == Key.Home { root.set(root.minimum); return accept; }
            if event.text == Key.End { root.set(root.maximum); return accept; }
            reject
        }
    }
}

// The audio route at a glance: a colored dot (idle, active, xrun, error), the
// backend and device rate; the full engine summary sits in the tooltip.
component OutputPill inherits Rectangle {
    in property <bool> chinese;
    in property <string> backend;
    in property <string> rate;
    in property <int> xruns;
    in property <bool> failed;
    in property <string> details;
    callback clicked();
    property <int> seen-xruns: 0;
    property <bool> alarm: false;
    property <bool> tip-ready: false;
    property <bool> idle: root.backend == "";
    changed xruns => {
        if root.xruns > root.seen-xruns { root.alarm = true; }
        root.seen-xruns = root.xruns;
    }
    Timer { interval: 1000ms; running: root.alarm; triggered => { root.alarm = false; } }
    property <color> tone: root.failed ? Theme.danger : (root.alarm ? Theme.warning : (root.idle ? Theme.muted : Theme.accent));
    height: 22px * Theme.ui-scale; border-radius: self.height / 2; horizontal-stretch: 0;
    background: hit.pressed ? Theme.trough : (hit.has-hover ? Theme.hover : Theme.raised);
    border-width: 1px; border-color: root.alarm ? Theme.warning : (hit.has-hover ? Theme.strong-border : Theme.border);
    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    accessible-role: button; accessible-label: root.chinese ? "音频输出状态" : "Audio output status";
    accessible-description: root.details;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px * Theme.ui-scale; padding-right: 10px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
        VerticalLayout { alignment: center;
            Rectangle {
                width: 7px * Theme.ui-scale; height: self.width; border-radius: self.width / 2; background: root.tone;
                animate background { duration: Theme.motion-base; }
            }
        }
        Text {
            min-width: 0px; overflow: elide; vertical-alignment: center; font-size: Theme.font(10); color: Theme.dim;
            text: root.idle ? (root.chinese ? "输出空闲" : "Output idle") : root.backend + (root.rate != "" ? " · " + root.rate : "");
        }
        if root.xruns > 0: Text { text: root.xruns + " xruns"; color: Theme.warning; font-size: Theme.font(10); vertical-alignment: center; }
    }
    hit := TouchArea {
        mouse-cursor: pointer; clicked => { root.clicked(); }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: 1;
        text: root.details + (root.chinese ? "  ·  点击打开音频输出设置" : "  ·  Click for audio output settings");
        show: root.tip-ready && !hit.pressed;
    }
}

// Where the visible window sits inside the whole sound. The thumb is as wide as
// the visible share; drag it, click the track to jump, or scroll to pan.
component OverviewBar inherits Rectangle {
    in property <bool> chinese;
    in property <float> zoom: 1;
    in property <bool> enabled: true;
    in-out property <float> scroll;
    callback pan(float);
    forward-focus: focus;
    property <bool> active: root.enabled && root.zoom > 1.0001;
    property <length> thumb-width: max(18px * Theme.ui-scale, root.width / max(1, root.zoom));
    property <length> travel: max(0px, root.width - root.thumb-width);
    property <length> grab-offset: 0px;
    property <float> drag-scroll: 0;
    // While dragging, the thumb follows the pointer rather than the last render.
    property <float> shown-scroll: touch.pressed ? root.drag-scroll : root.scroll;
    accessible-role: slider; accessible-label: root.chinese ? "波形可视范围" : "Visible waveform range";
    accessible-enabled: root.active; accessible-value: root.scroll;
    accessible-value-minimum: 0; accessible-value-maximum: 1; accessible-value-step: 0.05;
    accessible-action-increment => { root.move-to(root.scroll + 0.05); }
    accessible-action-decrement => { root.move-to(root.scroll - 0.05); }
    accessible-action-set-value(v) => { if v.is-float() { root.move-to(v.to-float()); } }
    opacity: root.active ? 1 : 0;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }
    function move-to(value: float) {
        if !root.active { return; }
        let next = clamp(value, 0, 1);
        root.drag-scroll = next;
        if next != root.scroll {
            root.scroll = next;
            root.pan(next);
        }
    }
    Rectangle {
        y: (parent.height - self.height) / 2; height: 6px * Theme.ui-scale; border-radius: self.height / 2;
        background: Theme.trough; border-width: 1px; border-color: Theme.border;
    }
    thumb := Rectangle {
        x: root.travel * root.shown-scroll; width: root.thumb-width;
        y: (parent.height - self.height) / 2; height: (touch.has-hover || touch.pressed ? 10px : 8px) * Theme.ui-scale; border-radius: self.height / 2;
        background: touch.pressed ? Theme.accent : (touch.has-hover ? Theme.accent.mix(Theme.segment, 0.45) : Theme.segment);
        border-width: 1px; border-color: focus.has-focus || touch.has-hover || touch.pressed ? Theme.accent : Theme.strong-border;
        animate height, background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.active; mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                let on-thumb = self.mouse-x >= thumb.x && self.mouse-x <= thumb.x + thumb.width;
                root.grab-offset = on-thumb ? self.mouse-x - thumb.x : root.thumb-width / 2;
                root.drag-scroll = root.scroll;
                if !on-thumb && root.travel > 0px { root.move-to((self.mouse-x - root.grab-offset) / root.travel); }
            }
        }
        moved => { if self.pressed && root.travel > 0px { root.move-to((self.mouse-x - root.grab-offset) / root.travel); } }
        scroll-event(event) => {
            let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
            if delta == 0px { return reject; }
            // One detent pans a quarter of the visible window.
            root.move-to(root.scroll - delta / 120px * 0.25 / max(1, root.zoom - 1));
            return accept;
        }
    }
    // Keep the native slider's keyboard reachability when painting a custom overview.
    focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if !root.active { return reject; }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.move-to(root.scroll - 0.05); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.move-to(root.scroll + 0.05); return accept; }
            if event.text == Key.PageDown { root.move-to(root.scroll - 0.25); return accept; }
            if event.text == Key.PageUp { root.move-to(root.scroll + 0.25); return accept; }
            if event.text == Key.Home { root.move-to(0); return accept; }
            if event.text == Key.End { root.move-to(1); return accept; }
            reject
        }
    }
}

export component AuditionPanel inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> spectral: true;
    in property <bool> chinese;
    in property <bool> play-on-single-click: false;
    in property <bool> ready;
    // Why the transport may be unavailable: a missing source or library maintenance.
    in property <bool> missing: false;
    in property <bool> busy: false;
    // Engine transport phase: 0 empty, 1 loading, 2 ready, 3 playing, 4 paused,
    // 5 stopped, 6 ended, 7 error.
    in property <int> state: 0;
    in property <string> error-text;
    // A network stream has run dry for a moment while playing.
    in property <bool> buffering: false;
    in property <bool> playing;
    in property <bool> smooth-progress: false;
    in property <string> progress-clock;
    in property <float> playback-rate: 1;
    in property <image> waveform;
    in property <bool> waveform-ready;
    // Share of the current Waveform render that has arrived (1 when complete).
    in property <float> waveform-progress: 1;
    in property <string> name;
    in property <string> info;
    // Full engine output summary (tooltip of the output status).
    in property <string> output;
    // Active backend ("" while idle) and device rate for the output status.
    in property <string> output-backend;
    in property <string> output-rate;
    in property <int> output-xruns;
    in property <float> position;
    in property <float> duration;
    in property <string> time;
    in property <string> end-time;
    // Source range of the displayed Waveform image.
    in property <float> view-start;
    in property <float> view-end;
    // Requested range while its render is pending; equals view-* once the image lands.
    // An empty range (end <= start) means no request is pending.
    in property <float> target-start;
    in property <float> target-end;
    in property <float> zoom: 1;
    in property <[RulerTick]> ruler-ticks;
    in property <bool> relink-enabled: true;
    in-out property <float> scroll: 0;
    in-out property <float> volume-db: -1.9;
    out property <bool> volume-adjusting: volume-control.has-focus;
    in property <string> volume-label;
    in-out property <string> pitch-text: "0.00";
    in-out property <string> rate-text: "1.00";
    in-out property <bool> mono: false;
    in-out property <bool> repeat: false;
    callback play(); callback pause(); callback stop(); callback seek(float); callback seek-play(float);
    callback transform(string,string,bool,bool); callback volume(float);
    callback resize(int,int); callback zoom-change(float); callback zoom-at(float,float); callback pan(float);
    callback peaks(); callback output-settings();
    callback retry(); callback relink();
    /// The controller rejected typed transform input: bit 1 Pitch, bit 2 Rate.
    public function reject-input(fields: int) {
        if Math.mod(fields, 2) == 1 { pitch-field.refuse(); }
        if fields >= 2 { rate-field.refuse(); }
    }
    // The frame clock fills gaps between engine snapshots, with bounded prediction.
    // Repeated positions do not restart the clock; stalled output stops after 100ms.
    property <float> anchor-position: 0;
    property <duration> anchor-tick: 0ms;
    property <float> correction: 0;
    property <duration> progress-elapsed: root.ready && root.playing && root.smooth-progress ? clamp(animation-tick() - root.anchor-tick, 0ms, 100ms) : 0ms;
    property <float> visual-position: clamp(root.anchor-position + root.progress-elapsed / 1s * root.playback-rate + root.correction * (1 - root.progress-elapsed / 100ms), 0, root.duration);
    function sync-progress(allow-correction: bool) {
        let previous = root.visual-position;
        let continuous = allow-correction && root.ready && root.playing && root.smooth-progress && abs(previous - root.position) < 0.1 * root.playback-rate;
        root.anchor-position = root.position;
        root.anchor-tick = animation-tick();
        root.correction = continuous ? previous - root.position : 0;
    }
    init => { root.sync-progress(false); }
    changed position => {
        // Repeat wrapping back to the start is marked where playback resumes.
        if root.repeat && root.playing && root.duration > 0 && root.anchor-position > root.duration * 0.75 && root.position < root.duration * 0.25 {
            root.flash-at(root.position);
        }
        root.sync-progress(true);
    }
    changed playing => { root.sync-progress(false); }
    changed smooth-progress => { root.sync-progress(false); }
    changed playback-rate => { root.sync-progress(false); }
    // A clock identity survives deferred coalescing of smooth false -> true.
    changed progress-clock => { root.sync-progress(false); }
    function wheel-zoom(delta: length, fraction: float) -> EventResult {
        if root.ready && root.duration > 0 && delta != 0px {
            // Pixel deltas support both mouse detents and precision touchpads.
            root.zoom-at(Math.pow(2, clamp(delta / 120px, -2, 2)), clamp(fraction, 0, 1));
            return accept;
        }
        return reject;
    }
    function toggle() { if root.playing { root.pause(); } else { root.play(); } }

    // The range the timeline draws: a pending request wins over the last image.
    property <bool> has-target: root.target-end > root.target-start;
    property <float> shown-start: root.has-target ? root.target-start : root.view-start;
    property <float> shown-end: root.has-target ? root.target-end : root.view-end;
    property <float> shown-span: max(0.001, root.shown-end - root.shown-start);
    function time-at(fraction: float) -> float { return root.shown-start + clamp(fraction, 0, 1) * (root.shown-end - root.shown-start); }
    function seek-to(fraction: float) {
        let seconds = root.time-at(fraction);
        root.flash-at(seconds);
        root.seek-play(seconds);
    }

    // What the timeline shows: 0 nothing loaded, 1 loading / analysing, 2 Waveform,
    // 3 load error, 4 missing source, 5 library maintenance.
    property <int> phase: root.busy ? 5 : (root.missing ? 4 : (root.state == 7 ? 3 : ((root.state == 1 || (root.ready && !root.waveform-ready)) ? 1 : (root.waveform-ready ? 2 : 0))));
    // Why transport buttons are disabled, for their tooltips.
    property <string> unavailable: root.busy ? (root.chinese ? "音效库维护中" : "Library maintenance in progress")
        : root.missing ? (root.chinese ? "文件缺失" : "File missing")
        : root.state == 7 ? (root.chinese ? "加载失败" : "Load failed")
        : root.state == 1 ? (root.chinese ? "正在加载" : "Loading")
        : (root.chinese ? "未加载声音" : "No sound loaded");
    property <string> transport-hint: root.ready ? "" : root.unavailable;

    // A short glow where playback lands (seek, repeat wrap).
    property <float> flash-time: 0;
    property <bool> flash-on: false;
    function flash-at(seconds: float) { root.flash-time = seconds; root.flash-on = true; }
    Timer { interval: 90ms; running: root.flash-on; triggered => { root.flash-on = false; } }

    // Pointer scrubbing: the playhead preview follows the drag; release seeks.
    property <bool> scrubbing: false;
    property <length> scrub-x: 0px;

    property <float> premute-db: -12;
    property <bool> muted: root.volume-db <= -59.95;
    function toggle-mute() {
        if root.muted {
            let restore = root.premute-db > -59.95 ? root.premute-db : -12;
            root.volume-db = restore;
            root.volume(restore);
        } else {
            root.premute-db = root.volume-db;
            root.volume-db = -60;
            root.volume(-60);
        }
    }

    property <bool> show-remaining: false;
    property <bool> zoom-pulse: false;
    changed zoom => { root.zoom-pulse = true; }
    Timer { interval: 220ms; running: root.zoom-pulse; triggered => { root.zoom-pulse = false; } }
    property <bool> name-fresh: false;
    changed name => { root.name-fresh = true; }
    Timer { interval: 40ms; running: root.name-fresh; triggered => { root.name-fresh = false; } }

    height: root.compact ? 190px * Theme.ui-scale : 222px * Theme.ui-scale; background: Theme.player; border-width: 1px; border-color: Theme.player-border; border-radius: 7px * Theme.ui-scale;
    VerticalLayout { padding: 9px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
        HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
            Tool { icon: @image-url("icons/start.svg"); label: root.chinese ? "回到开头" : "Go to start"; hint: root.transport-hint; tip-align: -1; enabled: root.ready; clicked => { root.flash-at(0); root.seek(0); } }
            Tool {
                icon: @image-url("icons/play.svg"); alt-icon: @image-url("icons/pause.svg"); alt: root.playing; primary: true; enabled: root.ready;
                label: root.playing ? (root.chinese ? "暂停" : "Pause") : (root.chinese ? "播放" : "Play");
                hint: root.ready ? (root.chinese ? "空格" : "Space") : root.unavailable;
                clicked => { root.toggle(); }
            }
            Tool { icon: @image-url("icons/stop.svg"); label: root.chinese ? "停止" : "Stop"; hint: root.transport-hint; enabled: root.ready; clicked => { root.stop(); } }
            Tool { icon: @image-url("icons/repeat.svg"); label: root.chinese ? "循环整个声音" : "Repeat sound"; hint: root.repeat ? (root.chinese ? "已开启" : "On") : ""; active: root.repeat; clicked => { root.repeat = !root.repeat; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Rectangle { width: 1px; background: Theme.player-border; }
            HorizontalLayout { spacing: 4px * Theme.ui-scale; horizontal-stretch: 0;
                Caption { text: root.chinese ? "音高" : "Pitch"; color: pitch-field.modified ? Theme.accent-hover : Theme.dim; animate color { duration: Theme.motion-base; } }
                pitch-field := NumberField {
                    width: 62px * Theme.ui-scale; enabled: root.ready; text <=> root.pitch-text;
                    minimum: -24; maximum: 24; default-value: 0; step: 1; fine-step: 0.1;
                    input-label: root.chinese ? "变调半音，回车或离开时应用" : "Pitch semitones, applied on Enter or focus loss";
                    range-hint: root.chinese ? "音高范围 −24 ~ +24 半音" : "Pitch range −24 to +24 semitones";
                    submit(value) => { root.transform(value, root.rate-text, root.mono, root.repeat); }
                }
                Caption { text: root.chinese ? "半音" : "st"; }
            }
            HorizontalLayout { spacing: 4px * Theme.ui-scale; horizontal-stretch: 0;
                Caption { text: root.chinese ? "速度" : "Rate"; color: rate-field.modified ? Theme.accent-hover : Theme.dim; animate color { duration: Theme.motion-base; } }
                rate-field := NumberField {
                    width: 57px * Theme.ui-scale; enabled: root.ready; text <=> root.rate-text;
                    minimum: 0.25; maximum: 4; default-value: 1; step: 0.05; fine-step: 0.01;
                    input-label: root.chinese ? "保持音高的播放速度，回车或离开时应用" : "Pitch-preserving speed, applied on Enter or focus loss";
                    range-hint: root.chinese ? "速度范围 0.25 ~ 4.00 倍" : "Rate range 0.25 to 4.00×";
                    submit(value) => { root.transform(root.pitch-text, value, root.mono, root.repeat); }
                }
                Caption { text: "×"; }
            }
            Tool {
                icon: @image-url("icons/reset.svg"); label: root.chinese ? "重置变调与速度" : "Reset Pitch / Rate";
                enabled: pitch-field.modified || rate-field.modified;
                clicked => { root.pitch-text = "0.00"; root.rate-text = "1.00"; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); }
            }
            Rectangle { width: 1px; background: Theme.player-border; }
            Tool {
                width: 28px * Theme.ui-scale; icon-size: 18px * Theme.ui-scale;
                icon: @image-url("icons/volume.svg"); alt-icon: @image-url("icons/volume-mute.svg"); alt: root.muted; active: root.muted;
                label: root.muted ? (root.chinese ? "取消静音" : "Unmute") : (root.chinese ? "静音" : "Mute");
                clicked => { root.toggle-mute(); }
            }
            volume-control := VolumeSlider {
                min-width: 76px * Theme.ui-scale; max-width: 160px * Theme.ui-scale; horizontal-stretch: 1;
                label: root.chinese ? "音量" : "Volume"; value <=> root.volume-db;
                changed(value) => { root.volume(value); }
            }
            Caption { width: 54px * Theme.ui-scale; text: root.volume-label; horizontal-alignment: right; color: root.muted ? Theme.muted : Theme.dim; font-size: Theme.font(10); }
            Tool { width: 54px * Theme.ui-scale; symbol: root.chinese ? "单声道" : "Mono"; symbol-size: Theme.font(11); label: root.chinese ? "单声道监听" : "Mono monitoring"; hint: root.mono ? (root.chinese ? "已开启" : "On") : ""; active: root.mono; clicked => { root.mono = !root.mono; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Rectangle { horizontal-stretch: 1; min-width: 0px; }
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                OutputPill {
                    chinese: root.chinese; backend: root.output-backend; rate: root.output-rate; xruns: root.output-xruns;
                    failed: root.state == 7; details: root.output;
                    clicked => { root.output-settings(); }
                }
            }
            Tool { icon: @image-url("icons/peaks.svg"); label: root.chinese ? "波形显示设置" : "Peak display settings"; tip-align: 1; clicked => { root.peaks(); } }
            Tool { icon: @image-url("icons/settings.svg"); label: root.chinese ? "音频输出" : "Audio output"; tip-align: 1; clicked => { root.output-settings(); } }
        }
        wave := Rectangle { horizontal-stretch: 1; vertical-stretch: 1; min-height: root.compact ? 45px * Theme.ui-scale : 70px * Theme.ui-scale; background: root.spectral ? Theme.spectral-canvas : Theme.normal-canvas;
            border-color: wave-keys.has-focus ? Theme.accent : Theme.player-border; border-width: 1px; clip: true;
            animate border-color { duration: Theme.motion-fast; }
            accessible-role: groupbox; accessible-label: root.chinese ? "波形时间轴" : "Waveform timeline";
            property <float> played-fraction: root.duration > 0 ? clamp((root.visual-position - root.shown-start) / root.shown-span, 0, 1) : 0;
            property <bool> head-visible: root.ready && root.duration > 0 && root.visual-position >= root.shown-start && root.visual-position <= root.shown-end;
            property <length> head-x: clamp(wave.played-fraction * wave.width, 1px, max(1px, wave.width - 1px));
            property <color> head-color: root.spectral ? #f4faf7 : Theme.accent-hover;
            property <float> head-opacity: root.state == 6 ? 0 : (root.playing ? 1 : 0.8);
            animate head-opacity { duration: Theme.motion-slow; easing: ease-out; }
            property <bool> pointer-in: root.ready && (scrub.has-hover || ruler-touch.has-hover || root.scrubbing);
            property <length> pointer-x: root.scrubbing ? root.scrub-x : clamp(scrub.has-hover ? scrub.mouse-x : ruler-touch.mouse-x, 0px, wave.width);
            changed width => { root.resize(self.width / 1px, self.height / 1px); }
            changed height => { root.resize(self.width / 1px, self.height / 1px); }
            // The last image, placed by its own range inside the drawn range: a pending
            // zoom or pan moves the old picture until the new render replaces it.
            Image {
                source: root.waveform; height: parent.height; image-fit: fill;
                x: (root.view-start - root.shown-start) / root.shown-span * parent.width;
                width: max(0px, (root.view-end - root.view-start) / root.shown-span * parent.width);
                opacity: root.waveform-ready ? 1 : 0;
                animate opacity { duration: Theme.motion-slow; easing: ease-out; }
                animate x, width { duration: Theme.motion-fast; easing: ease-out; }
            }
            // Loading: faint lanes and a sweeping highlight. The frame clock is read only meanwhile.
            if root.phase == 1 && !root.waveform-ready: Rectangle {
                property <float> sweep: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                property <color> lane: root.spectral ? #26323818 : #ffffff10;
                Rectangle { y: parent.height * 0.25 - 1px; height: 2px; background: parent.lane; }
                Rectangle { y: parent.height * 0.75 - 1px; height: 2px; background: parent.lane; }
                Rectangle {
                    width: parent.width * 0.3; x: (parent.width + self.width) * parent.sweep - self.width;
                    background: @linear-gradient(90deg, #ffffff00 0%, (root.spectral ? #ffffff30 : #ffffff14) 50%, #ffffff00 100%);
                }
            }
            // Render progress while a partial Waveform is already on screen.
            if root.ready && root.waveform-ready && root.waveform-progress < 1: Rectangle {
                y: 0px; height: 2px * Theme.ui-scale; background: #00000020;
                Rectangle { x: 0px; height: parent.height; width: parent.width * clamp(root.waveform-progress, 0, 1); background: Theme.accent; animate width { duration: Theme.motion-base; } }
            }
            // These overlays are paint-only, leaving click/scroll ownership to scrub.
            if root.ready && root.duration > 0: Rectangle {
                x: 0px; y: 0px; height: parent.height; width: wave.played-fraction * parent.width;
                background: root.spectral ? #183c3428 : #8faea622;
                opacity: root.state == 6 ? 0.5 : 1;
                animate opacity { duration: Theme.motion-slow; }
                accessible-role: progress-indicator; accessible-label: root.chinese ? "已播放区域" : "Played waveform region";
                accessible-value: root.position; accessible-value-minimum: 0; accessible-value-maximum: root.duration;
                Rectangle { x: 0px; width: parent.width; y: parent.height - 3px * Theme.ui-scale; height: 3px * Theme.ui-scale; background: Theme.accent; }
            }
            // Landing glow for seeks and repeat wraps.
            Rectangle {
                width: 18px * Theme.ui-scale; x: (root.flash-time - root.shown-start) / root.shown-span * parent.width - self.width / 2;
                background: @linear-gradient(90deg, Theme.accent.with-alpha(0) 0%, Theme.accent.with-alpha(0.6) 50%, Theme.accent.with-alpha(0) 100%);
                opacity: 0;
                states [
                    lit when root.flash-on: {
                        opacity: 1;
                        in { animate opacity { duration: 60ms * Theme.motion; } }
                        out { animate opacity { duration: 420ms * Theme.motion; easing: ease-out; } }
                    }
                ]
            }
            // Playhead: a glow, a 2px line and a handle (filled while playing, hollow otherwise).
            if wave.head-visible: Rectangle { x: wave.head-x - 3px * Theme.ui-scale; width: 6px * Theme.ui-scale; background: wave.head-color.with-alpha(0.2); opacity: wave.head-opacity; }
            if wave.head-visible: Rectangle { x: wave.head-x - 1px; width: 2px; background: wave.head-color; opacity: wave.head-opacity; }
            if wave.head-visible: Path {
                x: wave.head-x - 6px * Theme.ui-scale; y: 0px; width: 12px * Theme.ui-scale; height: 8px * Theme.ui-scale;
                viewbox-width: 12; viewbox-height: 8; commands: "M 0.75 0.75 L 11.25 0.75 L 6 7.25 Z";
                fill: root.playing ? wave.head-color : transparent; stroke: wave.head-color; stroke-width: 1.5px;
                opacity: wave.head-opacity;
            }
            // After the end, a hollow handle at the start: Play begins there.
            Path {
                x: -6px * Theme.ui-scale + (0 - root.shown-start) / root.shown-span * parent.width; y: 0px; width: 12px * Theme.ui-scale; height: 8px * Theme.ui-scale;
                viewbox-width: 12; viewbox-height: 8; commands: "M 0.75 0.75 L 11.25 0.75 L 6 7.25 Z";
                fill: transparent; stroke: wave.head-color; stroke-width: 1.5px;
                opacity: root.ready && root.state == 6 && root.shown-start <= 0 ? 0.85 : 0;
                animate opacity { duration: Theme.motion-slow; easing: ease-out; }
            }
            // Pointer: a hairline (accent while scrubbing) and the time under it.
            if wave.pointer-in: Rectangle { x: wave.pointer-x; width: 1px; background: root.scrubbing ? Theme.accent : (root.spectral ? #ffffff80 : #ffffff40); }
            if wave.pointer-in && root.scrubbing: Path {
                x: wave.pointer-x - 6px * Theme.ui-scale; y: 0px; width: 12px * Theme.ui-scale; height: 8px * Theme.ui-scale;
                viewbox-width: 12; viewbox-height: 8; commands: "M 0.75 0.75 L 11.25 0.75 L 6 7.25 Z";
                fill: Theme.accent; stroke: Theme.accent; stroke-width: 1.5px;
            }
            if wave.pointer-in: Rectangle {
                y: 10px * Theme.ui-scale; height: 18px * Theme.ui-scale; width: pointer-time.preferred-width + 12px * Theme.ui-scale;
                x: clamp(wave.pointer-x - self.width / 2, 2px, max(2px, wave.width - self.width - 2px));
                background: Theme.tooltip.with-alpha(0.9); border-width: 1px; border-color: root.scrubbing ? Theme.accent : Theme.strong-border; border-radius: 3px * Theme.ui-scale;
                pointer-time := Text {
                    text: Clock.format(root.time-at(wave.pointer-x / max(1px, wave.width)));
                    color: root.scrubbing ? Theme.accent-hover : Theme.ink; font-family: "Consolas"; font-size: Theme.font(10);
                    horizontal-alignment: center; vertical-alignment: center; accessible-role: none;
                }
            }
            // Keyboard (after Tab): Space plays/pauses, Left/Right nudge (Shift: larger),
            // Home returns to the start, + / - / 0 zoom. A click does not take focus, so
            // list navigation keeps working after a seek.
            wave-keys := FocusScope {
                enabled: root.ready; focus-on-click: false;
                key-pressed(event) => {
                    if !root.ready { return reject; }
                    if event.text == " " { root.toggle(); return accept; }
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        let nudge = (event.modifiers.shift ? 0.25 : 0.05) * (root.shown-end - root.shown-start);
                        root.seek(clamp(root.visual-position + (event.text == Key.LeftArrow ? -nudge : nudge), 0, root.duration));
                        return accept;
                    }
                    if event.text == Key.Home { root.flash-at(0); root.seek(0); return accept; }
                    if event.text == "+" || event.text == "=" { root.zoom-change(2); return accept; }
                    if event.text == "-" && root.zoom > 1 { root.zoom-change(0.5); return accept; }
                    if event.text == "0" { root.zoom-change(0); return accept; }
                    reject
                }
                scrub := TouchArea { enabled: root.ready; mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button != PointerEventButton.left { return; }
                        if event.kind == PointerEventKind.down {
                            root.scrubbing = true;
                            root.scrub-x = clamp(self.mouse-x, 0px, self.width);
                        } else if event.kind == PointerEventKind.up && root.scrubbing {
                            root.scrubbing = false;
                            root.seek-to(self.mouse-x / max(1px, self.width));
                        } else if event.kind == PointerEventKind.cancel {
                            root.scrubbing = false;
                        }
                    }
                    moved => { if root.scrubbing { root.scrub-x = clamp(self.mouse-x, 0px, self.width); } }
                    scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
                }
            }
            // Empty, loading, error, missing and maintenance states explain themselves.
            if root.phase == 0 || root.phase == 1: VerticalLayout { alignment: center; spacing: 6px * Theme.ui-scale;
                Text {
                    horizontal-alignment: center; font-size: Theme.font(11); color: root.spectral ? #263238 : Theme.dim;
                    text: root.phase == 1
                        ? (root.ready ? (root.chinese ? "正在分析频谱峰值…" : "Analyzing spectral peaks…") : (root.chinese ? "正在加载声音…" : "Loading sound…"))
                        : (root.play-on-single-click ? (root.chinese ? "单击声音即可试听" : "Click a sound to audition") : (root.chinese ? "选择声音查看波形 · 双击试听" : "Select a sound to view its waveform · Double-click to audition"));
                }
            }
            if root.phase >= 3: VerticalLayout { alignment: center;
                HorizontalLayout { alignment: center;
                    Rectangle {
                        background: Theme.tooltip.with-alpha(0.9); border-width: 1px; border-radius: 6px * Theme.ui-scale;
                        border-color: root.phase == 3 ? Theme.danger.with-alpha(0.6) : (root.phase == 4 ? Theme.warning.with-alpha(0.6) : Theme.strong-border);
                        HorizontalLayout { padding: 8px * Theme.ui-scale; padding-left: 12px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
                            VerticalLayout { alignment: center;
                                Image {
                                    width: 18px * Theme.ui-scale; height: 18px * Theme.ui-scale; accessible-role: none;
                                    source: root.phase == 4 ? @image-url("icons/file-missing.svg") : @image-url("icons/alert.svg");
                                    colorize: root.phase == 3 ? Theme.danger : Theme.warning;
                                }
                            }
                            VerticalLayout { alignment: center; spacing: 2px * Theme.ui-scale;
                                Text {
                                    font-size: Theme.font(11); font-weight: 600; color: Theme.ink;
                                    text: root.phase == 3 ? (root.chinese ? "无法加载此声音" : "Couldn't load this sound")
                                        : root.phase == 4 ? (root.chinese ? "文件缺失：原位置找不到此 WAV" : "File missing at its original location")
                                        : (root.chinese ? "音效库维护中，暂不可试听" : "Library maintenance in progress · Audition unavailable");
                                }
                                if root.phase == 3 && root.error-text != "": Text { max-width: 420px * Theme.ui-scale; text: root.error-text; overflow: elide; font-size: Theme.font(10); color: Theme.dim; }
                            }
                            if root.phase == 3: VerticalLayout { alignment: center;
                                Tool { width: 64px * Theme.ui-scale; height: 26px * Theme.ui-scale; symbol: root.chinese ? "重试" : "Retry"; symbol-size: Theme.font(11); label: root.chinese ? "重新加载并试听" : "Reload and audition"; primary: true; clicked => { root.retry(); } }
                            }
                            if root.phase == 4: VerticalLayout { alignment: center;
                                Tool { width: 96px * Theme.ui-scale; height: 26px * Theme.ui-scale; symbol: root.chinese ? "重新关联…" : "Locate file…"; symbol-size: Theme.font(11); label: root.chinese ? "选择新位置，修复引用" : "Locate the moved WAV and repair"; primary: true; enabled: root.relink-enabled; clicked => { root.relink(); } }
                            }
                        }
                    }
                }
            }
        }
        ruler := Rectangle { height: 24px * Theme.ui-scale; accessible-role: groupbox; accessible-label: root.chinese ? "波形时间尺" : "Waveform time ruler";
            for tick in root.ruler-ticks: Rectangle {
                x: clamp(tick.fraction * (ruler.width - 1px), 0px, ruler.width - 1px); width: 1px;
                Rectangle { y: 0px; width: 1px; height: tick.major ? 9px * Theme.ui-scale : 4px * Theme.ui-scale; background: tick.major ? Theme.muted : Theme.muted.with-alpha(0.55); }
                // Labels sit right of their tick so the line never crosses a digit.
                if tick.label != "": Text {
                    x: min(3px * Theme.ui-scale, ruler.width - parent.x - self.width); y: 10px * Theme.ui-scale; height: 13px * Theme.ui-scale;
                    text: tick.label; color: Theme.dim; font-size: Theme.font(9);
                }
            }
            ruler-touch := TouchArea { enabled: root.ready; mouse-cursor: pointer;
                clicked => { root.seek-to(self.mouse-x / max(1px, self.width)); }
                scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
            }
        }
        HorizontalLayout { height: 18px * Theme.ui-scale; spacing: 7px * Theme.ui-scale;
            Text {
                width: 42px * Theme.ui-scale; vertical-alignment: center; font-size: Theme.font(10);
                text: Math.round(root.zoom * 10) / 10 + "×"; color: root.zoom-pulse ? Theme.accent-hover : Theme.dim;
                animate color { duration: Theme.motion-slow; easing: ease-out; }
            }
            Rectangle { horizontal-stretch: 1;
                Text {
                    x: 0px; height: parent.height;
                    text: root.chinese ? "在波形上滚动滚轮缩放" : "Scroll on the waveform to zoom"; color: Theme.dim; font-size: Theme.font(9); vertical-alignment: center;
                    opacity: root.ready && root.zoom <= 1.0001 ? 1 : 0;
                    animate opacity { duration: Theme.motion-base; }
                }
                OverviewBar {
                    width: parent.width; height: parent.height;
                    chinese: root.chinese; zoom: root.zoom; enabled: root.ready; scroll <=> root.scroll;
                    pan(value) => { root.pan(value); }
                }
            }
            Tool { width: 28px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "−"; symbol-size: Theme.font(14); tip-align: 1; label: root.chinese ? "缩小波形" : "Zoom out"; enabled: root.ready && root.zoom > 1; clicked => { root.zoom-change(0.5); } }
            Tool { width: 28px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "+"; symbol-size: Theme.font(14); tip-align: 1; label: root.chinese ? "放大波形" : "Zoom in"; enabled: root.ready && root.zoom < 128; clicked => { root.zoom-change(2); } }
            Tool { width: 38px * Theme.ui-scale; height: 18px * Theme.ui-scale; icon: @image-url("icons/fit.svg"); icon-size: 16px * Theme.ui-scale; tip-align: 1; label: root.chinese ? "显示完整声音" : "Fit entire sound"; enabled: root.ready; clicked => { root.zoom-change(0); } }
        }
        HorizontalLayout { height: 25px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
            Rectangle { width: 208px * Theme.ui-scale;
                Text {
                    accessible-role: text; accessible-label: root.chinese ? "试听时间" : "Audition time";
                    text: (root.show-remaining ? "−" + Clock.format(max(0, root.duration - root.position)) : root.time) + "  /  " + root.end-time;
                    color: time-touch.has-hover ? Theme.accent-hover : Theme.ink; font-family: "Consolas"; font-size: Theme.font(14); vertical-alignment: center;
                    animate color { duration: Theme.motion-fast; }
                }
                time-touch := TouchArea { mouse-cursor: pointer; clicked => { root.show-remaining = !root.show-remaining; } }
            }
            // Transport state badge; hidden while nothing is loaded.
            status-badge := VerticalLayout { alignment: center; horizontal-stretch: 0;
                property <string> badge: root.busy ? (root.chinese ? "维护中" : "Maintenance")
                    : root.missing ? (root.chinese ? "文件缺失" : "Missing")
                    : root.state == 7 ? (root.chinese ? "出错" : "Error")
                    : root.state == 1 ? (root.chinese ? "加载中" : "Loading")
                    : root.state == 3 ? (root.buffering ? (root.chinese ? "缓冲中" : "Buffering") : (root.chinese ? "播放中" : "Playing"))
                    : root.state == 4 ? (root.chinese ? "已暂停" : "Paused")
                    : root.state == 6 ? (root.chinese ? "已结束" : "Ended")
                    : root.state == 5 ? (root.chinese ? "已停止" : "Stopped")
                    : root.state == 2 ? (root.chinese ? "就绪" : "Ready") : "";
                property <color> tone: root.state == 7 || root.missing ? Theme.danger
                    : root.busy || (root.state == 3 && root.buffering) ? Theme.warning
                    : root.state == 3 ? Theme.accent : Theme.muted;
                if status-badge.badge != "": Rectangle {
                    height: 18px * Theme.ui-scale; border-radius: self.height / 2; horizontal-stretch: 0;
                    background: status-badge.tone.with-alpha(0.14); border-width: 1px; border-color: status-badge.tone.with-alpha(0.45);
                    animate background, border-color { duration: Theme.motion-base; }
                    accessible-role: text; accessible-label: status-badge.badge;
                    HorizontalLayout { padding-left: 7px * Theme.ui-scale; padding-right: 8px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
                        VerticalLayout { alignment: center;
                            Rectangle { width: 6px * Theme.ui-scale; height: self.width; border-radius: self.width / 2; background: status-badge.tone; }
                        }
                        Text { text: status-badge.badge; color: Theme.ink; font-size: Theme.font(10); vertical-alignment: center; accessible-role: none; }
                        if root.repeat: VerticalLayout { alignment: center;
                            Image { source: @image-url("icons/repeat.svg"); colorize: Theme.accent-hover; width: 12px * Theme.ui-scale; height: 12px * Theme.ui-scale; accessible-role: none; }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.player-border; }
            name-text := Text {
                horizontal-stretch: 1; min-width: 0px; text: root.name == "" ? (root.chinese ? "未加载声音" : "No sound loaded") : root.name; overflow: elide; color: Theme.ink; font-size: Theme.font(11); vertical-alignment: center;
                states [
                    fresh when root.name-fresh: {
                        opacity: 0;
                        in { animate opacity { duration: 0ms; } }
                        out { animate opacity { duration: Theme.motion-slow; easing: ease-out; } }
                    }
                ]
            }
            Caption { text: root.info; font-size: Theme.font(10); }
        }
    }
}

export component PeakSettings inherits FocusScope {
    forward-focus: peaks-close;
    focus-on-click: false; focus-on-tab-navigation: false;
    property <bool> reverse-wrap: false;
    capture-key-pressed(event) => {
        if event.text == Key.Escape { root.close(); return accept; }
        if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && peaks-close.has-focus {
            root.reverse-wrap = true; peaks-tab-end.focus(); root.reverse-wrap = false; return reject;
        }
        reject
    }
    key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
    key-released(event) => { accept }
    in property <bool> chinese;
    in-out property <int> mode: 1;
    in-out property <float> gain-db: 0;
    in-out property <float> opacity-value: 0.85;
    in-out property <float> noise: 1;
    in-out property <float> variance: 0.38;
    callback changed(); callback close();
    Rectangle { background: Theme.overlay;
    TouchArea { }
    Rectangle { width: 480px * Theme.ui-scale; height: 384px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 8px * Theme.ui-scale; border-width: 1px; border-color: Theme.strong-border;
        VerticalLayout { padding: 20px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            HorizontalLayout { height: 30px * Theme.ui-scale;
                Text { horizontal-stretch: 1; text: root.chinese ? "波形显示设置" : "Peak display settings"; color: Theme.ink; font-size: Theme.font(17); font-weight: 600; vertical-alignment: center; }
                peaks-close := Tool { symbol: "×"; label: root.chinese ? "关闭" : "Close"; clicked => { root.close(); } }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示增益" : "Display gain"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: -12; maximum: 36; step: 1; value <=> root.gain-db; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: root.gain-db + " dB"; horizontal-alignment: right; }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示模式" : "Display"; }
                ComboBox { horizontal-stretch: 1; model: root.chinese ? ["普通波形", "彩色频谱峰值"] : ["Normal peaks", "Spectral peaks"]; current-index <=> root.mode; selected => { root.changed(); } }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "色彩强度" : "Color opacity"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0; maximum: 1; step: 0.01; value <=> root.opacity-value; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: Math.round(root.opacity-value * 100) + "%"; horizontal-alignment: right; }
            }
            // Muted frequency anchors from audiolib-audio/src/spectral.rs.
            Rectangle { height: 92px * Theme.ui-scale; background: @linear-gradient(90deg, #5bafb5, #707cbe, #b073ab, #c57564, #c0a954, #6fae79, #5bafb5, #707cbe); border-radius: 3px * Theme.ui-scale;
                Rectangle { x: 0px; y: 0px; background: @linear-gradient(180deg, #0e0e0eff, #0e0e0e00); height: 65px * Theme.ui-scale; }
                for frequency[index] in ["14 Hz", "36 Hz", "92 Hz", "239 Hz", "619 Hz", "1604 Hz", "4155 Hz"]: Text { x: 4px * Theme.ui-scale + index * (parent.width - 8px * Theme.ui-scale) / 7; y: 69px * Theme.ui-scale; height: 20px * Theme.ui-scale; text: frequency; color: #101820; font-size: Theme.font(10); font-weight: 600; vertical-alignment: center; }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Caption { text: root.chinese ? "噪声阈值" : "Noise threshold"; width: 80px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.1; maximum: 2; step: 0.05; value <=> root.noise; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.noise*100)/100; }
                Caption { text: root.chinese ? "频率分散" : "Variance"; width: 68px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.05; maximum: 1; step: 0.01; value <=> root.variance; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.variance*100)/100; }
            }
            Caption { text: root.chinese ? "黑色表示非音调内容；颜色随主频变化。显示增益不改变音量。" : "Noise fades to black; tones show frequency. Display gain is visual only."; font-size: Theme.font(10); }
        }
    }
    }
    peaks-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !root.reverse-wrap { peaks-close.focus(); } } }
}

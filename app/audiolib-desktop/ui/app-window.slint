// app/audiolib-desktop/ui/app-window.slint
import { TextEdit, ComboBox, ListView, ScrollView, Palette } from "std-widgets.slint";

import { Theme, ThemedLineEdit as LineEdit, ThemedCheckBox as CheckBox } from "theme.slint";

import { AuditionPanel, PeakSettings } from "audition-panel.slint";

export struct AudioRow {
    id: string,
    file-path: string,
    name: string,
    folder: string,
    duration: string,
    format: string,
    channels: string,
    tags: string,
    favorite: bool,
    missing: bool,
    checked: bool,
    marker: color,
}
export struct FolderRow { name: string, count: string, path: string, depth: int, expanded: bool, has-children: bool }
export struct CrumbRow { name: string }
// One server scan root in the data-source dialog: `url` is the editable WebDAV URL
// (pre-filled with the user's override or the server suggestion `server-url`).
// One row of the unified window's source list: kind 0 = the local library (always row 0),
// 1 = a saved server profile. status-kind: 0 unknown, 1 ok, 3 failed.
export struct SourceRow { id: string, name: string, subtitle: string, kind: int, active: bool, status: string, status-kind: int }
// One server root on the 服务器音效库 page (GET /roots).
export struct ServerRootRow { name: string, path: string, status: string, offline: bool, scanning: bool, file-count: string, missing: string, last-scan: string, message: string }
export struct DataRootRow { name: string, server-path: string, server-url: string, url: string, source: string, status: string, offline: bool }
export struct RemoteFolderRow { name: string, path: string }
export struct RemoteBreadcrumbRow { name: string, path: string }

component Action inherits Rectangle {
    in property <string> label;
    in property <string> action-label: root.label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> subtle: false;
    in property <bool> dropdown: false;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked;
    min-width: 36px;
    min-height: 30px;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: button-focus;
    border-radius: 5px;
    background: root.primary ? (hit.has-hover ? Theme.accent-hover : Theme.accent) : (root.active ? Theme.selected : (hit.has-hover ? Theme.hover : (root.subtle ? transparent : Theme.raised)));
    border-width: 1px;
    border-color: button-focus.has-focus || root.active ? Theme.accent : (root.subtle ? transparent : Theme.border);
    opacity: root.enabled ? 1 : 0.42;
    Text { width: parent.width - (root.dropdown ? 18px : 0px); text: root.label; color: root.primary ? Theme.on-accent : Theme.ink; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
    if root.dropdown: Image { source: @image-url("icons/chevron-down.svg"); colorize: Theme.ink; width: 10px; height: 6px; x: parent.width - 16px; y: (parent.height - self.height) / 2; accessible-role: none; }
    button-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Label inherits Text { color: Theme.dim; font-size: 11px; vertical-alignment: center; }

// A remote directory is a keyboard-accessible navigation action, never a local path.
component RemoteFolderAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the picker row with Space/Return.
    in property <bool> keyboard-active: true;
    callback clicked();
    height: 36px;
    min-width: 180px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: folder-focus;
    border-radius: 4px;
    background: folder-hit.has-hover || folder-focus.has-focus ? Theme.hover : transparent;
    border-width: folder-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.42;
    Rectangle { x: 12px; y: 12px; width: 7px; height: 4px; border-width: 1px; border-color: Theme.dim; border-radius: 1px; }
    Rectangle { x: 12px; y: 15px; width: 16px; height: 11px; background: Theme.panel; border-width: 1px; border-color: Theme.dim; border-radius: 2px; }
    Text { x: 40px; width: parent.width - 52px; height: parent.height; text: root.label; color: Theme.ink; font-size: 12px; vertical-alignment: center; overflow: elide; }
    folder-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    folder-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Source tags remain selectable while compact views avoid TextEdit's large padding.
component SourceTags inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <string> displayed-id;
    changed displayed-id => {
        tags-input.set-selection-offsets(0, 0);
        tags-scroll.viewport-y = 0px;
    }
    background: Theme.raised;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    tags-scroll := ScrollView {
        x: 6px; y: 2px; width: parent.width - 12px; height: parent.height - 4px;
        viewport-width: self.visible-width;
        VerticalLayout { padding: 0px; alignment: start;
            tags-input := TextInput {
                accessible-label: root.label;
                text: root.text; read-only: true; single-line: false; wrap: word-wrap;
                page-height: tags-scroll.visible-height;
                font-size: 11px; color: Theme.ink;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                cursor-position-changed(position) => {
                    // Keep keyboard selection visible inside the tag viewport.
                    if position.y + tags-scroll.viewport-y < 0px {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, -position.y));
                    } else if position.y + tags-scroll.viewport-y > tags-scroll.visible-height - 20px {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, tags-scroll.visible-height - position.y - 20px));
                    }
                }
            }
        }
    }
}

// Absolute pointer coordinates stay stable while the divider itself moves.
component PaneDivider inherits Rectangle {
    in property <length> pane-width;
    in property <bool> reverse: false;
    in property <bool> enabled: true;
    in property <string> label;
    callback resized(length);
    private property <length> pressed-pointer-x;
    private property <length> pressed-pane-width;
    width: 12px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    forward-focus: divider-focus;
    Rectangle {
        x: 5px; width: 2px; y: 10px; height: parent.height - 20px; border-radius: 1px;
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : (drag-area.has-hover ? Theme.dim : Theme.border);
    }
    divider-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                let step = event.text == Key.LeftArrow ? -16px : 16px;
                root.resized(root.pane-width + (root.reverse ? -step : step));
                return accept;
            }
            reject
        }
    }
    drag-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                divider-focus.focus();
                root.pressed-pointer-x = self.absolute-position.x + self.mouse-x;
                root.pressed-pane-width = root.pane-width;
            }
        }
        moved => {
            if self.pressed {
                let delta = self.absolute-position.x + self.mouse-x - root.pressed-pointer-x;
                root.resized(root.pressed-pane-width + (root.reverse ? -delta : delta));
            }
        }
    }
}

// Sortable column actions keep the same keyboard behavior as ordinary actions.
component TableHeader inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <string> help;
    in property <bool> active: false;
    in property <bool> descending: false;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the header with Space/Return.
    in property <bool> keyboard-active: true;
    callback clicked();
    callback context-requested(Point);
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-value: root.active ? (root.descending ? "descending" : "ascending") : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: header-focus;
    background: header-hit.has-hover ? Theme.hover : transparent;
    border-width: header-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    Text {
        x: 8px; width: max(0px, parent.width - (root.active ? 26px : 16px)); height: parent.height;
        text: root.label; font-size: 10px; font-weight: root.active ? 600 : 400;
        color: root.active ? Theme.ink : Theme.dim; overflow: elide; vertical-alignment: center;
    }
    if root.active: Text {
        x: parent.width - 14px; width: 10px; height: parent.height;
        text: root.descending ? "▼" : "▲"; color: Theme.accent;
        font-size: 9px; vertical-alignment: center; horizontal-alignment: center;
    }
    Tooltip { text: @markdown("\{root.help}"); }
    header-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-requested({x: self.absolute-position.x, y: self.absolute-position.y + self.height});
                return accept;
            }
            reject
        }
    }
    header-hit := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                header-focus.focus();
                root.context-requested({x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y});
            }
        }
    }
}

// Store the absolute press position because a resized column moves its divider.
// Slint reports a press within the double-click interval and 10 px of the previous
// press as a double click on its release, even after a drag; only two presses that
// did not drag may reset the column, or a click followed by a drag loses the width.
component TableDivider inherits Rectangle {
    in property <length> column-width;
    in property <string> label;
    in property <string> help;
    in property <bool> enabled: true;
    callback resized(length);
    callback finished();
    callback reset();
    private property <length> pressed-pointer-x;
    private property <length> pressed-column-width;
    private property <bool> dragged;
    private property <bool> previous-dragged;
    width: 8px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: root.column-width / 1px + " px";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.reset(); } }
    forward-focus: divider-focus;
    Rectangle {
        x: 3px; width: 1px; y: 7px; height: max(0px, parent.height - 14px);
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : (drag-area.has-hover ? Theme.dim : Theme.border);
    }
    Tooltip { text: @markdown("\{root.label}. \{root.help}"); }
    divider-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.resized(root.column-width + (event.text == Key.LeftArrow ? -16px : 16px));
                root.finished();
                return accept;
            }
            if event.text == Key.Home { root.reset(); return accept; }
            reject
        }
    }
    drag-area := TouchArea {
        enabled: root.enabled; mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                divider-focus.focus();
                root.previous-dragged = root.dragged;
                root.dragged = false;
                root.pressed-pointer-x = self.absolute-position.x + self.mouse-x;
                root.pressed-column-width = root.column-width;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.column-width != root.pressed-column-width { root.finished(); }
        }
        moved => {
            if self.pressed {
                let delta = self.absolute-position.x + self.mouse-x - root.pressed-pointer-x;
                if abs(delta) > 2px { root.dragged = true; }
                root.resized(root.pressed-column-width + delta);
            }
        }
        // Slint calls this before the release pointer event, so `dragged` is this press.
        double-clicked => { if !root.dragged && !root.previous-dragged { root.reset(); } }
    }
}

component HelpPanel inherits FocusScope {
    in property <bool> chinese;
    callback close();
    focus-on-click: false;
    focus-on-tab-navigation: false;
    init => { self.focus(); }
    capture-key-pressed(event) => {
        if event.text == Key.Tab || event.text == Key.Backtab {
            close-action.focus();
            return accept;
        }
        reject
    }
    key-pressed(event) => {
        if event.text == Key.Escape { root.close(); }
        accept
    }
    key-released(event) => { accept }
    Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 640px; height: 470px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 28px; spacing: 16px;
                Text { text: root.chinese ? "快捷键与基本操作" : "Shortcuts and basics"; color: Theme.ink; font-size: 23px; font-weight: 600; }
                Text { text: root.chinese ? "Ctrl Shift I   添加声音文件夹     ·     Ctrl D   音效库管理\nCtrl F   搜索     ·     Ctrl S   保存 Metadata\nCtrl I   显示 / 隐藏详情     ·     F5   刷新素材库\nCtrl Q   保存草稿并退出     ·     Esc   关闭当前面板" : "Ctrl Shift I   Add sound folder     ·     Ctrl D   Manage sound library\nCtrl F   Search     ·     Ctrl S   Save Metadata\nCtrl I   Show / hide details     ·     F5   Refresh library\nCtrl Q   Save drafts and exit     ·     Esc   Close current panel"; color: Theme.ink; wrap: word-wrap; }
                Text { text: root.chinese ? "新增声音：通过文件菜单添加文件夹，扫描其中的 WAV / BWF。\n批量编辑：Ctrl 单击切换选择，Shift 单击连续选择，再使用批量标注。\n移除：编辑菜单可移除所选记录、选择记录或当前目录；仅删除数据库记录及标注，磁盘上的 WAV 会保留。" : "Add sounds: use File to add a folder and scan its WAV / BWF files.\nBatch edit: Ctrl-click to toggle or Shift-click to select a range, then choose Edit selected records in Edit.\nRemove: Edit can remove the selected record, selected records or current folder. Library records and annotations are removed; WAV files remain on disk."; color: Theme.dim; wrap: word-wrap; }
                Text { text: root.chinese ? "日常更新用增量扫描；整理文件后用全量扫描检查缺失。\n修复引用：音效库 → 查看缺失文件，选中声音后在详情面板选择新位置。标签和备注会保留。\n备份与数据库维护收在音效库管理底部的“高级维护”中。" : "Use incremental scans for daily updates; full scans check missing files after reorganizing a folder.\nRepair: Library → Missing files, select a sound, then locate it in Sound details. Annotations are kept.\nBackups and database tools are under Advanced maintenance in library management."; color: Theme.dim; wrap: word-wrap; }
                close-action := Action { height: 34px; primary: true; label: root.chinese ? "关闭" : "Close"; clicked => { root.close(); } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AudioLib Explorer";
    icon: @image-url("../../../resources/icons/AudioLibExplorer.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1080px;
    min-height: 700px;
    max-width: 32767px;
    max-height: 32767px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 12px;

    in property <string> app-version: "development";
    // Explicit diagnostics only: the compositor observer identifies the exact
    // request and publication phase from pixels, without encoding user text.
    in property <bool> perf-marker-enabled: false;
    in property <[bool]> perf-marker-bits;
    // The diagnostic runner aligns these lengths to whole physical pixels at
    // the observed DPI; fractional display scales must not shift bit centers.
    in property <length> perf-marker-cell-width: 3px;
    in property <length> perf-marker-cell-height: 6px;
    in property <length> perf-marker-x: root.width - 196px;
    in property <length> perf-marker-y: root.height - 16px;
    out property <length> perf-marker-parent-x: shortcuts.absolute-position.x;
    out property <length> perf-marker-parent-y: shortcuts.absolute-position.y;
    out property <length> perf-marker-actual-client-x;
    out property <length> perf-marker-actual-client-y;
    public function perf-focus-search() {
        if root.perf-marker-enabled { search-input.focus(); }
    }
    in property <bool> startup-busy: false;
    in property <string> startup-message;
    in property <string> startup-stage;
    in property <string> startup-elapsed;
    in property <bool> startup-closing;
    // Negative means unknown total. Percentages refer only to the current stage.
    in property <float> startup-progress: -1;
    in property <float> startup-motion;
    in-out property <bool> chinese: false;
    in-out property <string> query: "";
    in-out property <string> scan-path: "";
    in property <bool> scan-browse-busy: false;
    in-out property <bool> scan-validating: false;
    in-out property <string> scan-error: "";
    in property <string> scan-summary: "";
    in property <string> scan-current-path: "";
    in property <bool> scan-paused: false;
    in property <bool> scan-cancelling: false;
    in property <bool> scan-finalizing: false;
    private property <bool> scan-controllable: root.scanning && !root.scan-cancelling && !root.scan-finalizing && !root.closing && !root.library-busy;
    in property <string> library-health: "";
    in-out property <int> selected-row: -1;
    private property <length> result-row-height: 32px;
    in-out property <int> selected-folder: -1;
    in property <string> selected-folder-path: "";
    in property <[AudioRow]> rows;
    // Keep menu dependencies independent of result-model identity changes.
    // The controller updates this stored value only on empty/nonempty transitions.
    in property <bool> menu-has-page-rows: false;
    in property <[FolderRow]> folders;
    in property <[CrumbRow]> crumbs;
    in property <string> library-summary: "";
    in property <string> result-summary: "";
    in property <string> status: "";
    in property <bool> searching: false;
    in property <bool> scanning: false;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    in property <string> page-label: "1";
    in-out property <bool> favorites-only: false;
    in-out property <bool> tagged-only: false;
    in-out property <string> tag-filter: "";
    in-out property <string> color-filter: "";
    in-out property <int> sample-filter: 0;
    in-out property <int> bit-filter: 0;
    in-out property <int> channel-filter: 0;
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-descending: false;
    // Preferred widths are logical pixels and remain directly customizable.
    in-out property <float> table-name-width: 360;
    in-out property <float> table-duration-width: 80;
    in-out property <float> table-format-width: 100;
    in-out property <float> table-channels-width: 64;
    in-out property <float> table-tags-width: 160;
    private property <length> table-duration-size: clamp(root.table-duration-width, 60, 2000) * 1px;
    private property <length> table-format-size: clamp(root.table-format-width, 82, 2000) * 1px;
    private property <length> table-channels-size: clamp(root.table-channels-width, 48, 2000) * 1px;
    private property <length> table-tags-size: clamp(root.table-tags-width, 80, 2000) * 1px;
    private property <length> table-name-size: clamp(root.table-name-width, 120, 2000) * 1px;
    private property <length> table-columns-size: root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size + root.table-tags-size;
    private property <length> table-content-size: max(root.table-columns-size, result-list.visible-width);
    private property <bool> table-empty: root.rows.length == 0;
    private property <length> table-viewport-x;
    private property <string> table-resize-help: root.chinese ? "拖动调整列宽；双击或 Home 恢复默认；方向键微调" : "Drag to resize; double-click or Home to reset; arrow keys adjust width";
    callback table-layout-changed();
    in-out property <string> duration-min: "";
    in-out property <string> duration-max: "";

    in property <string> selected-name: "";
    in property <string> selected-path: "";
    in property <string> selected-format: "";
    in property <string> selected-description: "";
    in property <string> selected-source-tags: "";
    in property <string> selected-attributes: "";
    in property <bool> has-selection: false;
    in property <bool> audio-ready: false;
    in-out property <string> edit-tags: "";
    in-out property <string> edit-notes: "";
    in-out property <bool> edit-favorite: false;
    in-out property <bool> metadata-dirty: false;
    in property <bool> closing: false;
    in property <bool> selected-missing: false;
    in property <bool> library-busy: false;
    in-out property <bool> library-visible: false;
    in-out property <bool> advanced-maintenance-visible: false;
    in property <string> database-path: "";
    in property <string> database-info: "";
    in property <string> management-report: "";
    in property <string> history-detail: "";
    in property <string> library-feedback: "";
    in-out property <int> visibility-index: 0;
    in-out property <int> scan-mode: 0;
    in property <int> checked-count: 0;
    in-out property <bool> batch-visible: false;
    in-out property <bool> batch-tags-enabled: false;
    in-out property <string> batch-tags: "";
    in-out property <int> batch-tag-mode: 0;
    in-out property <int> batch-favorite: 0;
    in-out property <bool> batch-color-enabled: false;
    in-out property <string> batch-color: "";
    in-out property <bool> batch-notes-enabled: false;
    in-out property <string> batch-notes: "";
    in-out property <int> history-kind: 0;
    in property <[string]> history-rows;
    in property <string> history-page: "1";
    in property <bool> history-previous: false;
    in property <bool> history-next: false;
    in-out property <bool> confirmation-visible: false;
    in property <string> confirmation-text: "";
    callback library-action(int);
    callback confirmation-requested(bool);
    // The final flag requests playback only for an ordinary pointer click.
    callback row-clicked(int, bool, bool, bool);
    callback check-page-requested(bool);
    callback batch-requested();
    callback history-requested(int);
    callback history-selected(int);

    in-out property <bool> peaks-visible: false;
    in-out property <int> peak-mode: 1;
    in-out property <float> peak-gain: 0;
    in-out property <float> peak-opacity: 0.85;
    in-out property <float> peak-noise: 1;

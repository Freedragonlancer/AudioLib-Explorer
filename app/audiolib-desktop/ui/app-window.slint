    // [保存] in the unsaved-edit prompt; the argument is the row to open afterwards.
    callback sm-pending-save-requested(int);
    public function close-library-manager() {
        if root.ds-applying || root.library-busy || root.sm-manage-busy || root.closing { return; }
        if root.ds-dirty && root.sm-server {
            root.sm-pending-select = -3;
        } else {
            root.library-visible = false;
        }
    }
    function sm-discard-pending() {
        root.ds-dirty = false;
        if root.sm-pending-select == -3 {
            root.sm-pending-select = -2;
            root.library-visible = false;
        } else {
            root.sm-apply-select(root.sm-pending-select);
        }
    }
    // Select a source row (click, Up/Down, 添加服务器): unsaved 连接 edits prompt first.
    public function sm-select-row(index: int) {
        if index == root.sm-selected || root.ds-applying || root.library-busy || root.sm-manage-busy {
            return;
        }
        if root.ds-dirty && root.sm-server {
            root.sm-pending-select = index;
            return;
        }
        root.sm-apply-select(index);
    }
    function sm-apply-select(index: int) {
        root.sm-pending-select = -2;
        root.sm-confirm-delete = false;
        root.sm-confirm = 0;
        root.sm-scan-form = false;
        root.sm-root-form = false;
        root.sm-root-selected = -1;
        root.close-remote-folder();
        root.sm-selected = index;
        root.sm-page = 0;
        if index < 0 {
            root.sm-add-requested();
        } else {
            root.sm-source-selected(index);
        }
    }
    public function sm-step(down: bool) {
        if root.sm-pending-select != -2 {
            return;
        }
        if root.sm-selected < 0 {
            if !down {
                root.sm-select-row(root.sm-sources.length - 1);
            }
        } else if down {
            if root.sm-selected + 1 < root.sm-sources.length {
                root.sm-select-row(root.sm-selected + 1);
            }
        } else if root.sm-selected > 0 {
            root.sm-select-row(root.sm-selected - 1);
        }
    }
    public function open-data-source() {
        root.advanced-maintenance-visible = false;
        root.sm-confirm-delete = false;
        root.sm-pending-select = -2;
        root.sm-confirm = 0;
        root.sm-scan-form = false;
        root.sm-root-form = false;
        root.close-remote-folder();
        root.library-visible = true;
        root.sm-open-requested(0);
        root.schedule-modal-focus();
    }
    function open-batch() {
        if !root.remote-writes-blocked { root.batch-visible = true; }
    }

    // Menu targets are immutable IDs/paths captured when opened, never row positions.
    private property <length> content-width: 1408px;
    property <bool> wide-layout: root.content-width - root.sidebar-width - (root.inspector-visible ? root.inspector-width + 24px : 12px) >= 720px;
    property <bool> short-layout: false;
    changed height => { root.short-layout = self.height < 800px; }
    changed width => { root.content-width = self.width - 32px; }
    // Preferred widths survive temporary window constraints and inspector hiding.
    in-out property <length> sidebar-preferred-width: 198px;
    in-out property <length> inspector-preferred-width: 320px;
    private property <length> sidebar-budget: root.content-width - 520px - (root.inspector-visible ? 24px : 12px);
    out property <length> sidebar-width: clamp(root.sidebar-preferred-width, 170px, min(480px, root.sidebar-budget - (root.inspector-visible ? 240px : 0px)));
    out property <length> inspector-width: clamp(root.inspector-preferred-width, 240px, min(600px, root.sidebar-budget - root.sidebar-width));
    in-out property <bool> filters-visible: false;
    in-out property <bool> inspector-visible: true;
    in-out property <bool> import-visible: false;
    in-out property <bool> notes-visible: false;
    in-out property <bool> source-metadata-visible: false;
    changed selected-id => { root.notes-visible = false; root.source-metadata-visible = false; }
    // A native menu remains outside the in-window overlays. Guard its items and
    // shortcuts too, so modal dialogs cannot launch overlapping operations.
    property <bool> menu-ready: !root.startup-busy && !root.closing && !root.library-busy && !root.library-visible && !root.confirmation-visible && !root.batch-visible && !root.import-visible && !root.settings-visible && !root.peaks-visible && !root.about-visible && !root.help-visible && !root.debug-visible;
    property <bool> background-blocked: root.startup-busy || root.closing || root.library-busy || root.library-visible || root.confirmation-visible || root.batch-visible || root.import-visible || root.settings-visible || root.peaks-visible || root.about-visible || root.help-visible || root.debug-visible;
    in property <string> selected-id: "";
    property <AudioRow> context-file;
    property <FolderRow> context-folder;
    property <int> filter-count: (root.sample-filter > 0 ? 1 : 0) + (root.bit-filter > 0 ? 1 : 0) + (root.channel-filter > 0 ? 1 : 0) + (root.tagged-only ? 1 : 0) + (root.tag-filter != "" ? 1 : 0) + (root.color-filter != "" ? 1 : 0) + (root.duration-min != "" || root.duration-max != "" ? 1 : 0);
    callback file-action-requested(string, int);
    callback folder-action-requested(string, int);
    callback selection-step-requested(int);
    // Keep the native menu state stable when a search crosses an empty page.
    // Slint's Windows menu rebuild temporarily disables native window redraw.
    public function check-current-page() {
        if root.menu-ready && root.menu-has-page-rows {
            root.check-page-requested(true);
        }
    }
    public function open-library(kind: int) { root.open-source-manager(kind, 1); }
    // 扫描历史 / 最近播放: the open library's history (local, or the active snapshot's).
    public function open-history(kind: int) { root.open-source-manager(kind, 2); }
    function open-source-manager(kind: int, focus: int) {
        root.advanced-maintenance-visible = false;
        root.history-kind = kind;
        root.sm-confirm-delete = false;
        root.sm-pending-select = -2;
        root.sm-confirm = 0;
        root.sm-scan-form = false;
        root.sm-root-form = false;
        root.close-remote-folder();
        root.library-visible = true;
        root.library-action(0);
        root.sm-open-requested(focus);
        root.schedule-modal-focus();
    }
    public function prepare-scan(mode: int, path: string) {
        if root.remote-mode { root.remote-write-refused(); return; }
        root.scan-mode = mode;
        root.scan-path = path;
        root.scan-error = "";
        root.library-visible = false;
        root.import-visible = true;
        root.schedule-modal-focus();
    }
    function cancel-scan-dialog() {
        if !root.scan-browse-busy && !root.library-busy && !root.closing {
            if root.scan-validating { root.scan-cancel-requested(); }
            root.import-visible = false;
        }
    }
    function dismiss-modal() {
        if root.closing || root.library-busy { return; }
        if root.sm-fs-visible { root.close-remote-folder(); }
        else if root.library-visible && root.sm-root-form && !root.sm-manage-busy { root.sm-root-form = false; }
        else if root.library-visible && root.sm-confirm == 5 && !root.sm-manage-busy { root.sm-confirm = 0; }
        else if root.peaks-visible { root.peaks-visible = false; }
        else if root.confirmation-visible { root.confirmation-requested(false); }
        else if root.batch-visible { root.batch-visible = false; }
        else if root.library-visible && !root.ds-applying {
            if root.sm-pending-select != -2 { root.sm-pending-select = -2; }
            else { root.close-library-manager(); }
        }
        else if root.import-visible { root.cancel-scan-dialog(); }
        else if root.about-visible { root.about-visible = false; }
        else if root.help-visible { root.help-visible = false; }
        else if root.debug-visible { root.debug-visible = false; }
        else if root.settings-visible && !root.output-applying { root.settings-visible = false; }
        else { root.filters-visible = false; }
    }
    function focus-library-modal() {
        if root.debug-visible && !root.closing {
            debug-close-action.focus();
        } else if root.sm-fs-visible && !root.closing {
            remote-folder-cancel-action.focus();
        } else if root.confirmation-visible && !root.library-busy && !root.closing {
            confirmation-cancel-action.focus();
        } else if root.import-visible && !root.library-busy && !root.closing {
            if root.scanning || root.scan-browse-busy { scan-cancel-action.focus(); }
            else { scan-path-input.focus(); }
        } else if root.library-visible && !root.confirmation-visible && !root.library-busy && !root.closing {
            library-close-action.focus();
        }
    }
    function close-remote-folder() {
        if root.sm-fs-visible {
            root.sm-fs-visible = false;
            root.sm-fs-closed();
        }
    }
    public function show-missing-files() {
        root.library-visible = false;
        root.query = "";
        root.favorites-only = false;
        root.tagged-only = false;
        root.tag-filter = "";
        root.color-filter = "";
        root.sample-filter = 0;
        root.bit-filter = 0;
        root.channel-filter = 0;
        root.duration-min = "";
        root.duration-max = "";
        root.visibility-index = 1;
        root.inspector-visible = true;
        root.all-library-requested();
    }
    public function show-file-menu(row: AudioRow, position: Point) {
        root.context-file = row;
        file-menu.show({x: position.x - file-menu.absolute-position.x, y: position.y - file-menu.absolute-position.y});
    }
    function sort-table(index: int) {
        root.sort-descending = index != 0 && root.sort-index == index ? !root.sort-descending : false;
        root.sort-index = index;
        root.filter-requested();
        root.table-layout-changed();
    }
    function resize-table-column(index: int, width: length) {
        if index == 1 { root.table-name-width = clamp(width / 1px, 120, 2000); }
        if index == 2 { root.table-duration-width = clamp(width / 1px, 60, 2000); }
        if index == 3 { root.table-format-width = clamp(width / 1px, 82, 2000); }
        if index == 4 { root.table-channels-width = clamp(width / 1px, 48, 2000); }
        if index == 5 { root.table-tags-width = clamp(width / 1px, 80, 2000); }
    }
    function reset-table-widths() {
        root.table-name-width = 360;
        root.table-duration-width = 80;
        root.table-format-width = 100;
        root.table-channels-width = 64;
        root.table-tags-width = 160;
        root.table-viewport-x = 0px;
        root.sync-table-viewport();
        root.table-layout-changed();
    }
    function show-table-menu(position: Point) {
        table-menu.show({x: position.x - table-menu.absolute-position.x, y: position.y - table-menu.absolute-position.y});
    }
    public function show-folder-menu(folder: FolderRow, position: Point) {
        root.context-folder = folder;
        folder-menu.show({x: position.x - folder-menu.absolute-position.x, y: position.y - folder-menu.absolute-position.y});
    }
    function file-action(action: int) { root.file-action-requested(root.context-file.id, action); }
    public function copy-text(value: string) {
        clipboard-input.text = value;
        clipboard-input.select-all();
        clipboard-input.copy();
    }
    function reveal-selected-row() {
        if root.selected-row >= 0 && root.selected-row < root.rows.length {
            if root.selected-row * root.result-row-height < -result-list.viewport-y { result-list.viewport-y = -root.selected-row * root.result-row-height; }
            else if (root.selected-row + 1) * root.result-row-height > -result-list.viewport-y + result-list.visible-height { result-list.viewport-y = result-list.visible-height - (root.selected-row + 1) * root.result-row-height; }
        }
    }
    changed selected-row => { root.reveal-selected-row(); }
    changed rows => { result-list.viewport-y = 0px; root.reveal-selected-row(); }
    function sync-table-viewport() {
        // Avoid writing an unchanged value back during the wheel animation.
        if root.table-empty {
            if empty-result-list.viewport-x != root.table-viewport-x { empty-result-list.viewport-x = root.table-viewport-x; }
        } else {
            if result-list.viewport-x != root.table-viewport-x { result-list.viewport-x = root.table-viewport-x; }
        }
    }
    changed table-empty => { root.sync-table-viewport(); }
    changed table-viewport-x => { root.sync-table-viewport(); }
    changed table-content-size => {
        root.table-viewport-x = clamp(root.table-viewport-x, min(0px, result-list.visible-width - root.table-content-size), 0px);
        root.sync-table-viewport();
    }
    changed help-visible => { if !root.help-visible && !root.background-blocked { results-focus.focus(); } }
    changed debug-visible => { if root.debug-visible { root.schedule-modal-focus(); } else if !root.background-blocked { results-focus.focus(); } }
    changed import-visible => { if root.import-visible { root.schedule-modal-focus(); } else if !root.background-blocked { results-focus.focus(); } }
    changed library-visible => {
        if root.library-visible { root.schedule-modal-focus(); }
        else {
            root.sm-confirm-delete = false;
            root.sm-root-form = false;
            root.close-remote-folder();
            root.sm-closed();
            if !root.background-blocked { results-focus.focus(); }
        }
    }
    changed sm-fs-visible => {
        if root.sm-fs-visible { root.sm-fs-path-draft = root.sm-fs-path; }
        if root.library-visible { root.schedule-modal-focus(); }
    }
    changed sm-root-form => { if root.library-visible { root.schedule-modal-focus(); } }
    changed confirmation-visible => {
        if root.confirmation-visible {
            // Controller confirmations arrive outside menu activation. Focus safe
            // Cancel immediately, then reassert it after any native popup closes.
            root.focus-library-modal();
            root.schedule-modal-focus();
        } else if root.library-visible { root.schedule-modal-focus(); }
        else if !root.background-blocked { results-focus.focus(); }
    }
    changed scanning => { if root.import-visible { root.schedule-modal-focus(); } }
    changed library-busy => { if !root.library-busy && (root.import-visible || root.library-visible || root.confirmation-visible) { root.schedule-modal-focus(); } }
    function schedule-modal-focus() {
        modal-focus-timer.running = true;
        modal-focus-timer.restart();
    }
    // Menu dismissal restores the old input focus after its activated callback.
    // Defer once past dismissal; zero-interval timers can expire again before
    // running=false is applied, repeatedly stealing focus from modal editors.
    modal-focus-timer := Timer {
        running: false;
        interval: 1ms;
        triggered => {
            if self.running {
                self.running = false;
                root.focus-library-modal();
            }
        }
    }
    clipboard-input := TextInput { visible: false; }
    init => { Palette.color-scheme = ColorScheme.dark; root.content-width = self.width - 32px; }
    MenuBar {
        Menu { title: root.chinese ? "文件" : "File"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "Debug 模式 · 记录诊断" : "Debug mode · capture diagnostics"; enabled: root.menu-ready && !root.debug-busy; checkable: true; checked: root.debug-enabled; activated => { root.debug-mode-requested(!root.debug-enabled); } }
            MenuItem { title: root.chinese ? "反馈问题 / 诊断报告…" : "Report a bug / diagnostics…"; enabled: root.menu-ready; activated => { root.debug-visible = true; } }
            MenuItem { title: root.chinese ? "打开日志目录" : "Open log folder"; enabled: root.menu-ready; activated => { root.debug-action-requested(2); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "退出" : "Exit"; enabled: root.menu-ready; shortcut: @keys(Control + Q); activated => { root.exit-requested(); } }
        }
        Menu { title: root.chinese ? "编辑" : "Edit"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "查看 / 编辑 Metadata" : "View / edit Metadata"; enabled: root.menu-ready && root.has-selection; activated => { root.inspector-visible = true; } }
            MenuItem { title: (root.chinese ? "保存 Metadata" : "Save Metadata"); enabled: root.menu-ready && root.has-selection && root.metadata-dirty; shortcut: @keys(Control + S); activated => { root.save-metadata-requested(); } }
            MenuItem { title: (root.chinese ? "批量标注选择记录…" : "Edit selected records…"); enabled: root.menu-ready && root.checked-count > 0; activated => { root.open-batch(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "选择当前页" : "Check current page"; enabled: root.menu-ready; activated => { root.check-current-page(); } }
            MenuItem { title: root.chinese ? "清除全部选择" : "Clear selection"; enabled: root.menu-ready && root.checked-count > 0; activated => { root.check-page-requested(false); } }
            MenuItem { title: (root.edit-favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "添加到收藏" : "Add to favorites")); enabled: root.menu-ready && root.has-selection && !root.remote-writes-blocked; activated => { root.file-action-requested(root.selected-id, 5); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "复制所选文件路径" : "Copy selected file path"; enabled: root.menu-ready && root.has-selection; activated => { root.copy-text(root.selected-path); } }
            MenuItem { title: (root.chinese ? "在资源管理器中定位" : "Reveal in Explorer") + root.ro-suffix; enabled: root.menu-ready && root.has-selection && !root.remote-mode; activated => { root.file-action-requested(root.selected-id, 2); } }
            MenuItem { title: (root.chinese ? "修复所选文件引用…" : "Repair selected file reference…") + root.ro-suffix; enabled: root.menu-ready && root.has-selection && !root.remote-mode; activated => { root.file-action-requested(root.selected-id, 20); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "移除所选记录（保留 WAV）…" : "Remove selected record (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.has-selection && root.removal-allowed; activated => { root.file-action-requested(root.selected-id, 21); } }
            MenuItem { title: (root.chinese ? "移除选择记录（保留 WAV）…" : "Remove selected records (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.checked-count > 0 && root.removal-allowed; activated => { root.library-action(11); } }
            MenuItem { title: (root.chinese ? "移除当前目录（保留 WAV）…" : "Remove current folder (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.selected-folder-path != "" && root.removal-allowed; activated => { root.folder-action-requested(root.selected-folder-path, 1); } }
        }
        Menu { title: root.chinese ? "音效库" : "Library"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "音效库管理…" : "Manage sound library…"; enabled: root.menu-ready; shortcut: @keys(Control + D); activated => { root.open-library(0); } }
            MenuItem { title: root.chinese ? "查看缺失文件 / 修复引用" : "Missing files / repair references"; enabled: root.menu-ready; activated => { root.show-missing-files(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "扫描历史…" : "Scan history…"; enabled: root.menu-ready; activated => { root.open-history(0); } }
            MenuItem { title: root.chinese ? "最近播放…" : "Recent playback…"; enabled: root.menu-ready; activated => { root.open-history(1); } }
        }
        Menu { title: root.chinese ? "扫描" : "Scan"; enabled: root.menu-ready;
            MenuItem { title: (root.chinese ? "增量扫描文件夹…" : "Incremental folder scan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; shortcut: @keys(Control + Shift + I); activated => { root.prepare-scan(0, ""); } }
            MenuItem { title: (root.chinese ? "全量扫描文件夹…" : "Full folder rescan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; activated => { root.prepare-scan(1, ""); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "增量扫描当前目录" : "Incremental scan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(0, root.selected-folder-path); } }
            MenuItem { title: (root.chinese ? "全量扫描当前目录" : "Full rescan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(1, root.selected-folder-path); } }
            MenuSeparator { }
            MenuItem { title: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); enabled: root.menu-ready && root.scan-controllable && !root.scan-validating; activated => { root.scan-pause-requested(); } }
            MenuItem { title: root.chinese ? "取消当前扫描" : "Cancel current scan"; enabled: root.menu-ready && root.scan-controllable; activated => { root.scan-cancel-requested(); } }
            MenuItem { title: root.chinese ? "刷新素材库" : "Refresh library"; enabled: root.menu-ready; shortcut: @keys(F5); activated => { root.refresh-requested(); } }
        }
        Menu { title: root.chinese ? "视图" : "View"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "搜索" : "Search"; enabled: root.menu-ready; shortcut: @keys(Control + F); activated => { search-input.focus(); } }
            MenuItem { title: root.chinese ? "显示详情面板" : "Show details panel"; enabled: root.menu-ready; shortcut: @keys(Control + I); checkable: true; checked <=> root.inspector-visible; }
            MenuItem { title: root.chinese ? "显示筛选面板" : "Show filters panel"; enabled: root.menu-ready; checkable: true; checked <=> root.filters-visible; }
            MenuItem { title: root.chinese ? "重置筛选" : "Reset filters"; enabled: root.menu-ready; activated => { root.reset-filters(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "全部声音" : "All sounds"; enabled: root.menu-ready; activated => { root.favorites-only = false; root.all-library-requested(); } }
            MenuItem { title: root.chinese ? "我的收藏" : "Favorites"; enabled: root.menu-ready; activated => { root.favorites-only = true; root.all-library-requested(); } }
            Menu { title: root.chinese ? "文件状态" : "File status";
                MenuItem { title: root.chinese ? "存在的文件" : "Present files"; enabled: root.menu-ready; activated => { root.visibility-index = 0; root.filter-requested(); } }
                MenuItem { title: root.chinese ? "缺失的文件" : "Missing files"; enabled: root.menu-ready; activated => { root.visibility-index = 1; root.filter-requested(); } }
                MenuItem { title: root.chinese ? "全部记录" : "All records"; enabled: root.menu-ready; activated => { root.visibility-index = 2; root.filter-requested(); } }
            }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "Switch to English" : "切换到中文"; enabled: root.menu-ready; activated => { root.chinese = !root.chinese; root.language-requested(root.chinese); } }
        }
        Menu { title: root.chinese ? "播放" : "Playback"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "试听所选文件" : "Audition selected file"; enabled: root.menu-ready && root.has-selection && !root.selected-missing; activated => { root.file-action-requested(root.selected-id, 0); } }
            MenuItem { title: root.chinese ? "播放" : "Play"; enabled: root.menu-ready && root.audio-ready && !root.selected-missing; activated => { root.start-requested(); } }
            MenuItem { title: root.chinese ? "暂停" : "Pause"; enabled: root.menu-ready && root.playing; activated => { root.pause-requested(); } }
            MenuItem { title: root.chinese ? "停止" : "Stop"; enabled: root.menu-ready && (root.audio-ready || root.play-duration > 0); activated => { root.stop-requested(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "音频输出设置…" : "Audio output settings…"; enabled: root.menu-ready; activated => { root.settings-visible = true; root.devices-requested(root.backend-index); } }
            MenuItem { title: root.chinese ? "Spectral Peaks 设置…" : "Spectral Peaks settings…"; enabled: root.menu-ready; activated => { root.peaks-visible = true; } }
        }
        Menu { title: root.chinese ? "帮助" : "Help"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "快捷键与基本操作…" : "Shortcuts and basics…"; enabled: root.menu-ready; activated => { root.help-visible = true; } }
            MenuItem { title: root.chinese ? "关于 AudioLib Explorer" : "About AudioLib Explorer"; enabled: root.menu-ready; activated => { root.about-visible = true; } }
        }
    }
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        min-width: 0px; min-height: 0px; preferred-width: 1440px; preferred-height: 900px;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss-modal();
                return accept;
            }
            reject
        }

    // Menu popups can restore a previous editor/list focus after opening a modal.
    // Capture background keys before any editor or list processes that focus.
    background-input := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.help-visible {
                if event.text == Key.Escape { root.help-visible = false; }
                return accept;
            }
            if root.background-blocked {
                if event.text == Key.Escape { root.dismiss-modal(); }
                else if event.text == Key.Tab || event.text == Key.Backtab {
                    if root.import-visible || root.library-visible || root.confirmation-visible { root.focus-library-modal(); }
                    else if !root.startup-busy && !root.library-busy && !root.closing { return reject; }
                }
                return accept;
            }
            reject
        }
        capture-key-released(event) => { root.background-blocked ? accept : reject }
    VerticalLayout {
        padding: 16px; spacing: 10px;
        HorizontalLayout { height: 42px; spacing: 12px;
            Rectangle { width: 34px; height: 34px; border-radius: 9px; background: Theme.selected;
                HorizontalLayout { padding: 8px; spacing: 3px;
                    Rectangle { width: 3px; height: 10px; y: 4px; background: Theme.accent; border-radius: 1px; }
                    Rectangle { width: 3px; height: 18px; background: Theme.accent; border-radius: 1px; }
                    Rectangle { width: 3px; height: 12px; y: 3px; background: Theme.accent; border-radius: 1px; }
                }
            }
            Text { text: "AudioLib Explorer"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
            Label { text: root.chinese ? "声音工作台" : "SOUND WORKSPACE"; font-size: 10px; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { max-width: 470px; min-width: 60px;
                Text { width: 100%; text: root.data-source-label; color: root.remote-mode ? Theme.accent : Theme.dim; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                TouchArea { mouse-cursor: pointer; clicked => { if root.menu-ready { root.open-data-source(); } } }
            }
            Label { text: root.library-summary; font-size: 11px; }
            Action { width: 112px; height: 32px; primary: true; enabled: root.menu-ready && !root.scanning && !root.remote-mode; label: root.chinese ? "+  添加文件夹" : "+  Add folder"; clicked => { root.prepare-scan(0, ""); } }
            Action { width: 120px; height: 32px; enabled: root.menu-ready; label: root.chinese ? "管理音效库" : "Manage library"; clicked => { root.open-library(0); } }
        }
        if root.remote-mode && root.remote-notice != "": Rectangle { height: 34px; background: Theme.panel; border-radius: 6px; border-width: 1px; border-color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning;
            HorizontalLayout { padding-left: 10px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px; spacing: 8px;
                Text { horizontal-stretch: 1; min-width: 0px; text: root.remote-notice; color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning; font-size: 11px; vertical-alignment: center; overflow: elide; }
                if root.remote-notice-kind != 0: Action { width: 96px; primary: root.remote-notice-kind == 1; enabled: root.menu-ready && !root.ds-syncing; label: root.remote-notice-kind == 1 ? (root.chinese ? "同步" : "Sync") : root.remote-notice-kind == 3 ? (root.chinese ? "设置…" : "Settings…") : (root.chinese ? "立即重试" : "Retry now"); clicked => { root.remote-notice-action(); } }
                Action { width: 30px; subtle: true; label: "×"; accessible-label: root.chinese ? "关闭提示" : "Dismiss notice"; clicked => { root.remote-notice-dismissed(); } }
            }
        }
        if root.scanning: Rectangle { height: 76px; background: Theme.panel; border-radius: 7px; border-width: 1px; border-color: Theme.accent;
            HorizontalLayout { padding: 10px; spacing: 12px;
                VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 4px;
                    Text { text: root.scan-summary; color: Theme.accent; font-size: 12px; wrap: word-wrap; overflow: elide; }
                    Text { height: 18px; text: root.scan-current-path; color: Theme.muted; font-size: 10px; overflow: elide; }
                }
                Action { width: 112px; height: 32px; enabled: root.scan-controllable && !root.scan-validating && !root.background-blocked; label: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); clicked => { root.scan-pause-requested(); } }
                Action { width: 112px; height: 32px; enabled: root.scan-controllable && !root.background-blocked; label: root.scan-cancelling ? (root.chinese ? "正在取消…" : "Cancelling…") : (root.chinese ? "取消扫描" : "Cancel scan"); clicked => { root.scan-cancel-requested(); } }
            }
        }
        Rectangle { height: 48px; background: Theme.panel; border-radius: 7px; border-width: 1px; border-color: Theme.border;
            HorizontalLayout { padding: 7px; spacing: 10px;
                Image { width: 23px; source: @image-url("../assets/search.svg"); colorize: Theme.accent; image-fit: contain; }
                search-input := LineEdit { horizontal-stretch: 1; enabled: !root.background-blocked; text <=> root.query;
                    placeholder-text: root.chinese ? "搜索声音、标签和源文件 Metadata…" : "Search sounds, tags and source Metadata…";
                    edited => { root.search-requested(false); }
                    accepted => { root.search-requested(true); }
                }
                if root.query != "": Action { width: 48px; label: root.chinese ? "清空" : "Clear"; clicked => { root.query = ""; root.search-requested(true); search-input.focus(); } }
                Label { width: 42px; text: "Ctrl F"; horizontal-alignment: center; font-size: 10px; }
                Action { width: 76px; primary: true; label: root.searching ? (root.chinese ? "搜索中" : "Searching") : (root.chinese ? "搜索" : "Search"); clicked => { root.search-requested(true); } }
            }
        }
        workspace := HorizontalLayout { vertical-stretch: 1; min-height: 0px; spacing: 0px;
            library-sidebar := Rectangle { width: root.sidebar-width; background: Theme.panel; border-radius: 7px; border-width: 1px; border-color: Theme.border; clip: true;
                VerticalLayout { padding: 12px; spacing: 8px;
                    Label { height: 24px; text: root.chinese ? "素材库" : "LIBRARY"; font-size: 10px; font-weight: 600; }
                    Action { height: 35px; active: root.selected-folder < 0 && !root.favorites-only; label: root.chinese ? "全部声音" : "All sounds"; clicked => { root.favorites-only = false; root.all-library-requested(); } }
                    Action { height: 35px; active: root.favorites-only; label: root.chinese ? "★  我的收藏" : "★  Favorites"; clicked => { root.favorites-only = !root.favorites-only; root.filter-requested(); } }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout { height: 28px;
                        Label { horizontal-stretch: 1; text: root.chinese ? "文件夹" : "FOLDERS"; font-size: 10px; }
                        Label { text: "WAV / BWF"; font-size: 9px; color: Theme.accent; }
                    }
                    folder-list := ListView { vertical-stretch: 1; viewport-width: self.visible-width;
                        for folder[index] in root.folders: Rectangle { height: 34px; border-radius: 4px;
                            // Fluent overlays a 14px scrollbar; reserve its track plus a gap.
                            background: root.selected-folder == index ? Theme.selected : (folder-hit.has-hover ? Theme.raised : transparent);
                            HorizontalLayout { spacing: 4px; padding-right: 18px;
                                // Keep a readable name and count even in a narrow, deep folder tree.
                                folder-indent := Rectangle { width: clamp(folder.depth * 10px, 0px, max(0px, parent.width - max(28px, folder-count.preferred-width) - 18px - 17px - 12px - 40px)); }
                                Rectangle { width: 17px;
                                    Text { text: folder.has-children ? (folder.expanded ? "−" : "+") : "·"; color: Theme.dim; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.folder-toggle-requested(index); } }
                                }
                                Text { horizontal-stretch: 1; min-width: 0px; text: folder.name; color: Theme.ink; overflow: elide; vertical-alignment: center; font-size: 11px; }
                                folder-count := Label { min-width: 28px; horizontal-stretch: 0; text: folder.count; horizontal-alignment: right; }
                            }
                            folder-hit := TouchArea { x: folder-indent.width + 22px; width: max(0px, parent.width - 18px - self.x); mouse-cursor: pointer;
                                clicked => { root.folder-requested(index); }
                                pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.show-folder-menu(folder, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); } }
                            }
                        }
                    }
                    Label { height: 34px; text: root.chinese ? "右键文件夹管理素材库" : "Right-click folders to manage"; wrap: word-wrap; font-size: 10px; }
                }
            }
            PaneDivider {
                pane-width: root.sidebar-width; enabled: !root.background-blocked;
                label: root.chinese ? "调整素材库侧栏宽度" : "Resize library sidebar";
                resized(width) => { root.sidebar-preferred-width = clamp(width, 170px, min(480px, root.sidebar-budget - (root.inspector-visible ? root.inspector-width : 0px))); }
            }
            results-column := VerticalLayout { horizontal-stretch: 1; min-width: 520px; spacing: 6px;
                HorizontalLayout { height: 32px; spacing: 6px;
                    if root.checked-count <= 1: Text { horizontal-stretch: 1; min-width: 0px; overflow: elide; text: root.favorites-only ? (root.chinese ? "我的收藏" : "Favorites") : (root.chinese ? "声音列表" : "Sounds"); color: Theme.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    if root.checked-count > 1: selection-actions := Action {
                        width: 108px; active: true; dropdown: true;
                        label: root.checked-count + (root.chinese ? " 条已选" : " selected");
                        clicked => { selection-menu.show({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                    }
                    if root.checked-count > 1 && root.wide-layout: Action { width: 86px; enabled: !root.background-blocked && !root.remote-writes-blocked; label: root.chinese ? "批量标注" : "Batch edit"; clicked => { root.open-batch(); } }
                    if root.checked-count > 1 && root.wide-layout: Action { width: 64px; subtle: true; enabled: !root.background-blocked && root.removal-allowed; label: root.chinese ? "移除" : "Remove"; clicked => { root.library-action(11); } }
                    if root.checked-count > 1: Rectangle { horizontal-stretch: 1; }
                    ComboBox { width: 116px; model: root.chinese ? ["存在的文件", "缺失的文件", "全部记录"] : ["Present files", "Missing files", "All records"]; current-index <=> root.visibility-index; selected => { root.filter-requested(); } }
                    Action { width: 82px; subtle: true; active: root.filters-visible || root.filter-count > 0; label: (root.chinese ? "筛选" : "Filters") + (root.filter-count > 0 ? " · " + root.filter-count : "") + (root.filters-visible ? " −" : " +"); clicked => { root.filters-visible = !root.filters-visible; } }
                    ComboBox {
                        width: 116px;
                        model: root.chinese ? ["相关度", "文件名", "时长", "采样率", "声道", "标签", "修改时间"] : ["Relevance", "Filename", "Duration", "Sample rate", "Channels", "Tags", "Modified"];
                        current-index <=> root.sort-index;
                        selected => { root.sort-descending = false; root.filter-requested(); root.table-layout-changed(); }
                    }
                    Action { width: 62px; subtle: true; active: root.inspector-visible; label: root.chinese ? "详情" : "Details"; clicked => { root.inspector-visible = !root.inspector-visible; } }
                }
                if root.crumbs.length > 0: HorizontalLayout { height: 30px; spacing: 4px;
                    Action { width: 64px; subtle: true; label: root.chinese ? "素材库" : "Library"; clicked => { root.all-library-requested(); } }
                    // Deep hierarchies remain navigable without forcing the window wider.
                    ScrollView { horizontal-stretch: 1; viewport-height: 30px;
                        HorizontalLayout { spacing: 4px;
                            for crumb[index] in root.crumbs: HorizontalLayout {
                                Label { width: 10px; text: "›"; horizontal-alignment: center; }
                                Action { subtle: true; label: crumb.name; width: 110px; clicked => { root.crumb-requested(index); } }
                            }
                        }
                    }
                }
                if root.filters-visible: Rectangle { height: root.short-layout ? 100px : 156px; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: 6px;
                    filters-scroll := ScrollView { min-height: 0px; viewport-height: 156px;
                    VerticalLayout { padding: 10px; spacing: 6px;
                        HorizontalLayout { spacing: 6px;
                            ComboBox { horizontal-stretch: 1; model: root.chinese ? ["全部采样率", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"] : ["Sample rate", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"]; current-index <=> root.sample-filter; selected => { root.filter-requested(); } }
                            ComboBox { horizontal-stretch: 1; model: root.chinese ? ["全部位深", "16 bit", "24 bit", "32 bit"] : ["Bit depth", "16 bit", "24 bit", "32 bit"]; current-index <=> root.bit-filter; selected => { root.filter-requested(); } }
                            ComboBox { horizontal-stretch: 1; model: root.chinese ? ["全部声道", "单声道", "立体声", "4 声道", "6 声道", "8 声道"] : ["Channels", "Mono", "Stereo", "4 channels", "6 channels", "8 channels"]; current-index <=> root.channel-filter; selected => { root.filter-requested(); } }
                        }
                        HorizontalLayout { spacing: 6px;
                            Label { text: root.chinese ? "时长 / 秒" : "Seconds"; }
                            LineEdit { horizontal-stretch: 1; min-width: 0px; text <=> root.duration-min; placeholder-text: root.chinese ? "最短" : "Min"; accepted => { root.filter-requested(); } }
                            Label { text: "–"; }
                            LineEdit { horizontal-stretch: 1; min-width: 0px; text <=> root.duration-max; placeholder-text: root.chinese ? "最长" : "Max"; accepted => { root.filter-requested(); } }
                        }
                        HorizontalLayout { spacing: 6px;
                            LineEdit { horizontal-stretch: 1; min-width: 0px; text <=> root.tag-filter; placeholder-text: root.chinese ? "标签包含…" : "Tags contain…"; accepted => { root.filter-requested(); } }
                            LineEdit { min-width: 118px; max-width: 118px; text <=> root.color-filter; placeholder-text: root.chinese ? "颜色 #RRGGBB" : "Color #RRGGBB"; accepted => { root.filter-requested(); } }
                        }
                        HorizontalLayout { spacing: 6px;
                            CheckBox { text: root.chinese ? "有标签" : "Tagged only"; checked <=> root.tagged-only; toggled => { root.filter-requested(); } }
                            Rectangle { horizontal-stretch: 1; }
                            Action { width: 58px; label: root.chinese ? "重置" : "Reset"; clicked => { root.reset-filters(); } }
                            Action { width: 64px; primary: true; label: root.chinese ? "应用" : "Apply"; clicked => { root.filter-requested(); } }
                        }
                    }
                }
                }
                Rectangle { vertical-stretch: 1; min-height: 0px; clip: true; border-width: 1px; border-color: Theme.border; border-radius: 7px; background: Theme.panel;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: 33px; background: Theme.raised; clip: true;
                            // Both empty and populated results share the header's horizontal position.
                            Rectangle { x: root.table-viewport-x; width: root.table-content-size; height: parent.height;
                                table-name-header := TableHeader {
                                    x: 0px; width: root.table-name-size - 8px; height: parent.height;
                                    label: root.chinese ? "文件名" : "NAME";
                                    action-label: root.chinese ? "按文件名排序" : "Sort by filename";
                                    help: root.chinese ? "按文件名排序；再次点击切换升序 / 降序" : "Sort by filename; click again to reverse ascending / descending";
                                    active: root.sort-index == 1; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(1); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-duration-header := TableHeader {
                                    x: root.table-name-size; width: root.table-duration-size - 8px; height: parent.height;
                                    label: root.chinese ? "时长" : "TIME";
                                    action-label: root.chinese ? "按时长排序" : "Sort by duration";
                                    help: root.chinese ? "按时长排序；再次点击切换升序 / 降序" : "Sort by duration; click again to reverse ascending / descending";
                                    active: root.sort-index == 2; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(2); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-format-header := TableHeader {
                                    x: root.table-name-size + root.table-duration-size; width: root.table-format-size - 8px; height: parent.height;
                                    label: root.chinese ? "格式" : "FORMAT";
                                    action-label: root.chinese ? "按采样率排序" : "Sort by sample rate";
                                    help: root.chinese ? "按采样率排序；再次点击切换升序 / 降序" : "Sort by sample rate; click again to reverse ascending / descending";
                                    active: root.sort-index == 3; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(3); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-channels-header := TableHeader {
                                    x: root.table-name-size + root.table-duration-size + root.table-format-size; width: root.table-channels-size - 8px; height: parent.height;
                                    label: root.chinese ? "声道" : "CH";
                                    action-label: root.chinese ? "按声道排序" : "Sort by channels";
                                    help: root.chinese ? "按声道数排序；再次点击切换升序 / 降序" : "Sort by channel count; click again to reverse ascending / descending";
                                    active: root.sort-index == 4; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(4); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-tags-header := TableHeader {
                                    x: root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size; width: root.table-tags-size - 8px; height: parent.height;
                                    label: root.chinese ? "标签" : "TAGS";
                                    action-label: root.chinese ? "按标签排序" : "Sort by tags";
                                    help: root.chinese ? "按素材库标签排序，空白时使用源标签；再次点击切换升序 / 降序" : "Sort by library tags, using source tags when empty; click again to reverse ascending / descending";
                                    active: root.sort-index == 5; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(5); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-name-divider := TableDivider {
                                    x: root.table-name-size - 8px; height: parent.height; column-width: root.table-name-size;
                                    label: root.chinese ? "调整文件名列宽" : "Resize Filename column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(1, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-name-width = 360; root.table-layout-changed(); }
                                }
                                table-duration-divider := TableDivider {
                                    x: root.table-name-size + root.table-duration-size - 8px; height: parent.height; column-width: root.table-duration-size;
                                    label: root.chinese ? "调整时长列宽" : "Resize Duration column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(2, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-duration-width = 80; root.table-layout-changed(); }
                                }
                                table-format-divider := TableDivider {
                                    x: root.table-name-size + root.table-duration-size + root.table-format-size - 8px; height: parent.height; column-width: root.table-format-size;
                                    label: root.chinese ? "调整格式列宽" : "Resize Format column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(3, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-format-width = 100; root.table-layout-changed(); }
                                }
                                table-channels-divider := TableDivider {
                                    x: root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size - 8px; height: parent.height; column-width: root.table-channels-size;
                                    label: root.chinese ? "调整声道列宽" : "Resize Channels column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(4, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-channels-width = 64; root.table-layout-changed(); }
                                }
                                table-tags-divider := TableDivider {
                                    x: root.table-columns-size - 8px; height: parent.height; column-width: root.table-tags-size;
                                    label: root.chinese ? "调整标签列宽" : "Resize Tags column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(5, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-tags-width = 160; root.table-layout-changed(); }
                                }
                            }
                        }
                        results-focus := FocusScope { vertical-stretch: 1; min-height: 0px; focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    let step = event.text == Key.DownArrow ? 1 : -1;
                                    if event.modifiers.shift && root.rows.length > 0 {
                                        root.row-clicked(clamp(root.selected-row + step, 0, root.rows.length - 1), event.modifiers.control, true, false);
                                    } else { root.selection-step-requested(step); }
                                    return accept;
                                }
                                if event.text == " " && root.audio-ready { root.play-requested(); return accept; }
                                if event.text == Key.Return && root.selected-row >= 0 { root.audition-requested(root.selected-row); return accept; }
                                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.selected-row >= 0 {
                                    root.show-file-menu(root.rows[root.selected-row], {x: self.absolute-position.x + 80px, y: self.absolute-position.y + 40px}); return accept;
                                }
                                reject
                            }
                            // Keep the delegate directly under ListView for virtualization.
                            result-list := ListView {
                                visible: !root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-x: root.table-viewport-x;
                                // A newly populated repeater measures its width after becoming
                                // visible. Ignore its temporary empty-range clamp until then.
                                changed viewport-x => { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.table-viewport-x = self.viewport-x; } }
                                changed viewport-width => { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.sync-table-viewport(); } }
                                // Fixed child layout widths let ListView measure its horizontal scroll extent.
                                for row[index] in root.rows: Rectangle { width: root.table-content-size; height: root.result-row-height; accessible-role: list-item; accessible-label: row.name;
                                    background: row.checked ? (root.selected-row == index ? Theme.selected : Theme.checked) : (result-hit.has-hover ? Theme.hover : (Math.mod(index, 2) == 0 ? Theme.alternate : Theme.panel));
                                    Rectangle { x: 0px; y: 0px; height: parent.height; width: 3px; background: root.selected-row == index ? Theme.accent : row.marker; }
                                    HorizontalLayout { alignment: start; padding-left: 12px; padding-right: 12px; spacing: 24px;
                                        table-name-cell := Text { width: root.table-name-size - 24px; text: (row.missing ? (root.chinese ? "[缺失] " : "[Missing] ") : "") + row.name; color: row.missing ? Theme.warning : Theme.ink; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                        table-duration-cell := Text { width: root.table-duration-size - 24px; text: row.duration; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; font-size: 11px; overflow: elide; }
                                        table-format-cell := Text { width: root.table-format-size - 24px; text: row.format; color: Theme.dim; vertical-alignment: center; font-size: 10px; overflow: elide; }
                                        table-channels-cell := Text { width: root.table-channels-size - 24px; text: row.channels; color: Theme.dim; vertical-alignment: center; font-size: 11px; overflow: elide; }
                                        table-tags-cell := Text { width: root.table-tags-size - 24px; text: row.tags; color: Theme.dim; vertical-alignment: center; overflow: elide; font-size: 10px; }
                                    }
                                    result-hit := TouchArea { mouse-cursor: pointer;
                                        property <bool> toggle-selection;
                                        property <bool> range-selection;
                                        // One drag-out request per press, after a small movement threshold.
                                        property <bool> drag-sent;
                                        moved => {
                                            if self.pressed && !self.drag-sent && !row.missing && !self.toggle-selection && !self.range-selection && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                                                self.drag-sent = true;
                                                root.drag-out-requested(row.id);
                                            }
                                        }
                                        clicked => {
                                            results-focus.focus();
                                            root.row-clicked(index, self.toggle-selection, self.range-selection, root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent);
                                        }
                                        // Slint also emits clicked on the second release. In single-click
                                        // mode that click already owns playback, so do not request it again.
                                        double-clicked => { if !root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent { root.selected-row = index; root.audition-requested(index); } }
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                self.toggle-selection = event.modifiers.control;
                                                self.range-selection = event.modifiers.shift;
                                                self.drag-sent = false;
                                            }
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { results-focus.focus(); root.show-file-menu(row, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); }
                                        }
                                    }
                                }
                            }
                            // Slint 1.17's empty ListView repeater resets its viewport width to
                            // the visible width. A separate viewport preserves the real column
                            // extent without adding a synthetic AudioRow to the result model.
                            empty-result-list := ScrollView {
                                visible: root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-height: self.visible-height;
                                viewport-x: root.table-viewport-x;
                                changed viewport-x => { if root.table-empty { root.table-viewport-x = self.viewport-x; } }
                                Rectangle { width: root.table-content-size; height: empty-result-list.visible-height; }
                            }
                            if root.rows.length == 0 && root.short-layout && root.filters-visible: Text { text: root.chinese ? "没有匹配声音 · 调整或重置筛选" : "No matching sounds · Adjust or reset filters"; color: Theme.dim; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                            if root.rows.length == 0 && (!root.short-layout || !root.filters-visible): VerticalLayout { padding: 24px; alignment: center; spacing: 12px;
                                Text { text: root.searching ? (root.chinese ? "正在搜索…" : "Searching…") : (root.chinese ? "这里还没有声音" : "No sounds in this view"); color: Theme.ink; horizontal-alignment: center; font-size: 18px; }
                                Label { text: root.chinese ? "添加 WAV 文件夹，或调整搜索和筛选条件。" : "Add a WAV folder, or adjust your search and filters."; horizontal-alignment: center; wrap: word-wrap; }
                                Action { width: 140px; label: root.chinese ? "清除搜索和筛选" : "Clear search & filters"; clicked => { root.query = ""; root.reset-filters(); } }
                            }
                        }
                        Rectangle { height: 34px; background: Theme.raised;
                            HorizontalLayout { padding-left: 10px; padding-right: 5px; spacing: 5px;
                                Action { width: 84px; subtle: true; enabled: root.rows.length > 0; label: root.chinese ? "选择本页" : "Select page"; clicked => { root.check-page-requested(true); } }
                                CheckBox { width: root.chinese ? 104px : 142px; enabled: !root.background-blocked; surface: Theme.raised; text: root.chinese ? "单击播放" : "Single-click play"; checked <=> root.audition-play-on-single-click; toggled => { root.single-click-play-requested(self.checked); } }
                                table-columns-action := Action {
                                    width: root.chinese ? 54px : 78px; subtle: true; dropdown: true; enabled: !root.background-blocked;
                                    label: root.chinese ? "列" : "Columns";
                                    action-label: root.chinese ? "自定义表格列" : "Customize table columns";
                                    clicked => { root.show-table-menu({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                                }
                                Label { horizontal-stretch: 1; min-width: 0px; text: root.result-summary; overflow: elide; font-size: 10px; }
                                Action { width: 30px; enabled: root.can-previous; label: "‹"; clicked => { root.page-requested(-1); } }
                                Label { width: 44px; text: root.page-label; horizontal-alignment: center; }
                                Action { width: 30px; enabled: root.can-next; label: "›"; clicked => { root.page-requested(1); } }
                            }
                        }
                    }
                }
            }
            if root.inspector-visible: PaneDivider {
                pane-width: root.inspector-width; reverse: true; enabled: !root.background-blocked;
                label: root.chinese ? "调整声音详情宽度" : "Resize sound details";
                resized(width) => { root.inspector-preferred-width = clamp(width, 240px, min(600px, root.sidebar-budget - root.sidebar-width)); }
            }
            if root.inspector-visible: details-sidebar := Rectangle { width: root.inspector-width; background: Theme.panel; border-radius: 7px; border-width: 1px; border-color: Theme.border; clip: true;
                VerticalLayout { padding: 10px; spacing: 8px;
                    HorizontalLayout { height: 30px;
                        Text { horizontal-stretch: 1; text: root.chinese ? "声音详情" : "Sound details"; color: Theme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                        if root.has-selection: Action { width: 36px; subtle: true; active: root.edit-favorite; enabled: !root.background-blocked && !root.remote-writes-blocked; label: root.edit-favorite ? "★" : "☆"; action-label: root.edit-favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "收藏" : "Add to favorites"); clicked => { root.edit-favorite = !root.edit-favorite; root.metadata-dirty = true; root.metadata-edited(); } }
                        Action { width: 36px; subtle: true; label: "×"; clicked => { root.inspector-visible = false; } }
                    }
                    if !root.has-selection: VerticalLayout { spacing: 6px; padding-top: 12px;
                        Text { text: root.chinese ? "选择一个声音" : "Select a sound"; color: Theme.ink; font-size: 14px; }
                        Text { text: root.chinese ? "在列表中选择文件，查看信息或编辑标注。" : "Select a file to inspect its details and edit annotations."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if root.has-selection: inspector-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                        property <string> displayed-id: root.selected-id;
                        changed displayed-id => { self.viewport-y = 0px; }
                        VerticalLayout { spacing: root.short-layout ? 4px : 7px; padding-right: 4px; alignment: start;
                            Text { height: root.short-layout ? 22px : 40px; text: root.selected-name; color: Theme.ink; font-size: 13px; font-weight: 600; wrap: word-wrap; overflow: elide; }
                            Label { height: root.short-layout ? 16px : 28px; text: root.selected-format; color: Theme.accent; wrap: word-wrap; overflow: elide; font-size: 10px; }
                            if root.selected-missing: VerticalLayout { spacing: 6px;
                                Text { text: root.chinese ? "原位置找不到此文件。选择移动或改名后的 WAV，保留已有标注。" : "File missing at its original location. Locate the moved or renamed WAV to keep its annotations."; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
                                Action { height: 32px; primary: true; enabled: !root.closing && !root.library-busy; label: root.chinese ? "选择新位置，修复引用…" : "Locate file and repair…"; clicked => { root.file-action-requested(root.selected-id, 20); } }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            if root.selected-description != "": VerticalLayout { spacing: 4px;
                                Label { height: 16px; text: root.chinese ? "描述" : "DESCRIPTION"; font-size: 10px; }
                                source-description := TextEdit {
                                    height: root.short-layout ? 56px : 96px;
                                    accessible-label: root.chinese ? "源文件描述" : "Source description";
                                    read-only: true; text: root.selected-description;
                                    property <string> displayed-id: root.selected-id;
                                    changed displayed-id => {
                                        self.set-selection-offsets(0, 0);
                                        self.viewport-x = 0px;
                                        self.viewport-y = 0px;
                                    }
                                }
                            }
                            if root.selected-source-tags != "": VerticalLayout { spacing: 4px;
                                Label { height: 16px; text: root.chinese ? "提取的标签" : "EXTRACTED TAGS"; font-size: 10px; }
                                SourceTags { height: root.short-layout ? 44px : 64px; label: root.chinese ? "提取的标签" : "Extracted tags"; text: root.selected-source-tags; displayed-id: root.selected-id; }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Label { width: 34px; text: root.chinese ? "标签" : "Tags"; }
                                LineEdit { min-width: 0px; input-label: root.chinese ? "标签 · 逗号分隔" : "Tags, comma separated"; enabled: !root.background-blocked && !root.remote-writes-blocked; text <=> root.edit-tags; placeholder-text: root.chinese ? "标签，用逗号分隔" : "Tags, comma separated"; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                            }
                            Action { height: 30px; subtle: true; active: root.notes-visible; label: (root.notes-visible ? "−  " : "+  ") + (root.chinese ? "备注" : "Notes") + (root.edit-notes == "" ? "" : " ·"); clicked => { root.notes-visible = !root.notes-visible; } }
                            if root.notes-visible: TextEdit { height: 62px; accessible-label: root.chinese ? "备注" : "Notes"; enabled: !root.background-blocked && !root.remote-writes-blocked; text <=> root.edit-notes; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                            Label { height: 16px; text: root.chinese ? "文件路径" : "FILE PATH"; font-size: 10px; }
                            ScrollView { height: root.short-layout ? 36px : 48px; viewport-width: self.visible-width;
                                VerticalLayout { padding: 0px; alignment: start;
                                    TextInput { accessible-label: root.chinese ? "文件路径" : "File path"; read-only: true; single-line: false; wrap: char-wrap; font-size: 10px; color: Theme.dim; selection-background-color: Theme.accent; selection-foreground-color: Theme.on-accent; text: root.selected-path; }
                                }
                            }
                            Action { height: 30px; subtle: true; active: root.source-metadata-visible; label: (root.source-metadata-visible ? "−  " : "+  ") + (root.chinese ? "原始 Metadata（含 SMED）" : "Source Metadata / SMED"); clicked => { root.source-metadata-visible = !root.source-metadata-visible; } }
                            if root.source-metadata-visible: TextEdit { height: root.short-layout ? 100px : 160px; font-size: 10px; accessible-label: root.chinese ? "源文件 Metadata" : "Source Metadata"; read-only: true; text: root.selected-attributes == "" || root.selected-attributes == "{}" ? (root.chinese ? "无嵌入 Metadata" : "No embedded Metadata") : root.selected-attributes; }
                        }
                    }
                    if root.has-selection: HorizontalLayout { height: 30px;
                        Label { horizontal-stretch: 1; text: root.metadata-dirty ? (root.chinese ? "未保存" : "Unsaved") : root.remote-mode ? (root.chinese ? "已保存到服务器" : "Saved to server") : (root.chinese ? "已保存到素材库" : "Saved to library"); color: root.metadata-dirty ? Theme.warning : Theme.dim; font-size: 10px; }
                        Action { width: 98px; primary: root.metadata-dirty; subtle: !root.metadata-dirty; enabled: root.metadata-dirty && !root.closing && !root.library-busy && !root.remote-writes-blocked; label: root.chinese ? "保存 · Ctrl S" : "Save · Ctrl S"; clicked => { root.save-metadata-requested(); } }
                    }
                }
            }
        }
        AuditionPanel {
            compact: root.short-layout; spectral: root.peak-mode == 1;
            play-on-single-click: root.audition-play-on-single-click;
            chinese: root.chinese; ready: root.audio-ready && !root.selected-missing && !root.library-busy;
            playing: root.playing; smooth-progress: root.playback-smooth; progress-clock: root.playback-clock; playback-rate: root.confirmed-playback-rate; waveform: root.waveform-image; waveform-ready: root.waveform-ready;
            name: root.playback-name; info: root.waveform-info; output: root.output-summary;
            position: root.play-position; duration: root.play-duration; time: root.play-time; end-time: root.play-end;
            view-start: root.view-start; view-end: root.view-end; zoom: root.wave-zoom; ruler-labels: root.ruler-labels;
            scroll <=> root.wave-scroll; volume-db <=> root.volume-db; volume-label: root.volume-label;
            pitch-text <=> root.pitch-text; rate-text <=> root.speed-text; mono <=> root.audition-mono; repeat <=> root.audition-repeat;
            play => { root.start-requested(); } pause => { root.pause-requested(); } stop => { root.stop-requested(); }
            seek(value) => { root.seek-requested(value); }
            seek-play(value) => { root.seek-play-requested(value); }
            transform(pitch,rate,mono,repeat) => { root.transform-requested(pitch,rate,mono,repeat); }
            volume(value) => { root.volume-db-requested(value); }
            resize(w,h) => { root.waveform-resize-requested(w,h); }
            zoom-change(factor) => { root.waveform-zoom-requested(factor); }
            zoom-at(factor,fraction) => { root.waveform-wheel-zoom-requested(factor,fraction); }
            pan(value) => { root.waveform-pan-requested(value); }
            peaks => { root.peaks-visible = true; }
            output-settings => { root.settings-visible = true; root.devices-requested(root.backend-index); }
        }
        HorizontalLayout { height: 16px;
            Label { horizontal-stretch: 1; min-width: 0px; text: root.drag-preparing && root.drag-progress != "" ? root.drag-progress : root.status; overflow: elide; font-size: 10px; }
            if root.drag-preparing: Rectangle { width: 52px;
                accessible-role: button;
                accessible-label: root.chinese ? "取消拖出" : "Cancel drag";
                accessible-action-default => { root.drag-cancel-requested(); }
                Text { text: root.chinese ? "取消" : "Cancel"; color: Theme.accent; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { root.drag-cancel-requested(); } }
            }
            Label { width: 300px; text: root.scanning ? (root.chinese ? "正在扫描音效文件夹" : "Scanning sound folder") : "WAV / BWF"; horizontal-alignment: right; font-size: 10px; }
        }
    }
    }
    // Top-level focus scope also contains modal input, keeping shortcuts scoped to this window.

    table-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.chinese ? "恢复默认列宽" : "Reset column widths"; enabled: !root.background-blocked; activated => { root.reset-table-widths(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "升序 ↑" : "Ascending ↑"; enabled: !root.background-blocked && root.sort-index != 0; activated => { root.sort-descending = false; root.filter-requested(); root.table-layout-changed(); } }
            MenuItem { title: root.chinese ? "降序 ↓" : "Descending ↓"; enabled: !root.background-blocked && root.sort-index != 0; activated => { root.sort-descending = true; root.filter-requested(); root.table-layout-changed(); } }
            MenuItem { title: root.chinese ? "恢复相关度排序" : "Reset to relevance sort"; enabled: !root.background-blocked; activated => { root.sort-table(0); } }
        }
    }
    selection-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.chinese ? "批量标注" : "Batch edit"; enabled: root.checked-count > 1 && !root.background-blocked && !root.remote-writes-blocked; activated => { root.open-batch(); } }
            MenuItem { title: root.chinese ? "清除选择" : "Clear selection"; enabled: !root.background-blocked; activated => { root.check-page-requested(false); } }
            MenuItem { title: (root.chinese ? "移除选择记录（保留 WAV）…" : "Remove selected records (keep WAV)…") + root.removal-suffix; enabled: !root.background-blocked && root.removal-allowed; activated => { root.library-action(11); } }
        }
    }
    file-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-file.name; enabled: false; }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "试听" : "Audition"; enabled: !root.context-file.missing; activated => { root.file-action(0); } }
            MenuItem { title: root.chinese ? "查看 / 编辑 Metadata" : "View / edit Metadata"; activated => { root.inspector-visible = true; root.file-action(1); } }
            MenuSeparator { }
            MenuItem { title: (root.context-file.favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "添加到收藏" : "Add to favorites")); enabled: !root.remote-writes-blocked; activated => { root.file-action(5); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "在资源管理器中定位" : "Reveal in Explorer") + root.ro-suffix; enabled: !root.remote-mode; activated => { root.file-action(2); } }
            MenuItem { title: root.chinese ? "复制完整路径" : "Copy full path"; activated => { root.copy-text(root.context-file.file-path); } }
            MenuItem { title: (root.chinese ? "修复文件引用…" : "Repair file reference…") + root.ro-suffix; enabled: !root.remote-mode; activated => { root.file-action(20); } }
            MenuItem { title: (root.chinese ? "从素材库移除…" : "Remove from library…") + root.removal-suffix; enabled: root.removal-allowed; activated => { root.file-action(21); } }
            MenuItem { title: root.chinese ? "复制文件名" : "Copy filename"; activated => { root.copy-text(root.context-file.name); } }
        }
    }
    folder-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-folder.name; enabled: false; }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "打开文件夹" : "Open in Explorer") + root.ro-suffix; enabled: !root.remote-mode; activated => { root.folder-action-requested(root.context-folder.path, 0); } }
            MenuItem { title: root.chinese ? "复制文件夹路径" : "Copy folder path"; activated => { root.copy-text(root.context-folder.path); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "增量扫描此文件夹…" : "Incremental scan this folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(0, root.context-folder.path); } }
            MenuItem { title: (root.chinese ? "全量扫描此文件夹…" : "Full scan this folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(1, root.context-folder.path); } }
            MenuItem { title: (root.chinese ? "从素材库移除目录…" : "Remove folder from library…") + root.removal-suffix; enabled: root.removal-allowed; activated => { root.folder-action-requested(root.context-folder.path, 1); } }
            MenuItem { title: (root.chinese ? "添加文件夹…" : "Add folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(0, ""); } }
        }
    }
    if root.peaks-visible: PeakSettings {
        chinese: root.chinese; mode <=> root.peak-mode; gain-db <=> root.peak-gain;
        opacity-value <=> root.peak-opacity; noise <=> root.peak-noise; variance <=> root.peak-variance;
        changed => { root.peak-style-requested(); } close => { root.peaks-visible = false; }
    }
    scan-dialog := FocusScope {
        visible: root.import-visible;
        enabled: root.import-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <int> focus-index: 0;
        function focus-control(index: int, backwards: bool) {
            if root.scanning || root.scan-browse-busy || root.library-busy || root.closing { scan-cancel-action.focus(); return; }
            if index == 0 { scan-path-input.focus(); }
            else if index == 1 { scan-browse-action.focus(); }
            else if index == 2 { scan-incremental-action.focus(); }
            else if index == 3 { scan-full-action.focus(); }
            else if index == 4 { scan-cancel-action.focus(); }
            else if root.scan-path != "" { scan-start-action.focus(); }
            else if backwards { scan-cancel-action.focus(); }
            else { scan-path-input.focus(); }
        }
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel-scan-dialog(); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                self.focus-control(Math.mod(self.focus-index + (event.modifiers.shift || event.text == Key.Backtab ? 5 : 1), 6), event.modifiers.shift || event.text == Key.Backtab);
                return accept;
            }
            reject
        }
        key-pressed(event) => { accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 650px; height: 490px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 26px; spacing: 12px;
                Text { text: root.chinese ? "扫描音效文件夹" : "Scan a sound folder"; color: Theme.ink; font-size: 22px; font-weight: 600; }
                Label { height: 32px; text: root.chinese ? "选择文件夹，或粘贴本地 / 网络路径。包含其所有子文件夹中的 WAV / BWF。" : "Choose a folder or paste a local / network path. Includes WAV / BWF in all its subfolders."; wrap: word-wrap; }
                HorizontalLayout { height: 36px; spacing: 8px;
                    scan-path-input := LineEdit { horizontal-stretch: 1; input-label: root.chinese ? "音效文件夹路径" : "Sound folder path"; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; text <=> root.scan-path; placeholder-text: root.chinese ? "例如 D:\\Sound Library" : "e.g. D:\\Sound Library"; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 0; } } edited => { root.scan-error = ""; } accepted => { if root.scan-path != "" && !root.scanning && !root.scan-browse-busy && !root.library-busy && !root.closing { root.scan-requested(root.scan-path); } } }
                    scan-browse-action := Action { width: 146px; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 1; } } label: root.scan-browse-busy ? (root.chinese ? "正在选择…" : "Choosing…") : (root.chinese ? "选择文件夹…" : "Browse folders…"); clicked => { root.scan-browse-requested(); } }
                }
                HorizontalLayout { height: 36px; spacing: 8px;
                    scan-incremental-action := Action { horizontal-stretch: 1; active: root.scan-mode == 0; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 2; } } label: root.chinese ? "增量扫描 · 日常更新" : "Incremental · daily update"; clicked => { root.scan-mode = 0; } }
                    scan-full-action := Action { horizontal-stretch: 1; active: root.scan-mode == 1; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 3; } } label: root.chinese ? "全量扫描 · 重新检查" : "Full scan · recheck folder"; clicked => { root.scan-mode = 1; } }
                }
                Rectangle { height: 86px; background: Theme.raised; border-radius: 6px;
                    Text { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text: root.scan-mode == 0 ? (root.chinese ? "适合添加新音效和日常更新。\n只读取新增或已修改文件，跳过未变化文件；不检测缺失。" : "For new sounds and everyday updates.\nReads new or modified files, skips unchanged files; does not detect missing files.") : (root.chinese ? "适合文件整理后重新检查。\n重新读取所选文件夹内全部文件；扫描完整成功后标记缺失文件，保留标注。" : "For rechecking a folder after reorganizing files.\nRereads every file in this folder; a complete successful scan marks missing files and keeps annotations."); color: Theme.ink; wrap: word-wrap; font-size: 12px; }
                }
                Label { text: root.chinese ? "标签、收藏和备注都会保留。源音频文件不会被修改。" : "Tags, favorites and notes are kept. Source audio files stay unchanged."; wrap: word-wrap; font-size: 10px; }
                Text { height: 36px; text: root.scan-validating ? (root.chinese ? "正在检查文件夹…可取消此次扫描。" : "Checking the folder… You can cancel this scan.") : root.scan-error; color: root.scan-validating ? Theme.accent : Theme.warning; wrap: word-wrap; font-size: 11px; overflow: elide; }
                HorizontalLayout { height: 34px; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    scan-cancel-action := Action { width: 80px; enabled: !root.scan-browse-busy && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 4; } } label: root.chinese ? "取消" : "Cancel"; clicked => { root.cancel-scan-dialog(); } }
                    scan-start-action := Action { width: 132px; primary: true; enabled: !root.scanning && !root.scan-browse-busy && !root.library-busy && !root.closing && root.scan-path != ""; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 5; } } label: root.scan-validating ? (root.chinese ? "正在检查…" : "Checking…") : (root.chinese ? "开始扫描" : "Start scan"); clicked => { root.scan-requested(root.scan-path); } }
                }
            }
        }
        }
    }
    if root.settings-visible: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 590px; height: 505px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.strong-border;
            VerticalLayout { padding: 26px; spacing: 13px;
                Text { text: root.chinese ? "音频输出" : "Audio output"; color: Theme.ink; font-size: 23px; font-weight: 600; }
                Label { text: root.chinese ? "选择驱动、设备与监听声道对。更改后重新启动输出。" : "Choose the driver, device and listening pair. Changes restart output."; }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "驱动" : "Driver"; }
                    ComboBox { horizontal-stretch: 1; enabled: !root.output-applying; model: ["WASAPI", "ASIO"]; current-index <=> root.backend-index; selected => { if (root.backend-index == 0) { root.rate-index = 0; } root.devices-requested(root.backend-index); } }
                }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "设备" : "Device"; }
                    ComboBox { horizontal-stretch: 1; enabled: !root.devices-loading && !root.output-applying; model: root.device-names; current-index <=> root.device-index; selected => { root.device-selected(root.device-index); } }
                }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "采样率策略" : "Sample rate policy"; }
                    ComboBox { horizontal-stretch: 1; enabled: root.backend-index == 1 && !root.output-applying; model: root.chinese ? ["设备默认 · 自动重采样", "原生 · ASIO 文件采样率"] : ["Device default · resample", "Native · ASIO source rate"]; current-index <=> root.rate-index; }
                }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "缓冲区 / 帧" : "Buffer / frames"; }
                    LineEdit { horizontal-stretch: 1; enabled: !root.output-applying; text <=> root.buffer-frames; }
                }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "源文件监听对" : "Source pair"; }
                    LineEdit { width: 70px; enabled: !root.output-applying; text <=> root.source-pair; }
                    Label { horizontal-stretch: 1; text: root.chinese ? "0 = 源声道 1/2, 1 = 3/4…" : "0 = source channels 1/2, 1 = 3/4…"; }
                }
                HorizontalLayout { height: 30px; spacing: 12px;
                    Label { width: 108px; text: root.chinese ? "硬件输出对" : "Output pair"; }
                    LineEdit { width: 70px; enabled: !root.output-applying; text <=> root.pair-index; edited => { root.device-selected(root.device-index); } }
                    Label { horizontal-stretch: 1; text: root.chinese ? "0 = 1/2, 1 = 3/4, 2 = 5/6…" : "0 = outputs 1/2, 1 = 3/4, 2 = 5/6…"; }
                }
                Label { height: 43px; wrap: word-wrap; text: root.device-info; font-size: 11px; }
                if root.backend-index == 1 && !root.asio-enabled: Label { text: root.chinese ? "此版本未启用 ASIO。请使用 ASIO 构建版本。" : "ASIO is not enabled in this build. Use the ASIO edition."; color: Theme.warning; }
                HorizontalLayout { height: 33px; spacing: 8px;
                    if root.backend-index == 1: Action { width: 146px; enabled: root.asio-enabled && !root.devices-loading && !root.output-applying; label: root.chinese ? "应用并打开驱动面板" : "Apply + driver panel"; clicked => { root.control-panel-requested(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 84px; enabled: !root.output-applying; label: root.chinese ? "关闭" : "Close"; clicked => { root.settings-visible = false; } }
                    Action { width: 108px; primary: true; enabled: !root.devices-loading && !root.output-applying; label: root.output-applying ? (root.chinese ? "应用中…" : "Applying…") : (root.chinese ? "应用设置" : "Apply output"); clicked => { root.output-apply-requested(); } }
                }
            }
        }
    }
    debug-dialog := FocusScope {
        visible: root.debug-visible;
        enabled: root.debug-visible;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.debug-visible = false; return accept; }
            reject
        }
        key-pressed(event) => { accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
            TouchArea { }
            Rectangle { width: min(740px, parent.width - 32px); height: min(640px, parent.height - 32px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 20px; spacing: 8px;
                    Text { text: root.chinese ? "反馈问题与诊断日志" : "Bug report and diagnostics"; color: Theme.ink; font-size: 22px; font-weight: 600; }
                    Label { height: 36px; wrap: word-wrap; text: root.chinese ? "1. 开启 Debug → 关闭此窗口并复现 → 2. 返回生成报告 → 3. 检查并提交。开关仅在本次运行有效。" : "1. Enable Debug, close this panel and reproduce → 2. Generate a report → 3. Review and submit. Capture lasts for this run only."; }
                    HorizontalLayout { height: 32px; spacing: 10px;
                        Action { width: 190px; enabled: !root.debug-busy; active: root.debug-enabled; label: root.debug-enabled ? (root.chinese ? "Debug 已开启 · 停止记录" : "Debug on · stop capture") : (root.chinese ? "开启 Debug 记录" : "Enable Debug capture"); clicked => { root.debug-mode-requested(!root.debug-enabled); } }
                        Label { horizontal-stretch: 1; wrap: word-wrap; text: root.chinese ? "仅记录脱敏状态；不自动上传普通日志。" : "Captures safe state fields; raw logs are not uploaded."; }
                    }
                    LineEdit { height: 32px; enabled: !root.debug-busy; input-label: root.chinese ? "问题标题" : "Issue title"; text <=> root.debug-title; placeholder-text: root.chinese ? "例如：播放后搜索结果丢失" : "e.g. Search results disappear after playback"; edited => { root.debug-report = ""; root.debug-issue-url = ""; } }
                    Label { text: root.chinese ? "复现步骤、预期行为和实际行为（会公开到 GitHub，请勿填写凭据或私密路径）" : "Steps, expected and actual behavior (public on GitHub; omit credentials and private paths)"; wrap: word-wrap; }
                    TextEdit { height: 64px; enabled: !root.debug-busy; accessible-label: root.chinese ? "复现步骤" : "Reproduction steps"; text <=> root.debug-steps; edited => { root.debug-report = ""; root.debug-issue-url = ""; } }
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Action { width: 170px; enabled: !root.debug-busy; label: root.debug-busy ? (root.chinese ? "正在生成…" : "Generating…") : (root.chinese ? "生成并保存脱敏报告" : "Generate and save report"); clicked => { root.debug-action-requested(0); } }
                        Action { width: 126px; label: root.chinese ? "打开日志目录" : "Open log folder"; clicked => { root.debug-action-requested(2); } }
                        Label { horizontal-stretch: 1; text: root.debug-enabled ? (root.chinese ? "正在记录" : "Capturing") : (root.chinese ? "Debug 已关闭" : "Debug off"); color: root.debug-enabled ? Theme.accent : Theme.dim; }
                    }
                    TextEdit { vertical-stretch: 1; min-height: 70px; accessible-label: root.chinese ? "脱敏报告预览" : "Diagnostic report preview"; read-only: true; font-size: 11px; text: root.debug-report; }
                    Label { height: 40px; wrap: word-wrap; text: root.debug-feedback == "" ? (root.chinese ? "报告不包含数据库、WAV、搜索原文或服务器凭据。GitHub 页面需登录并最后点击创建 Issue。" : "No database, WAV, search text or server credentials are included. Sign in on GitHub and click Create issue to submit.") : root.debug-feedback; }
                    HorizontalLayout { height: 34px; spacing: 8px;
                        Action { width: 120px; enabled: root.debug-report != "" && !root.debug-busy; label: root.chinese ? "复制完整报告" : "Copy full report"; clicked => { root.copy-text(root.debug-report); } }
                        Rectangle { horizontal-stretch: 1; }
                        debug-close-action := Action { width: 84px; label: root.chinese ? "关闭" : "Close"; clicked => { root.debug-visible = false; } }
                        Action { width: 180px; primary: true; enabled: root.debug-report != "" && root.debug-issue-url != "" && !root.debug-busy; label: root.chinese ? "在 GitHub 提交问题…" : "Open GitHub issue…"; clicked => { root.copy-text(root.debug-report); root.debug-action-requested(1); } }
                    }
                }
            }
        }
    }
    if root.help-visible: HelpPanel {
        chinese: root.chinese;
        close => { root.help-visible = false; }
    }
    if root.about-visible: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 520px; height: 420px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 28px; spacing: 18px;
                Text { text: "AudioLib Explorer"; color: Theme.ink; font-size: 25px; font-weight: 600; }
                Label { text: root.app-version + " · Rust desktop"; color: Theme.accent; }
                Text { text: root.chinese ? "为声音设计师打造的 WAV / BWF 素材库。\nSQLite FTS5 搜索、Metadata 整理与低延迟试听。" : "A WAV / BWF library for sound designers.\nSQLite FTS5 search, Metadata editing and low-latency audition."; color: Theme.dim; wrap: word-wrap; }
                Text { text: "Made with Slint\nhttps://slint.dev"; color: Theme.ink; font-size: 13px; }
                Label { text: "Slint © SixtyFPS GmbH · Third-party notices ship with the application."; wrap: word-wrap; }
                Action { height: 34px; primary: true; label: root.chinese ? "关闭" : "Close"; clicked => { root.about-visible = false; } }
            }
        }
    }
    library-dialog := FocusScope {
        visible: root.library-visible;
        enabled: root.library-visible && !root.sm-fs-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <bool> reverse-wrap: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-modal(); return accept; }
            if root.confirmation-visible || root.library-busy || root.closing { return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && library-close-action.has-focus {
                self.reverse-wrap = true;
                library-tab-end.focus();
                self.reverse-wrap = false;
                // Slint's normal reverse traversal now starts at the sentinel,
                // visiting the last visible control even with maintenance open.
                return reject;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab { return reject; }
            accept
        }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: min(root.width - 40px, 1080px); height: min(root.height - 40px, 720px); x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 20px; spacing: 10px;
                HorizontalLayout { height: 32px; spacing: 8px;
                    Text { horizontal-stretch: 1; vertical-alignment: center; text: root.chinese ? "音效库管理" : "Sound library management"; color: Theme.ink; font-size: 22px; font-weight: 600; }
                    library-close-action := Action { width: 60px; enabled: !root.library-busy && !root.ds-applying && !root.sm-manage-busy; label: root.chinese ? "关闭" : "Close"; clicked => { root.close-library-manager(); } }
                }
                HorizontalLayout { height: 34px; spacing: 8px;
                    Action { width: 160px; active: !root.sm-server; enabled: !root.ds-applying && !root.library-busy; label: root.chinese ? "本地设置" : "Local settings"; clicked => { root.sm-select-row(0); } }
                    Action { width: 160px; active: root.sm-server; enabled: !root.ds-applying && !root.library-busy; label: root.chinese ? "服务器设置" : "Server settings"; clicked => { if !root.sm-server { root.sm-select-row(root.sm-sources.length > 1 ? 1 : -1); } } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout { spacing: 14px;
                    // Source list first in the tree, so reverse Tab from Close still wraps to
                    // the last control of the right pane.
                    if root.library-visible: VerticalLayout { width: 232px; spacing: 6px;
                        Text { height: 18px; text: root.chinese ? "数据源" : "Data sources"; color: Theme.dim; font-size: 12px; font-weight: 600; }
                        // Up/Down move the selection like a click (unsaved edits prompt first).
                        source-keys := FocusScope { vertical-stretch: 1;
                            key-pressed(event) => {
                                if event.text == Key.UpArrow {
                                    root.sm-step(false);
                                    return accept;
                                }
                                if event.text == Key.DownArrow {
                                    root.sm-step(true);
                                    return accept;
                                }
                                reject
                            }
                        Rectangle { background: Theme.bg; border-radius: 6px; border-width: 1px; border-color: source-keys.has-focus ? Theme.accent : Theme.border;
                            ScrollView { viewport-width: self.visible-width;
                                VerticalLayout { padding: 4px; spacing: 3px; alignment: start;
                                    for source[index] in root.sm-sources: Rectangle { height: 58px; border-radius: 5px; background: root.sm-selected == index ? Theme.selected : (source-hit.has-hover ? Theme.hover : transparent);
                                        VerticalLayout { padding-left: 8px; padding-right: 6px; padding-top: 5px; padding-bottom: 5px; spacing: 1px;
                                            Text { text: (source.active ? "● " : "○ ") + (source.kind == 0 ? (root.chinese ? "本地素材库" : "Local library") : source.name); color: source.active ? Theme.accent : Theme.ink; font-size: 12px; font-weight: 600; overflow: elide; }
                                            Text { text: source.subtitle; color: Theme.muted; font-size: 10px; overflow: elide; }
                                            Text { text: source.active ? ((root.chinese ? "当前数据源" : "Active") + (source.status != "" ? " · " + source.status : "")) : source.status; color: source.status-kind == 3 ? Theme.warning : (source.status-kind == 1 ? Theme.accent : Theme.dim); font-size: 10px; overflow: elide; }
                                        }
                                        source-hit := TouchArea { enabled: !root.ds-applying && !root.library-busy; mouse-cursor: pointer; clicked => { source-keys.focus(); root.sm-select-row(index); } }
                                    }
                                    if root.sm-new: Rectangle { height: 40px; border-radius: 5px; background: Theme.selected;
                                        Text { x: 8px; height: parent.height; vertical-alignment: center; text: root.chinese ? "＋ 新服务器（未保存）" : "+ New server (unsaved)"; color: Theme.ink; font-size: 12px; }
                                    }
                                }
                            }
                        }
                        }
                        if root.sm-pending-select != -2: VerticalLayout { spacing: 4px;
                            Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.chinese ? "连接页有未保存的修改。" : "The connection page has unsaved changes."; }
                            HorizontalLayout { height: 30px; spacing: 4px;
                                Action { horizontal-stretch: 1; primary: true; enabled: !root.ds-applying && !root.library-busy; label: root.chinese ? "保存" : "Save"; clicked => { root.sm-pending-save-requested(root.sm-pending-select); } }
                                Action { horizontal-stretch: 1; enabled: !root.ds-applying; label: root.chinese ? "放弃修改" : "Discard"; clicked => { root.sm-discard-pending(); } }
                                Action { horizontal-stretch: 1; enabled: !root.ds-applying; label: root.chinese ? "取消" : "Cancel"; clicked => { root.sm-pending-select = -2; } }
                            }
                        }
                        Action { height: 30px; enabled: !root.ds-applying && !root.library-busy && !root.sm-new && root.sm-pending-select == -2; label: root.chinese ? "＋ 添加服务器" : "+ Add server"; clicked => { root.sm-select-row(-1); } }
                        if root.sm-selected > 0 && !root.sm-confirm-delete: Action { height: 30px; enabled: !root.ds-applying && !root.library-busy && !root.sm-active; label: root.chinese ? "删除此服务器配置…" : "Delete this server profile…"; clicked => { root.sm-confirm-delete = true; } }
                        if root.sm-selected > 0 && root.sm-active && !root.sm-confirm-delete: Label { wrap: word-wrap; font-size: 10px; color: Theme.muted; text: root.chinese ? "当前数据源不能删除，请先切换到其他数据源。" : "The active source cannot be deleted; switch to another source first."; }
                        if root.sm-confirm-delete: VerticalLayout { spacing: 4px;
                            Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.chinese ? "删除此连接配置及其令牌？不会删除任何缓存、快照或数据目录，服务器上的音效库也不受影响。" : "Delete this connection profile and its token? No cache, snapshot or data directory is deleted, and the server library is not affected."; }
                            HorizontalLayout { height: 30px; spacing: 6px;
                                Action { horizontal-stretch: 1; enabled: !root.ds-applying; label: root.chinese ? "确认删除" : "Delete profile"; clicked => { root.sm-confirm-delete = false; root.sm-delete-requested(); } }
                                Action { horizontal-stretch: 1; label: root.chinese ? "取消" : "Keep"; clicked => { root.sm-confirm-delete = false; } }
                            }
                        }
                    }
                    VerticalLayout { horizontal-stretch: 1; spacing: 8px;
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Text { horizontal-stretch: 1; vertical-alignment: center; overflow: elide; color: Theme.ink; font-size: 15px; font-weight: 600; text: root.sm-title; }
                            if root.library-visible && !root.sm-new && !root.sm-active: Action { width: 150px; primary: true; enabled: !root.ds-applying && !root.library-busy && !root.ds-syncing; label: root.sm-server && root.ds-dirty ? (root.chinese ? "保存并切换" : "Save and switch") : (root.chinese ? "切换到此数据源" : "Switch to this source"); clicked => { root.sm-switch-requested(); } }
                        }
                        if root.library-visible && root.sm-server: HorizontalLayout { height: 30px; spacing: 6px;
                            Action { width: 96px; active: root.sm-page == 0; enabled: !root.ds-applying; label: root.chinese ? "连接" : "Connection"; clicked => { root.sm-page = 0; root.sm-page-selected(0); } }
                            Action { width: 120px; active: root.sm-page == 1; enabled: !root.ds-applying && !root.sm-new; label: root.chinese ? "服务器音效库" : "Server library"; clicked => { root.sm-page = 1; root.sm-page-selected(1); } }
                            Action { width: 110px; active: root.sm-page == 2; enabled: !root.ds-applying && !root.sm-new; label: root.chinese ? "缓存与导出" : "Cache and export"; clicked => { root.sm-page = 2; root.sm-page-selected(2); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.library-visible && root.sm-server && root.sm-page == 2: VerticalLayout { spacing: 6px;
                            Text { text: root.sm-cache-info; color: Theme.ink; font-size: 11px; wrap: word-wrap; }
                            Label { wrap: word-wrap; font-size: 11px; color: Theme.muted; text: root.chinese ? "快照按服务器音效库（library id）缓存，同一服务器的局域网和外网配置共用一份。删除服务器配置不会删除缓存或数据目录。" : "Snapshots are cached per server library (library id), shared by a server's LAN and external profiles. Deleting a profile never deletes caches or data directories."; }
                            if root.sm-active: HorizontalLayout { height: 32px; spacing: 8px;
                                Action { width: 110px; enabled: !root.ds-syncing && !root.ds-applying && root.remote-mode && !root.library-busy; label: root.ds-syncing ? (root.chinese ? "同步中…" : "Syncing…") : (root.chinese ? "立即同步" : "Sync now"); clicked => { root.data-source-sync-requested(); } }
                                Label { horizontal-stretch: 1; vertical-alignment: center; font-size: 11px; overflow: elide; text: root.ds-sync-info; }
                            }
                            if root.sm-active && root.ds-syncing: Rectangle { height: 6px; background: Theme.border; border-radius: 3px;
                                Rectangle { x: root.ds-progress >= 0 ? 0px : (parent.width - self.width) * root.ds-motion; width: root.ds-progress >= 0 ? parent.width * clamp(root.ds-progress, 0, 1) : parent.width * 0.3; height: parent.height; background: Theme.accent; border-radius: 3px; }
                            }
                            if root.sm-active && root.ds-syncing: Label { font-size: 11px; color: Theme.muted; text: root.ds-elapsed; }
                            if root.ds-message != "": Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.ds-message; }
                            if !root.sm-active: Label { wrap: word-wrap; font-size: 11px; text: root.chinese ? "切换到此数据源后，可在这里同步快照、查看扫描历史与最近播放、校验、备份副本和导出。" : "Switch to this source to sync its snapshot, view scan history and recent playback, check, back up a copy and export here."; }
                            Rectangle { height: 1px; background: Theme.border; }
                        }
                        Rectangle { vertical-stretch: 1;
                            // The library management content (unchanged; hidden, not destroyed,
                            // so its state and element ids survive selection changes).
                            Rectangle { width: parent.width; height: parent.height; visible: root.sm-local-content;
                                VerticalLayout { spacing: 10px;
                                    Label { height: 24px; text: root.library-health; color: Theme.accent; }
                                    if root.library-feedback != "": Text { height: 34px; text: root.library-feedback; color: Theme.accent; wrap: word-wrap; font-size: 11px; }
                                    library-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                                        VerticalLayout { spacing: 12px; padding-right: 8px; alignment: start;
                                            Text { height: 24px; text: root.chinese ? "扫描与更新" : "Scan and update"; color: Theme.ink; font-size: 15px; font-weight: 600; }
                                            Label { height: 32px; text: root.chinese ? "添加新音效用增量扫描；整理或移动文件后，用全量扫描检查所选文件夹。均包含子文件夹。" : "Use incremental scans to add sounds; use full scans to recheck a folder after reorganizing files. Both include subfolders."; wrap: word-wrap; }
                                            if root.remote-mode: Text { text: root.chinese ? "服务器模式只读：扫描、修复、维护、恢复、新建/打开库和导入标注不可用；校验、备份副本和导出仍可使用。服务器允许本机管理时，可从编辑菜单或右键菜单移除服务器音效库的记录（WAV 文件不受影响），扫描在「服务器音效库」页。" : "Read-only in server mode: scans, repair, maintenance, restore, new/open library and annotation import are unavailable; check, backup copy and export still work. When the server lets this PC manage, Edit and the context menus remove server library records (WAV files are untouched); scans run on the Server library page."; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
                                            HorizontalLayout { height: 36px; spacing: 8px;
                                                Action { horizontal-stretch: 1; primary: true; enabled: !root.library-busy && !root.scanning && !root.remote-mode; label: root.chinese ? "添加文件夹…" : "Add folder…"; clicked => { root.prepare-scan(0, ""); } }
                                                Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.scanning && !root.remote-mode; label: root.chinese ? "增量扫描…" : "Incremental scan…"; clicked => { root.prepare-scan(0, root.selected-folder-path); } }
                                                Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.scanning && !root.remote-mode; label: root.chinese ? "全量扫描…" : "Full scan…"; clicked => { root.prepare-scan(1, root.selected-folder-path); } }
                                            }
                                            if root.scanning: HorizontalLayout { height: 34px; spacing: 8px;
                                                Label { horizontal-stretch: 1; text: root.scan-paused ? (root.chinese ? "扫描已请求暂停，可继续或取消。" : "Pause requested. Resume or cancel at any time.") : (root.chinese ? "扫描正在后台进行，可以继续浏览和试听。" : "Scanning in the background. You can keep browsing and auditioning."); }
                                                Action { width: 110px; enabled: root.scan-controllable && !root.scan-validating; label: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); clicked => { root.scan-pause-requested(); } }
                                                Action { width: 130px; enabled: root.scan-controllable; label: root.chinese ? "取消当前扫描" : "Cancel current scan"; clicked => { root.scan-cancel-requested(); } }
                                            }
                                            if root.scan-summary != "": Text { height: 44px; text: root.scan-summary; color: Theme.accent; wrap: word-wrap; font-size: 11px; }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            HorizontalLayout { height: 62px; spacing: 16px;
                                                VerticalLayout { horizontal-stretch: 1; spacing: 4px;
                                                    Text { text: root.chinese ? "缺失文件与引用修复" : "Missing files and references"; color: Theme.ink; font-size: 15px; font-weight: 600; }
                                                    Label { text: root.chinese ? "查看缺失声音，逐个选择移动或改名后的 WAV。保留标签、收藏和备注。" : "Find missing sounds and locate each moved or renamed WAV. Keep tags, favorites and notes."; wrap: word-wrap; }
                                                }
                                                Action { width: 176px; enabled: !root.library-busy; label: root.chinese ? "修复文件引用" : "Repair file references"; clicked => { root.show-missing-files(); } }
                                            }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            HorizontalLayout { height: 32px; spacing: 8px;
                                                ComboBox { width: 174px; enabled: !root.library-busy; model: root.chinese ? ["扫描历史", "最近播放"] : ["Scan history", "Recent playback"]; current-index <=> root.history-kind; selected => { root.history-requested(0); } }
                                                Action { width: 80px; enabled: !root.library-busy; label: root.chinese ? "刷新历史" : "Refresh"; clicked => { root.history-requested(0); } }
                                                Rectangle { horizontal-stretch: 1; }
                                                Action { width: 35px; enabled: root.history-previous && !root.library-busy; label: "‹"; clicked => { root.history-requested(-1); } }
                                                Label { width: 68px; text: root.history-page; horizontal-alignment: center; }
                                                Action { width: 35px; enabled: root.history-next && !root.library-busy; label: "›"; clicked => { root.history-requested(1); } }
                                            }
                                            ListView { height: 150px;
                                                for history[index] in root.history-rows: Rectangle { height: 56px; background: Math.mod(index,2) == 0 ? Theme.raised : Theme.panel;
                                                    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: history; color: Theme.ink; font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                                                    TouchArea { enabled: !root.library-busy; mouse-cursor: pointer; clicked => { root.history-selected(index); } }
                                                }
                                            }
                                            if root.history-rows.length == 0: Text { height: 32px; text: root.chinese ? "暂无历史记录。扫描文件夹后，可在这里查看结果与错误详情。" : "No history yet. Scan a folder to see results and error details here."; color: Theme.dim; wrap: word-wrap; font-size: 11px; }
                                            if root.history-detail != "": TextEdit { height: 110px; read-only: true; text: root.history-detail; }
                                            Label { height: 22px; text: root.chinese ? "点击扫描记录查看结果；点击播放记录查看声音详情。" : "Click a scan for its results, or a play record for sound details."; font-size: 10px; }
                                            library-maintenance-action := Action { height: 32px; enabled: !root.library-busy; subtle: true; label: root.advanced-maintenance-visible ? (root.chinese ? "高级维护 ▾" : "Advanced maintenance ▾") : (root.chinese ? "高级维护 ▸" : "Advanced maintenance ▸"); clicked => { root.advanced-maintenance-visible = !root.advanced-maintenance-visible; } }
                                            if root.advanced-maintenance-visible: VerticalLayout { spacing: 8px;
                                                Label { height: 28px; text: root.chinese ? "数据库与数据交换工具。日常添加音效、扫描和引用修复使用上方操作即可。" : "Database and data exchange tools. Use the actions above for everyday sound-library work."; wrap: word-wrap; }
                                                Text { height: 34px; text: root.database-path; color: Theme.dim; wrap: word-wrap; font-size: 11px; }
                                                Label { height: 28px; text: root.database-info; wrap: word-wrap; }
                                                HorizontalLayout { height: 32px; spacing: 6px;
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "新建库…" : "New…"; clicked => { root.library-action(6); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "打开库…" : "Open…"; clicked => { root.library-action(7); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy; label: root.chinese ? "备份…" : "Backup…"; clicked => { root.library-action(1); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "恢复…" : "Restore…"; clicked => { root.library-action(2); } }
                                                }
                                                HorizontalLayout { height: 32px; spacing: 6px;
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy; label: root.chinese ? "校验 / FTS5" : "Check / FTS5"; clicked => { root.library-action(3); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "优化" : "Optimize"; clicked => { root.library-action(4); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "重建搜索" : "Rebuild FTS5"; clicked => { root.library-action(5); } }
                                                }
                                                HorizontalLayout { height: 32px; spacing: 6px;
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy; label: root.chinese ? "导出全库 JSONL…" : "Export all JSONL…"; clicked => { root.library-action(8); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy; label: root.chinese ? "导出全库 CSV…" : "Export all CSV…"; clicked => { root.library-action(9); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.remote-mode; label: root.chinese ? "导入标注…" : "Import annotations…"; clicked => { root.library-action(10); } }
                                                    Action { width: 92px; enabled: !root.library-busy; label: root.chinese ? "刷新信息" : "Refresh"; clicked => { root.library-action(0); } }
                                                }
                                                TextEdit { height: 110px; read-only: true; text: root.management-report; }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.library-visible && root.sm-selected == 0 && root.remote-mode: VerticalLayout { width: parent.width; height: parent.height; spacing: 10px; alignment: start;
                                Label { wrap: word-wrap; text: root.chinese ? "本地素材库当前未生效（正在使用服务器）。扫描、修复引用和高级维护需要先切换到本地模式；切换不会改动本地素材库，也不影响服务器。" : "The local library is not active (a server is in use). Scans, reference repair and maintenance need local mode; switching changes neither the local library nor the server."; }
                                Text { text: root.sm-local-path; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                                if root.ds-message != "": Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.ds-message; }
                            }
                            if root.library-visible && root.sm-server && root.sm-page == 0: VerticalLayout { width: parent.width; height: parent.height; spacing: 8px;
                                connection-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                                    VerticalLayout { spacing: 8px; padding-right: 10px; alignment: start;
                                        HorizontalLayout { height: 30px; spacing: 12px;
                                            Label { width: 118px; text: root.chinese ? "名称" : "Name"; vertical-alignment: center; }
                                            LineEdit { input-label: root.chinese ? "服务器配置名称" : "Server profile name"; enabled: !root.ds-applying; text <=> root.ds-name; placeholder-text: root.chinese ? "例如 家里 Mac（局域网）；留空 = 使用地址" : "e.g. Home Mac (LAN); empty = the address"; edited => { root.ds-dirty = true; } }
                                        }
                                        HorizontalLayout { height: 30px; spacing: 8px;
                                            Label { width: 118px; text: root.chinese ? "服务器地址" : "Server address"; vertical-alignment: center; }
                                            Action { width: 104px; active: root.ds-address-form == 0; enabled: !root.ds-applying; label: root.chinese ? "完整地址" : "Full URL"; clicked => { root.ds-address-form = 0; root.data-source-address-form-changed(); } }
                                            Action { width: 104px; active: root.ds-address-form == 1; enabled: !root.ds-applying; label: root.chinese ? "域名 + 端口" : "Domain + port"; clicked => { root.ds-address-form = 1; root.data-source-address-form-changed(); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            if root.ds-public-url != "": Action { width: 150px; enabled: !root.ds-applying; label: root.chinese ? "使用服务器外网地址" : "Use external address"; clicked => { root.data-source-use-public-url(); } }
                                        }
                                        if root.ds-address-form == 0: HorizontalLayout { height: 30px; spacing: 12px;
                                            Rectangle { width: 118px; }
                                            LineEdit { input-label: root.chinese ? "服务器地址" : "Server URL"; enabled: !root.ds-applying; text <=> root.ds-server-url; placeholder-text: "https://audiolib.example.com:8443 · http://server.example.lan:8790"; edited => { root.ds-dirty = true; root.data-source-address-edited(); } }
                                        }
                                        if root.ds-address-form == 1: HorizontalLayout { height: 30px; spacing: 8px;
                                            Rectangle { width: 114px; }
                                            ComboBox { width: 92px; enabled: !root.ds-applying; model: ["https://", "http://"]; current-index <=> root.ds-scheme; selected => { root.ds-dirty = true; root.data-source-address-edited(); } }
                                            LineEdit { horizontal-stretch: 1; input-label: root.chinese ? "服务器域名或 IP" : "Server domain or IP"; enabled: !root.ds-applying; text <=> root.ds-host; placeholder-text: root.chinese ? "域名或 IP，例如 audiolib.example.com" : "Domain or IP, e.g. audiolib.example.com"; edited => { root.ds-dirty = true; root.data-source-address-edited(); } }
                                            Label { text: ":"; vertical-alignment: center; }
                                            LineEdit { width: 76px; input-label: root.chinese ? "端口" : "Port"; enabled: !root.ds-applying; text <=> root.ds-port; placeholder-text: root.ds-scheme == 1 ? "80" : "443"; edited => { root.ds-dirty = true; root.data-source-address-edited(); } }
                                            LineEdit { width: 130px; input-label: root.chinese ? "路径前缀（可选）" : "Path prefix (optional)"; enabled: !root.ds-applying; text <=> root.ds-prefix; placeholder-text: root.chinese ? "/路径前缀（可选）" : "/prefix (optional)"; edited => { root.ds-dirty = true; root.data-source-address-edited(); } }
                                        }
                                        HorizontalLayout { spacing: 12px;
                                            Rectangle { width: 118px; }
                                            Label { horizontal-stretch: 1; wrap: word-wrap; font-size: 11px; color: root.ds-address-error ? Theme.warning : Theme.muted; text: root.ds-public-url != "" ? root.ds-address-hint + (root.chinese ? "\n服务器外网地址：" : "\nServer external address: ") + root.ds-public-url : root.ds-address-hint; }
                                        }
                                        HorizontalLayout { height: 30px; spacing: 12px;
                                            Label { width: 118px; text: root.chinese ? "访问令牌" : "Access token"; vertical-alignment: center; }
                                            LineEdit { input-label: root.chinese ? "访问令牌" : "Access token"; input-type: password; enabled: !root.ds-applying; text <=> root.ds-token; property <int> focus-serial: root.ds-token-focus-serial; changed focus-serial => { self.focus(); } edited => { root.ds-token-clear = false; root.ds-dirty = true; } placeholder-text: root.ds-token-clear ? (root.chinese ? "保存后将清除已保存的令牌" : "The saved token is cleared on save") : (root.ds-token-saved ? (root.chinese ? "已保存（不显示）· 留空保持不变，输入新令牌可替换" : "Saved (hidden) · empty keeps it, type to replace") : (root.chinese ? "局域网可留空；外网需要在服务器 /admin 页面生成的令牌" : "Optional on the LAN; over the internet use a token from the server's /admin page")); }
                                            Action { width: 92px; enabled: !root.ds-applying && root.ds-token-saved && !root.ds-token-clear; label: root.chinese ? "清除令牌" : "Clear token"; clicked => { root.ds-token = ""; root.ds-token-clear = true; root.ds-dirty = true; } }
                                        }
                                        HorizontalLayout { spacing: 12px;
                                            Rectangle { width: 118px; }
                                            Label { horizontal-stretch: 1; wrap: word-wrap; font-size: 11px; color: Theme.muted; text: root.chinese ? "令牌按服务器配置分别保存在本机（Windows DPAPI 加密），不会显示或写入日志。" : "Tokens are stored per server profile on this PC (Windows DPAPI), never shown or logged."; }
                                        }
                                        HorizontalLayout { height: 30px; spacing: 12px;
                                            Label { width: 118px; text: root.chinese ? "试听" : "Audition"; vertical-alignment: center; }
                                            CheckBox { enabled: !root.ds-applying; text: root.chinese ? "试听时转码（适合外网或低带宽）" : "Transcode auditions (for the internet or slow links)"; checked <=> root.ds-transcode; toggled => { root.ds-transcode-touched = true; root.ds-dirty = true; } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout { spacing: 12px;
                                            Rectangle { width: 118px; }
                                            Label { horizontal-stretch: 1; wrap: word-wrap; font-size: 11px; color: Theme.muted; text: root.chinese ? "每个服务器单独保存。勾选：服务器转成 16 位 PCM（带宽低时 FLAC）再传输；不勾选：始终传原始文件（局域网推荐）。" : "Saved per server. Checked: the server sends 16-bit PCM (FLAC on slow links); unchecked: always the original file (best on a LAN)."; }
                                        }
                                        HorizontalLayout { height: 30px; spacing: 12px;
                                            Label { width: 118px; text: root.chinese ? "版本检查间隔" : "Revision check"; vertical-alignment: center; }
                                            LineEdit { width: 80px; input-label: root.chinese ? "版本检查间隔（秒）" : "Revision check interval (seconds)"; enabled: !root.ds-applying; text <=> root.ds-poll-interval; placeholder-text: "60"; edited => { root.ds-dirty = true; } }
                                            Label { text: root.chinese ? "秒（0 = 关闭）" : "seconds (0 = off)"; vertical-alignment: center; }
                                            CheckBox { enabled: !root.ds-applying; text: root.chinese ? "有新版本时自动同步" : "Sync automatically when updated"; checked <=> root.ds-auto-sync; toggled => { root.ds-dirty = true; } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        Label { font-size: 11px; color: Theme.muted; text: root.chinese ? "版本检查与自动同步对所有服务器生效。" : "Revision checks and automatic sync apply to every server."; }
                                        Label { text: root.ds-last-test; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 176px; background: Theme.bg; border-radius: 6px; border-width: 1px; border-color: Theme.border;
                                            ScrollView {
                                                Text { x: 8px; y: 6px; width: parent.width - 16px; vertical-alignment: top; wrap: word-wrap; text: root.ds-report != "" ? root.ds-report : (root.chinese ? "测试结果将显示在这里（√ 成功 / × 失败 / ! 可选项未通过（不影响结果）/ – 跳过，含耗时）。试听默认走服务器流。" : "Test results appear here (√ ok / × failed / ! optional check failed (does not fail the test) / – skipped, with latency). Playback uses the server stream."); color: root.ds-report != "" ? Theme.ink : Theme.muted; font-size: 11px; }
                                            }
                                        }
                                    }
                                }
                                Rectangle { height: 44px; background: Theme.bg; border-radius: 6px; border-width: 1px; border-color: Theme.border;
                                    HorizontalLayout { padding: 8px; spacing: 12px;
                                        Text { text: root.chinese ? "WebDAV 设置（功能未开发）" : "WebDAV settings (not developed)"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                        LineEdit { input-label: root.chinese ? "WebDAV 设置（功能未开发）" : "WebDAV settings (not developed)"; enabled: false; text: ""; }
                                    }
                                }
                                if root.ds-syncing: Rectangle { height: 6px; background: Theme.border; border-radius: 3px;
                                    Rectangle { x: root.ds-progress >= 0 ? 0px : (parent.width - self.width) * root.ds-motion; width: root.ds-progress >= 0 ? parent.width * clamp(root.ds-progress, 0, 1) : parent.width * 0.3; height: parent.height; background: Theme.accent; border-radius: 3px; }
                                }
                                Label { wrap: word-wrap; font-size: 11px; text: root.ds-sync-info; }
                                if root.ds-syncing: Label { font-size: 11px; color: Theme.muted; text: root.ds-elapsed; }
                                if root.ds-message != "": Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.ds-message; }
                                HorizontalLayout { height: 33px; spacing: 8px;
                                    Action { width: 110px; enabled: !root.ds-testing && !root.ds-applying; label: root.ds-testing ? (root.chinese ? "测试中…" : "Testing…") : (root.chinese ? "测试连接" : "Test connection"); clicked => { root.data-source-test-requested(); } }
                                    if root.sm-active: Action { width: 110px; enabled: !root.ds-syncing && !root.ds-applying && root.remote-mode && !root.library-busy; label: root.ds-syncing ? (root.chinese ? "同步中…" : "Syncing…") : (root.chinese ? "立即同步" : "Sync now"); clicked => { root.data-source-sync-requested(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    Action { width: 84px; enabled: root.sm-pending-select == -2 && root.ds-dirty && !root.ds-applying; label: root.chinese ? "还原" : "Revert"; clicked => { root.sm-revert-requested(); } }
                                    Action { width: 132px; primary: true; enabled: root.sm-pending-select == -2 && !root.ds-applying && !root.library-busy; label: root.ds-applying ? (root.chinese ? "保存中…" : "Saving…") : (root.sm-new ? (root.chinese ? "保存为新服务器" : "Save new server") : (root.chinese ? "保存" : "Save")); clicked => { root.sm-save-requested(); } }
                                }
                            }
                            if root.library-visible && root.sm-server && root.sm-page == 1: VerticalLayout { width: parent.width; height: parent.height; spacing: 8px;
                                HorizontalLayout { height: 30px; spacing: 8px;
                                    Label { horizontal-stretch: 1; vertical-alignment: center; overflow: elide; font-size: 11px; color: root.sm-library-error ? Theme.warning : Theme.dim; text: root.sm-library-status; }
                                    Action { width: 84px; enabled: !root.sm-library-loading && !root.sm-manage-busy && !root.sm-root-form && root.sm-confirm == 0; label: root.sm-library-loading ? (root.chinese ? "读取中…" : "Loading…") : (root.chinese ? "刷新" : "Reload"); clicked => { root.sm-library-refresh-requested(); } }
                                }
                                Label { wrap: word-wrap; font-size: 11px; color: root.sm-can-manage ? Theme.ink : Theme.dim; text: root.sm-capabilities; }
                                ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                                    VerticalLayout { spacing: 6px; padding-right: 10px; alignment: start;
                                        Text { height: 22px; text: root.chinese ? "根目录" : "Roots"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                                        HorizontalLayout { height: 18px; spacing: 8px;
                                            Text { width: 150px; text: root.chinese ? "名称" : "Name"; color: Theme.muted; font-size: 10px; }
                                            Text { width: 96px; text: root.chinese ? "状态" : "Status"; color: Theme.muted; font-size: 10px; }
                                            Text { width: 72px; text: root.chinese ? "文件数" : "Files"; color: Theme.muted; font-size: 10px; }
                                            Text { width: 56px; text: root.chinese ? "缺失" : "Missing"; color: Theme.muted; font-size: 10px; }
                                            Text { horizontal-stretch: 1; text: root.chinese ? "上次扫描" : "Last scan"; color: Theme.muted; font-size: 10px; }
                                        }
                                        for row[index] in root.sm-roots: VerticalLayout { spacing: 2px;
                                            Rectangle { height: 52px; border-radius: 4px; background: root.sm-root-selected == index ? Theme.selected : (root-hit.has-hover ? Theme.hover : Theme.raised);
                                                accessible-role: button;
                                                accessible-label: row.name + " · " + row.path;
                                                accessible-enabled: !root.sm-manage-busy && !root.sm-root-form && root.sm-confirm == 0;
                                                accessible-action-default => { if !root.sm-manage-busy && !root.sm-root-form && root.sm-confirm == 0 { root.sm-root-selected = index; } }
                                                forward-focus: root-row-focus;
                                                border-width: root-row-focus.has-focus ? 1px : 0px;
                                                border-color: Theme.accent;
                                                VerticalLayout { padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 3px;
                                                    HorizontalLayout { height: 22px; spacing: 8px;
                                                        Text { width: 142px; text: row.name; color: Theme.ink; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                                        Text { width: 96px; text: row.status; color: row.offline ? Theme.warning : (row.scanning ? Theme.accent : Theme.ink); font-size: 11px; overflow: elide; vertical-alignment: center; }
                                                        Text { width: 72px; text: row.file-count; color: Theme.ink; font-size: 11px; vertical-alignment: center; }
                                                        Text { width: 56px; text: row.missing; color: Theme.ink; font-size: 11px; vertical-alignment: center; }
                                                        Text { horizontal-stretch: 1; text: row.last-scan; color: Theme.dim; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                                    }
                                                    Text { height: 16px; text: row.path; color: Theme.dim; font-size: 10px; overflow: elide; }
                                                }
                                                root-row-focus := FocusScope {
                                                    enabled: !root.sm-manage-busy && !root.sm-root-form && root.sm-confirm == 0;
                                                    focus-on-click: false;
                                                    key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.sm-root-selected = index; return accept; } reject }
                                                }
                                                root-hit := TouchArea { enabled: !root.sm-manage-busy && !root.sm-root-form && root.sm-confirm == 0; mouse-cursor: pointer; clicked => { root-row-focus.focus(); root.sm-root-selected = index; } }
                                            }
                                            if row.message != "": Text { text: row.message; color: Theme.warning; font-size: 10px; wrap: word-wrap; }
                                        }
                                        if root.sm-roots.length == 0: Label { font-size: 11px; text: root.sm-library-loading ? (root.chinese ? "正在读取服务器根目录…" : "Loading server roots…") : (root.chinese ? "没有根目录信息。" : "No root information."); }
                                        if root.sm-root-controls && !root.sm-root-form && root.sm-confirm != 5: HorizontalLayout { height: 30px; spacing: 6px;
                                            Action { width: 124px; primary: true; enabled: root.sm-root-ready; label: root.chinese ? "＋ 添加音效库" : "+ Add sound root"; clicked => { root.sm-confirm = 0; root.sm-scan-form = false; root.sm-root-add-requested(); } }
                                            Action { width: 130px; enabled: root.sm-root-ready && root.sm-root-has-selection; label: root.chinese ? "修改资源路径…" : "Edit resource path…"; clicked => { root.sm-confirm = 0; root.sm-scan-form = false; root.sm-root-edit-requested(); } }
                                            Action { width: 128px; enabled: root.sm-root-ready && root.sm-root-has-selection; label: root.chinese ? "删除音效库…" : "Delete sound root…"; clicked => { root.sm-scan-form = false; root.sm-confirm = 5; } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        if root.sm-root-form: Rectangle { border-radius: 5px; background: Theme.raised;
                                            VerticalLayout { padding: 12px; spacing: 7px;
                                                Text { height: 22px; text: root.sm-root-editing ? (root.chinese ? "修改音效库资源路径" : "Edit sound root resource path") : (root.chinese ? "添加服务器音效库" : "Add server sound root"); color: Theme.ink; font-size: 13px; font-weight: 600; }
                                                HorizontalLayout { height: 30px; spacing: 8px;
                                                    Label { width: 76px; text: root.chinese ? "音效库名称" : "Root name"; }
                                                    remote-root-name-input := LineEdit { horizontal-stretch: 1; enabled: !root.sm-manage-busy && !root.sm-root-editing; input-label: root.chinese ? "音效库名称" : "Root name"; text <=> root.sm-root-name; placeholder-text: root.chinese ? "例如 Foley、Ambience" : "For example Foley, Ambience"; }
                                                }
                                                HorizontalLayout { height: 30px; spacing: 8px;
                                                    Label { width: 76px; text: root.chinese ? "服务器目录" : "Server folder"; }
                                                    remote-root-path-input := LineEdit { horizontal-stretch: 1; enabled: !root.sm-manage-busy; input-label: root.chinese ? "服务器上的音效资源目录" : "Audio resource folder on the server"; text <=> root.sm-root-path; placeholder-text: root.chinese ? "输入服务器上的绝对目录路径，或浏览选择" : "Enter an absolute server folder path or browse"; }
                                                    Action { width: 82px; enabled: root.sm-root-ready; label: root.chinese ? "浏览…" : "Browse…"; clicked => { root.sm-fs-open-requested(); } }
                                                }
                                                Label { wrap: word-wrap; font-size: 10px; color: Theme.muted; text: root.sm-root-editing ? (root.chinese ? "目标目录必须已有相同相对路径的 WAV 文件。服务器验证后更新数据库资源路径，保留文件 id、Metadata 和标注。" : "The target must already contain the WAV files at the same relative paths. After verification, the server updates database resource paths and retains file ids, Metadata and annotations.") : (root.chinese ? "选择远程服务器上的现有目录。添加后可开始扫描，将 WAV 文件索引到服务器音效库。" : "Select an existing folder on the remote server. After adding it, start a scan to index its WAV files into the server library."); }
                                                if root.sm-root-message != "": Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.sm-root-message; }
                                                HorizontalLayout { height: 30px; spacing: 6px;
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Action { width: 72px; enabled: !root.sm-manage-busy; label: root.chinese ? "取消" : "Cancel"; clicked => { root.sm-root-form = false; } }
                                                    Action { width: 110px; primary: true; enabled: root.sm-root-ready && root.sm-root-name != "" && root.sm-root-path != ""; label: root.sm-manage-busy ? (root.chinese ? "保存中…" : "Saving…") : (root.chinese ? "保存音效库" : "Save sound root"); clicked => { root.sm-root-save-requested(); } }
                                                }
                                            }
                                        }
                                        if root.sm-confirm == 5: Rectangle { border-radius: 5px; background: Theme.raised;
                                            VerticalLayout { padding: 12px; spacing: 7px;
                                                Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.sm-root-has-selection ? (root.chinese ? "删除服务器音效库「" + root.sm-roots[root.sm-root-selected].name + "」？将删除根目录配置、该目录下的数据库记录及标注。服务器上的目录和 WAV 文件不会改动。" : "Delete the server sound root \"" + root.sm-roots[root.sm-root-selected].name + "\"? Its root configuration, indexed records and annotations will be removed. Folders and WAV files on the server are untouched.") : (root.chinese ? "请选择要删除的音效库。" : "Select a sound root to delete."); }
                                                HorizontalLayout { height: 30px; spacing: 6px;
                                                    Action { width: 126px; primary: true; enabled: root.sm-root-ready && root.sm-root-has-selection; label: root.chinese ? "确认删除音效库" : "Delete sound root"; clicked => { root.sm-root-delete-requested(); root.sm-confirm = 0; } }
                                                    Action { width: 72px; enabled: !root.sm-manage-busy; label: root.chinese ? "取消" : "Cancel"; clicked => { root.sm-confirm = 0; } }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { height: 22px; text: root.chinese ? "服务器扫描" : "Server scan"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                                        Text { text: root.sm-scan-text; color: root.sm-scan-active ? Theme.accent : Theme.dim; font-size: 11px; wrap: word-wrap; }
                                        if root.sm-manage-note != "": Label { wrap: word-wrap; font-size: 10px; color: Theme.muted; text: root.sm-manage-note; }
                                        if !root.sm-scan-form: HorizontalLayout { height: 30px; spacing: 6px;
                                            Action { width: 104px; enabled: root.sm-manageable && !root.sm-scan-active && !root.sm-manage-busy && !root.library-busy && !root.sm-root-form && root.sm-root-names.length > 0; label: root.chinese ? "开始扫描…" : "Start a scan…"; clicked => { root.sm-confirm = 0; root.sm-scan-form = true; } }
                                            Action { width: 72px; enabled: root.sm-manageable && root.sm-scan-active && !root.sm-manage-busy; label: root.sm-scan-paused ? (root.chinese ? "继续" : "Resume") : (root.chinese ? "暂停" : "Pause"); clicked => { root.sm-scan-control-requested(root.sm-scan-paused ? 1 : 0); } }
                                            Action { width: 84px; enabled: root.sm-manageable && root.sm-scan-active && !root.sm-manage-busy; label: root.chinese ? "取消扫描" : "Cancel scan"; clicked => { root.sm-scan-control-requested(2); } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        if root.sm-scan-form: VerticalLayout { spacing: 6px;
                                            HorizontalLayout { height: 30px; spacing: 8px;
                                                Label { width: 64px; text: root.chinese ? "根目录" : "Root"; vertical-alignment: center; }
                                                ComboBox { width: 190px; enabled: !root.sm-manage-busy; model: root.sm-root-names; current-index <=> root.sm-scan-root; }
                                                Label { width: 40px; text: root.chinese ? "模式" : "Mode"; vertical-alignment: center; }
                                                ComboBox { width: 220px; enabled: !root.sm-manage-busy; model: root.chinese ? ["增量（新增和修改）", "完整（重新读取并检查缺失）"] : ["Incremental (new and modified)", "Full (re-read, detect missing)"]; current-index <=> root.sm-scan-mode; }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            HorizontalLayout { height: 30px; spacing: 8px;
                                                Label { width: 64px; text: root.chinese ? "子目录" : "Subfolder"; vertical-alignment: center; }
                                                LineEdit { horizontal-stretch: 1; enabled: !root.sm-manage-busy; input-label: root.chinese ? "子目录（可选）" : "Subfolder (optional)"; text <=> root.sm-scan-subpath; placeholder-text: root.chinese ? "可选：根目录内的相对路径，例如 Foley/Doors；留空 = 整个根目录" : "Optional: a path inside the root, e.g. Foley/Doors; empty = the whole root"; }
                                            }
                                            Label { wrap: word-wrap; font-size: 10px; color: Theme.muted; text: root.chinese ? "增量扫描只处理新增和修改的文件；完整扫描重新读取全部文件，并把找不到的记录标为缺失。并行数使用服务器默认值。同一时间只能运行一个扫描。" : "Incremental scans only process new and modified files; full scans re-read every file and mark records whose file is gone as missing. Workers use the server default. One scan runs at a time."; }
                                            HorizontalLayout { height: 30px; spacing: 6px;
                                                Action { width: 96px; primary: true; enabled: root.sm-manageable && !root.sm-scan-active && !root.sm-manage-busy && !root.library-busy; label: root.sm-manage-busy ? (root.chinese ? "正在开始…" : "Starting…") : (root.chinese ? "开始" : "Start"); clicked => { root.sm-scan-start-requested(); } }
                                                Action { width: 72px; enabled: !root.sm-manage-busy; label: root.chinese ? "取消" : "Cancel"; clicked => { root.sm-scan-form = false; } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        if root.sm-manage-message != "": Label { wrap: word-wrap; font-size: 11px; color: root.sm-manage-error ? Theme.warning : Theme.accent; text: root.sm-manage-message; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { height: 22px; text: root.chinese ? "扫描历史（最近 20 次）" : "Scan history (latest 20)"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                                        for line[index] in root.sm-history: Rectangle { height: 40px; background: Math.mod(index, 2) == 0 ? Theme.raised : Theme.panel;
                                            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: line; color: Theme.ink; font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                                        }
                                        if root.sm-history.length == 0: Label { font-size: 11px; text: root.chinese ? "暂无扫描历史。" : "No scan history."; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { height: 22px; text: root.chinese ? "记录维护" : "Record maintenance"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                                        Label { wrap: word-wrap; font-size: 11px; text: root.chinese ? "只删除服务器音效库里的记录（含标签、备注等标注），服务器上的 WAV 文件不会改动；重新扫描会以新的 id 把它们加回。扫描进行中不能移除。" : "Only removes records (with their tags and notes) from the server library; WAV files on the server are untouched, and a rescan adds them back with new ids. Not possible while a scan runs."; }
                                        Label { wrap: word-wrap; font-size: 10px; color: Theme.muted; text: (root.chinese ? "主列表已选 " + root.checked-count + " 个记录 · 目录：" : "Main list: " + root.checked-count + " records selected · Folder: ") + (root.selected-folder-path != "" ? root.selected-folder-path : (root.chinese ? "未在目录树中选择" : "none selected in the folder tree")); }
                                        if root.sm-confirm == 0: HorizontalLayout { height: 30px; spacing: 6px;
                                            Action { width: 140px; enabled: root.sm-manageable && !root.sm-scan-active && !root.sm-manage-busy && !root.sm-root-form && !root.library-busy && root.checked-count > 0; label: root.chinese ? "移除所选记录…" : "Remove checked records…"; clicked => { root.sm-scan-form = false; root.sm-confirm = 1; } }
                                            Action { width: 120px; enabled: root.sm-manageable && !root.sm-scan-active && !root.sm-manage-busy && !root.sm-root-form && !root.library-busy && root.selected-folder-path != ""; label: root.chinese ? "删除目录记录…" : "Remove folder records…"; clicked => { root.sm-scan-form = false; root.sm-confirm = 2; } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        if root.sm-confirm == 1 || root.sm-confirm == 2: VerticalLayout { spacing: 6px;
                                            Label { wrap: word-wrap; font-size: 11px; color: Theme.warning; text: root.sm-confirm == 1 ? (root.chinese ? "从服务器音效库移除所选的 " + root.checked-count + " 个记录？只删除库记录及其标注，服务器上的 WAV 文件不会改动；重新扫描会以新的 id 把它们加回（标注不会恢复）。" : "Remove the " + root.checked-count + " selected records from the server library? Only the library records and their annotations are removed; WAV files on the server are untouched, and a rescan adds them back with new ids (annotations are not restored).") : (root.chinese ? "删除目录「" + root.selected-folder-path + "」及其子目录在服务器音效库中的全部记录？只删除库记录及其标注，服务器上的目录和 WAV 文件不会改动；重新扫描会以新的 id 把它们加回（标注不会恢复）。" : "Remove all records of the folder \"" + root.selected-folder-path + "\" and its subfolders from the server library? Only the library records and their annotations are removed; folders and WAV files on the server are untouched, and a rescan adds them back with new ids (annotations are not restored)."); }
                                            HorizontalLayout { height: 30px; spacing: 6px;
                                                Action { width: 120px; primary: true; enabled: root.sm-manageable && !root.sm-scan-active && !root.library-busy; label: root.sm-confirm == 1 ? (root.chinese ? "确认移除" : "Remove records") : (root.chinese ? "确认删除" : "Remove folder records"); clicked => { if root.sm-confirm == 1 { root.sm-remove-records-requested(); } else { root.sm-remove-folder-requested(); } root.sm-confirm = 0; } }
                                                Action { width: 72px; label: root.chinese ? "取消" : "Cancel"; clicked => { root.sm-confirm = 0; } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        // Wrap forward traversal after all library controls, including expanded maintenance.
        library-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !library-dialog.reverse-wrap { library-close-action.focus(); } } }
    }
    remote-folder-dialog := FocusScope {
        visible: root.library-visible && root.sm-fs-visible;
        enabled: root.library-visible && root.sm-fs-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <bool> reverse-wrap: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close-remote-folder(); return accept; }
            if root.closing { return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && remote-folder-close-action.has-focus {
                self.reverse-wrap = true;
                remote-folder-tab-end.focus();
                self.reverse-wrap = false;
                return reject;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab { return reject; }
            accept
        }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
            TouchArea { }
            Rectangle { width: min(root.width - 64px, 760px); height: min(root.height - 80px, 570px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 18px; spacing: 10px;
                    HorizontalLayout { height: 30px; spacing: 10px;
                        Text { horizontal-stretch: 1; text: root.chinese ? "选择远程文件夹" : "Choose remote folder"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                        remote-folder-close-action := Action { width: 36px; subtle: true; label: "×"; action-label: root.chinese ? "关闭远程文件夹选择" : "Close remote folder picker"; clicked => { root.close-remote-folder(); } }
                    }
                    Label { height: 18px; text: root.chinese ? "浏览已连接服务器上的文件夹。" : "Browse folders on the connected server."; color: Theme.muted; font-size: 11px; }
                    Rectangle { height: 1px; background: Theme.border; }
                    ScrollView { height: 34px; viewport-height: self.visible-height;
                        HorizontalLayout { padding: 0px; spacing: 4px; alignment: start;
                            Action { width: 70px; height: 30px; subtle: true; enabled: !root.sm-fs-busy; label: root.chinese ? "位置" : "Locations"; clicked => { root.sm-fs-navigate(""); } }
                            for crumb in root.sm-fs-breadcrumbs: HorizontalLayout { spacing: 3px;
                                Label { width: 10px; text: "›"; color: Theme.muted; }
                                Action { width: max(36px, crumb-measure.preferred-width + 18px); height: 30px; subtle: true; enabled: !root.sm-fs-busy; label: crumb.name; clicked => { root.sm-fs-navigate(crumb.path); }
                                    crumb-measure := Text { visible: false; text: crumb.name; font-size: 12px; }
                                }
                            }
                        }
                    }
                    HorizontalLayout { height: 30px; spacing: 6px;
                        Action { width: 82px; enabled: !root.sm-fs-busy && root.sm-fs-parent != ""; label: root.chinese ? "↑ 上级" : "↑ Parent"; clicked => { root.sm-fs-navigate(root.sm-fs-parent); } }
                        LineEdit { horizontal-stretch: 1; enabled: !root.sm-fs-busy; input-label: root.chinese ? "远程目录路径" : "Remote folder path"; text <=> root.sm-fs-path-draft; placeholder-text: root.chinese ? "服务器上的绝对目录路径" : "Absolute folder path on the server"; accepted => { if !root.sm-fs-busy && root.sm-fs-path-draft != "" { root.sm-fs-navigate(root.sm-fs-path-draft); } } }
                        Action { width: 54px; enabled: !root.sm-fs-busy && root.sm-fs-path-draft != ""; label: root.chinese ? "前往" : "Go"; clicked => { root.sm-fs-navigate(root.sm-fs-path-draft); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    ScrollView { vertical-stretch: 1; min-height: 120px; viewport-width: self.visible-width;
                        VerticalLayout { padding: 0px; spacing: 2px; alignment: start;
                            if root.sm-fs-parent != "": RemoteFolderAction { label: ".."; enabled: !root.sm-fs-busy; clicked => { root.sm-fs-navigate(root.sm-fs-parent); } }
                            for folder in root.sm-fs-rows: RemoteFolderAction { label: folder.name; enabled: !root.sm-fs-busy; clicked => { root.sm-fs-navigate(folder.path); } }
                            if root.sm-fs-busy: Label { height: 32px; text: root.chinese ? "正在读取远程目录…" : "Loading remote folders…"; color: Theme.muted; }
                            if !root.sm-fs-busy && root.sm-fs-rows.length == 0 && root.sm-fs-error == "": Label { height: 32px; text: root.chinese ? "此位置没有子文件夹。" : "No child folders at this location."; color: Theme.muted; }
                        }
                    }
                    if root.sm-fs-error != "": Label { wrap: word-wrap; text: root.sm-fs-error; color: Theme.warning; font-size: 11px; }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Text { horizontal-stretch: 1; text: root.sm-fs-path == "" ? (root.chinese ? "选择服务器位置" : "Choose a server location") : root.sm-fs-path; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
                        remote-folder-cancel-action := Action { width: 72px; subtle: true; label: root.chinese ? "取消" : "Cancel"; clicked => { root.close-remote-folder(); } }
                        Action { width: 112px; primary: true; enabled: root.sm-fs-can-select && !root.sm-fs-busy && root.sm-fs-path != ""; label: root.chinese ? "选择文件夹" : "Select folder"; clicked => { root.sm-root-path = root.sm-fs-path; root.close-remote-folder(); } }
                    }
                }
            }
        }
        remote-folder-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !remote-folder-dialog.reverse-wrap { remote-folder-close-action.focus(); } } }
    }
    if root.batch-visible: Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 610px; height: 470px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 24px; spacing: 11px;
                Text { text: (root.chinese ? "批量标注 · " : "Batch annotations · ") + root.checked-count; color: Theme.ink; font-size: 22px; }
                Label { text: root.chinese ? "仅应用选择的字段。所有记录在一个事务中更新。" : "Only enabled fields are applied. All records update in one transaction."; }
                HorizontalLayout { height: 32px; spacing: 8px;
                    CheckBox { width: 100px; text: root.chinese ? "标签" : "Tags"; checked <=> root.batch-tags-enabled; }
                    ComboBox { width: 120px; model: root.chinese ? ["替换", "追加", "移除"] : ["Replace", "Append", "Remove"]; current-index <=> root.batch-tag-mode; }
                    LineEdit { horizontal-stretch: 1; enabled: root.batch-tags-enabled; text <=> root.batch-tags; placeholder-text: root.chinese ? "逗号分隔标签" : "Comma-separated tags"; }
                }
                HorizontalLayout { height: 32px; spacing: 8px;
                    ComboBox { horizontal-stretch: 1; model: root.chinese ? ["收藏不变", "设为收藏", "取消收藏"] : ["Keep favorite", "Favorite", "Unfavorite"]; current-index <=> root.batch-favorite; }
                }
                HorizontalLayout { height: 32px; spacing: 8px;
                    CheckBox { width: 100px; text: root.chinese ? "颜色" : "Color"; checked <=> root.batch-color-enabled; }
                    LineEdit { horizontal-stretch: 1; enabled: root.batch-color-enabled; text <=> root.batch-color; placeholder-text: root.chinese ? "#RRGGBB，空值清除" : "#RRGGBB, empty clears"; }
                }
                CheckBox { text: root.chinese ? "替换备注（空值清除）" : "Replace notes (empty clears)"; checked <=> root.batch-notes-enabled; }
                TextEdit { height: 100px; enabled: root.batch-notes-enabled; text <=> root.batch-notes; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { height: 34px; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 90px; label: root.chinese ? "取消" : "Cancel"; clicked => { root.batch-visible = false; } }
                    Action { width: 150px; primary: true; enabled: root.checked-count > 0 && !root.library-busy && !root.remote-writes-blocked; label: root.chinese ? "应用到选择记录" : "Apply to selected"; clicked => { root.batch-requested(); } }
                }
            }
        }
    }
    confirmation-dialog := FocusScope {
        visible: root.confirmation-visible;
        enabled: root.confirmation-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-modal(); return accept; }
            if root.library-busy || root.closing { return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                if confirmation-cancel-action.has-focus { confirmation-continue-action.focus(); }
                else { confirmation-cancel-action.focus(); }
                return accept;
            }
            reject
        }
        key-pressed(event) => { accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 570px; height: 270px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 25px; spacing: 18px;
                Text { text: root.chinese ? "确认音效库操作" : "Confirm library operation"; color: Theme.ink; font-size: 21px; }
                Text { vertical-stretch: 1; text: root.confirmation-text; color: Theme.ink; wrap: word-wrap; }
                HorizontalLayout { height: 34px; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    confirmation-cancel-action := Action { width: 96px; label: root.chinese ? "取消" : "Cancel"; clicked => { root.confirmation-requested(false); } }
                    confirmation-continue-action := Action { width: 110px; primary: true; label: root.chinese ? "确认继续" : "Continue"; clicked => { root.confirmation-requested(true); } }
                }
            }
        }
        }
    }
    if root.library-busy && !((root.ds-syncing || root.ds-applying) && root.library-visible): Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 410px; height: 135px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 9px; border-width: 1px; border-color: Theme.border;
            Text { x: 20px; width: parent.width - 40px; height: parent.height; text: root.scan-browse-busy ? (root.chinese ? "请在文件夹选择窗口中选择音效位置…" : "Choose your sound folder in the folder picker…") : (root.chinese ? "正在处理音效库操作…\n请稍候。" : "Working on the library…\nPlease wait."); color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        }
    }
    if root.startup-busy: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 540px; height: 250px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 9px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 25px; spacing: 16px;
                Text { text: root.startup-closing ? (root.chinese ? "正在安全退出…" : "Closing safely…") : (root.chinese ? "正在打开音效库…" : "Opening your sound library…"); color: Theme.ink; font-size: 21px; }
                HorizontalLayout { spacing: 12px;
                    Text { text: root.startup-stage; color: Theme.ink; horizontal-stretch: 1; }
                    Text { text: root.startup-progress >= 0 ? (root.chinese ? "复制 " : "Copy ") + round(root.startup-progress * 100) + "%" : (root.chinese ? "处理中" : "Working"); color: Theme.dim; }
                }
                Rectangle { height: 6px; background: Theme.raised; border-radius: 3px;
                    Rectangle {
                        height: parent.height;
                        width: root.startup-progress >= 0 ? parent.width * clamp(root.startup-progress, 0, 1) : parent.width * 0.25;
                        x: root.startup-progress >= 0 ? 0px : (parent.width - self.width) * root.startup-motion;
                        background: Theme.accent; border-radius: 3px;
                    }
                }
                Text { text: root.startup-message; color: Theme.dim; wrap: word-wrap; vertical-stretch: 1; }
                Text { text: root.startup-elapsed; color: Theme.muted; font-size: 12px; }
            }
        }
    }
    if root.closing: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 340px; height: 110px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            Text { text: root.chinese ? "正在保存更改…" : "Saving changes…"; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.perf-marker-enabled && !root.closing && !root.startup-busy: Rectangle {
        x: root.perf-marker-x - shortcuts.absolute-position.x;
        y: root.perf-marker-y - shortcuts.absolute-position.y;
        init => {
            root.perf-marker-actual-client-x = self.absolute-position.x;
            root.perf-marker-actual-client-y = self.absolute-position.y;
        }
        changed absolute-position => {
            root.perf-marker-actual-client-x = self.absolute-position.x;
            root.perf-marker-actual-client-y = self.absolute-position.y;
        }
        width: 64 * root.perf-marker-cell-width;
        height: 2 * root.perf-marker-cell-height; background: #000000;
        for bit[index] in root.perf-marker-bits: Rectangle {
            x: Math.mod(index, 64) * root.perf-marker-cell-width;
            y: floor(index / 64) * root.perf-marker-cell-height;
            width: root.perf-marker-cell-width;
            height: root.perf-marker-cell-height;
            background: bit ? #ffffff : #000000;
        }
    }
    }
}

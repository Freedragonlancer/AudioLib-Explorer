    in property <[string]> sm-root-names;
    in property <bool> sm-scan-paused: false;
    in property <bool> sm-root-controls: false;
    in-out property <int> sm-root-selected: -1;
    in-out property <bool> sm-root-form: false;
    in-out property <bool> sm-root-editing: false;
    in-out property <string> sm-root-name: "";
    in-out property <string> sm-root-path: "";
    in property <string> sm-root-message: "";
    in-out property <bool> sm-fs-visible: false;
    in property <bool> sm-fs-busy: false;
    in property <string> sm-fs-path: "";
    in property <string> sm-fs-parent: "";
    in property <string> sm-fs-error: "";
    in property <[RemoteFolderRow]> sm-fs-rows;
    in property <[RemoteBreadcrumbRow]> sm-fs-breadcrumbs;
    in property <bool> sm-fs-can-select: false;
    private property <string> sm-fs-path-draft: "";
    changed sm-fs-path => { root.sm-fs-path-draft = root.sm-fs-path; }
    property <bool> sm-root-ready: root.sm-manageable && root.sm-root-controls && !root.sm-manage-busy && !root.sm-scan-active && !root.library-busy && !root.ds-syncing;
    property <bool> sm-root-has-selection: root.sm-root-selected >= 0 && root.sm-root-selected < root.sm-roots.length;
    // A scan start/control request is in flight.
    in property <bool> sm-manage-busy: false;
    in property <string> sm-manage-message: "";
    in property <bool> sm-manage-error: false;
    in-out property <bool> sm-scan-form: false;
    in-out property <int> sm-scan-root: 0;
    in-out property <string> sm-scan-subpath: "";
    // 0 增量 (incremental), 1 完整 (full).
    in-out property <int> sm-scan-mode: 0;
    // Inline removal confirmation: 0 none, 1 records, 2 folder records, 5 root.
    in-out property <int> sm-confirm: 0;
    property <bool> sm-manageable: root.sm-active && root.remote-mode && root.sm-can-manage && !root.remote-writes-blocked;
    property <string> sm-manage-note: !root.sm-active ? (root.chinese ? "只有当前数据源可以管理；请先切换到此数据源。" : "Only the active source can be managed; switch to this source first.") : (!root.remote-mode ? (root.chinese ? "快照尚未打开：同步完成后才能管理。" : "The snapshot is not open yet: manage after the sync.") : (!root.sm-can-manage ? (root.sm-capabilities != "" ? (root.chinese ? "服务器不允许本机管理，只能查看。" : "The server does not allow management from this PC; view only.") + " " + root.sm-capabilities : (root.chinese ? "尚未取得服务器的管理权限信息（/capabilities），只能查看。" : "No management information from the server (/capabilities) yet; view only.")) : ""));
    // Unsaved-edit prompt: -3 close, -2 none, -1 a new server, >=0 source row.

    property <bool> sm-local-content: (root.sm-selected == 0 && !root.remote-mode) || (root.sm-server && root.sm-active && root.remote-mode && root.sm-page == 2);
    property <string> sm-title: root.sm-new ? (root.chinese ? "新服务器（未保存）" : "New server (unsaved)") : ((root.sm-selected == 0 ? (root.chinese ? "本地素材库" : "Local library") : (root.sm-selected < root.sm-sources.length ? root.sm-sources[root.sm-selected].name : "")) + (root.sm-active ? (root.chinese ? " · 当前数据源" : " · active") : (root.chinese ? " · 未生效" : " · not active")));
    // Connection page (the old data source dialog's fields, per profile).
    in-out property <string> ds-name: "";
    in property <bool> ds-token-saved: false;
    in-out property <bool> ds-token-clear: false;
    in-out property <bool> ds-dirty: false;
    in property <string> ds-last-test: "";
    // 服务器音效库 page, including paths owned by the selected server.
    in property <[ServerRootRow]> sm-roots;
    in property <string> sm-library-status: "";
    in property <bool> sm-library-error: false;
    in property <bool> sm-library-loading: false;

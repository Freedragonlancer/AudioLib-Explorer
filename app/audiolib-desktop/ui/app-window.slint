    in-out property <int> sm-selected: 0;
    // Server pages: 0 连接, 1 服务器音效库, 2 缓存与导出.
    in-out property <int> sm-page: 0;
    in-out property <bool> sm-confirm-delete: false;
    in property <string> sm-local-path: "";
    property <bool> sm-new: root.sm-selected < 0;
    property <bool> sm-server: root.sm-selected != 0;
    property <bool> sm-active: root.sm-selected >= 0 && root.sm-selected < root.sm-sources.length && root.sm-sources[root.sm-selected].active;
    // The local library's management content shows only while local mode is active.

// app/audiolib-desktop/ui/search-task-tabs.slint
import { Theme } from "theme.slint";

component TaskTabIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 26px * Theme.ui-scale; height: 28px * Theme.ui-scale;
    border-radius: 4px * Theme.ui-scale; background: Theme.interactive-fill(false, hit.has-hover, hit.pressed, transparent);
    border-width: icon-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: icon-focus;
    if root.icon.width > 0: Image {
        width: 13px * Theme.ui-scale; height: self.width; source: root.icon;
        colorize: hit.has-hover || icon-focus.has-focus ? Theme.ink : Theme.dim; accessible-role: none;
    }
    opacity: root.enabled ? 1 : 0.45;
    icon-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } reject }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Document-shaped tabs are distinct from the recessed list-header switches.
// Closing a background task never selects it; starring targets the task identified by this tab.
export component SearchTaskTab inherits Rectangle {
    in property <string> name;
    in property <string> keywords;
    in property <string> index-name;
    in property <bool> library-index;
    in property <string> summary;
    in property <bool> searched: false;
    in property <bool> active: false;
    in property <bool> favorite: false;
    in property <bool> modified: false;
    in property <bool> chinese: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    in property <bool> editable: true;
    in property <length> tooltip-width: 560px * Theme.ui-scale;
    private property <string> tooltip-text: (root.summary != "" ? root.summary : root.name) + (root.modified ? (root.chinese ? "\n当前条件尚未更新到收藏" : "\nCurrent conditions have not been saved to the favorite") : "");
    in property <bool> favorite-enabled: true;
    callback favorite-toggled();
    callback selected();
    callback closed();
    callback rename-requested();
    callback context-requested(Point);
    height: (root.compact ? 32px : 36px) * Theme.ui-scale;
    min-width: 170px * Theme.ui-scale;
    preferred-width: 200px * Theme.ui-scale;
    accessible-role: tab;
    accessible-label: (root.chinese ? "搜索任务：" : "Search task: ") + root.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-description: root.summary + (root.modified ? (root.chinese ? "\n当前搜索已修改，尚未更新任务收藏" : "\nThe search differs from its saved favorite") : (root.favorite ? (root.chinese ? "\n已收藏搜索任务" : "\nSaved search task") : ""));
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.selected(); } }
    forward-focus: task-focus;
    background: Theme.modern-style
        ? (root.active ? Theme.tab-surface : (task-hit.has-hover ? Theme.control-surface : Theme.trough))
        : Theme.interactive-fill(root.active, task-hit.has-hover, task-hit.pressed, Theme.trough);
    border-top-left-radius: (Theme.modern-style ? 5px : 7px) * Theme.ui-scale;
    border-top-right-radius: (Theme.modern-style ? 5px : 7px) * Theme.ui-scale;
    border-width: task-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        height: Theme.modern-style ? (root.active ? 3px * Theme.ui-scale : 1px) : 2px * Theme.ui-scale;
        y: parent.height - self.height;
        background: Theme.modern-style ? (root.active ? transparent : Theme.border) : (root.active ? Theme.accent : Theme.border);
        if Theme.modern-style && root.active: Image {
            width: parent.width; height: parent.height; source: Theme.tab-indicator;
            image-fit: fill; accessible-role: none;
        }
    }
    if !root.searched: Text {
        x: 12px * Theme.ui-scale; width: max(0px, parent.width - 78px * Theme.ui-scale); height: parent.height;
        text: root.name; color: Theme.text(1, !root.enabled ? 3 : task-hit.pressed ? 14 : task-hit.has-hover ? 4 : root.active ? 5 : 1, root.active ? Theme.text(1, 0, Theme.ink) : Theme.text(1, 1, Theme.dim)); font-size: Theme.font(12);
        font-weight: root.active ? 600 : 400; vertical-alignment: center; overflow: elide;
    }
    if root.searched: Rectangle {
        x: 12px * Theme.ui-scale; y: 3px * Theme.ui-scale;
        width: max(0px, parent.width - 78px * Theme.ui-scale); height: parent.height - 6px * Theme.ui-scale;
        clip: true;
        // Keep keywords and the active sidebar index together at the left edge.
        // Index context yields to long keywords; the tooltip stays complete.
        keyword-label := Text {
            x: 0px;
            width: directory-label.visible && root.keywords != "" ? min(parent.width, self.preferred-width) : parent.width;
            height: parent.height; visible: root.keywords != "";
            text: root.keywords;
            color: Theme.text(1, !root.enabled ? 3 : task-hit.has-hover ? 4 : root.active ? 5 : 6, Theme.mint); font-size: Theme.font(11);
            horizontal-alignment: left; vertical-alignment: center; overflow: elide;
        }
        directory-separator := Text {
            visible: directory-label.visible && (root.keywords != "" || root.index-name != "");
            x: root.keywords != "" ? keyword-label.width + 6px * Theme.ui-scale : 0px;
            width: self.preferred-width; height: parent.height;
            text: ">"; color: Theme.text(1, 1, Theme.dim); font-size: Theme.font(11);
            horizontal-alignment: left; vertical-alignment: center;
        }
        directory-label := Text {
            visible: root.keywords == "" || parent.width >= keyword-label.preferred-width + directory-separator.preferred-width + min(96px * Theme.ui-scale, self.preferred-width) + 12px * Theme.ui-scale;
            width: root.keywords == "" ? max(0px, parent.width - self.x) : min(96px * Theme.ui-scale, self.preferred-width);
            x: root.keywords != "" ? keyword-label.preferred-width + directory-separator.preferred-width + 12px * Theme.ui-scale
                : (root.index-name != "" ? directory-separator.preferred-width + 6px * Theme.ui-scale : 0px);
            height: parent.height;
            text: root.index-name != "" ? root.index-name : (root.keywords != "" ? (root.chinese ? "全部声音" : "All sounds") : (root.chinese ? "筛选" : "Filters"));
            color: root.library-index ? Theme.text(1, 0, Theme.coral)
                : root.index-name != "" ? Theme.text(1, 8, Theme.apricot)
                : Theme.text(1, 1, Theme.dim);
            font-size: Theme.font(11); horizontal-alignment: left; vertical-alignment: center; overflow: elide;
        }
    }
    if root.modified: Rectangle {
        x: parent.width - 64px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        width: 4px * Theme.ui-scale; height: 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale; background: Theme.accent;
    }
    task-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.selected(); return accept; }
            if root.editable && event.text == Key.F2 { root.rename-requested(); return accept; }
            reject
        }
    }
    task-hit := TouchArea {
        width: max(0px, parent.width - 58px * Theme.ui-scale); enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.selected(); }
        double-clicked => { if root.editable { root.rename-requested(); } }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-requested({x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y});
            }
        }
    }
    Tooltip {
        Rectangle {
            width: root.tooltip-width;
            background: Theme.tooltip; border-radius: 5px * Theme.ui-scale;
            border-width: 1px; border-color: Theme.strong-border;
            VerticalLayout { padding: 10px * Theme.ui-scale;
                Text {
                    text: root.tooltip-text; color: Theme.text(1, 0, Theme.ink); font-size: Theme.font(11); wrap: word-wrap;
                    accessible-role: text; accessible-label: root.tooltip-text;
                }
            }
        }
    }
    task-favorite := TaskTabIcon {
        x: parent.width - 57px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        enabled: root.enabled && root.favorite-enabled;
        accessible-checkable: true; accessible-checked: root.favorite;
        Image { width: 15px * Theme.ui-scale; height: 15px * Theme.ui-scale;
            source: Theme.modern-style
                ? (root.favorite ? @image-url("icons/task-star-filled.svg") : @image-url("icons/task-star.svg"))
                : (root.favorite ? @image-url("icons/bookmark-filled.svg") : @image-url("icons/bookmark.svg"));
            colorize: root.favorite ? Theme.text(1, 6, Theme.accent) : Theme.text(1, 1, Theme.dim);
            image-fit: contain; accessible-role: none;
        }
        label: (root.favorite ? (root.chinese ? "取消搜索任务收藏：" : "Unfavorite search task: ") : (root.chinese ? "收藏搜索任务：" : "Favorite search task: ")) + root.name + (root.modified ? (root.chinese ? "（条件已修改，右键收藏可更新）" : " (changed; update from saved search menu)") : "");
        Tooltip { text: @markdown("\{task-favorite.label}"); }
        clicked => { root.favorite-toggled(); }
    }
    TaskTabIcon {
        x: parent.width - 30px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        icon: @image-url("icons/close.svg"); enabled: root.enabled && root.editable;
        label: (root.chinese ? "关闭搜索任务：" : "Close search task: ") + root.name;
        clicked => { root.closed(); }
    }
}
